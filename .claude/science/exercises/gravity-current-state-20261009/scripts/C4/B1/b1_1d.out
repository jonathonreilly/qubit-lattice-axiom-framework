=== (f) where the 1D deformation sits ===
local P = sin k : i[K,H] = -P (undeformed {H[1],H[x]});  i[P,K] = H*cos k  -> deformation cos k in {D,H}
SLAC P = k      : i[P,K] = H (undeformed {D,H});  i[K,H] = -beta(k)*P with beta = sin k/k :
   k=0.100  beta=+0.9983
   k=1.000  beta=+0.8415
   k=2.000  beta=+0.4546
   k=3.000  beta=+0.0470
   k=3.142  beta=+0.0000
