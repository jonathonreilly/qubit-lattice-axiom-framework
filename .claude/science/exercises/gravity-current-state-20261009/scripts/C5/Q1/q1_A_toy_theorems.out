 phases set 0: ||rho_L - mixture|| = 5.55e-17 ; after substrate-only unitary ||rho_L' - rho_L|| = 1.11e-16 ; purity Tr rho^2 = 0.3550
 phases set 1: ||rho_L - mixture|| = 5.55e-17 ; after substrate-only unitary ||rho_L' - rho_L|| = 2.22e-16 ; purity Tr rho^2 = 0.3550
 phases set 2: ||rho_L - mixture|| = 5.55e-17 ; after substrate-only unitary ||rho_L' - rho_L|| = 5.55e-17 ; purity Tr rho^2 = 0.3550

=== (A2) final-state projection onto |Sigma>: mean-propagated state; success prob = 1 - variance ===
 ||post - E U chi0|| = 1.05e-16 ; success prob ||post||^2 = 0.288187 ; 1 - E||U chi - mean||^2 = 0.288187

