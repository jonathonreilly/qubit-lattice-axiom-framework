    gamma = 1e-02 H0: L_g at ell = 1e-6 m = 79.3
    gamma = 1e+00 H0: L_g at ell = 1e-6 m = 74.7
    gamma = 3e+00 H0: L_g at ell = 1e-6 m = 73.6

