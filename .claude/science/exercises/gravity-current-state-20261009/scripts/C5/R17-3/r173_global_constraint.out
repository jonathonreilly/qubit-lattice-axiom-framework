   T=2e+00: C - V_late = 2.500e-03 (Delta V (t_tr/T)^3 = 2.500e-03) ; g = C'/3 = -3.750e-03 ; g/H^2 = -3.375e-02
   T=1e+01: C - V_late = 2.000e-05 (Delta V (t_tr/T)^3 = 2.000e-05) ; g = C'/3 = -3.000e-05 ; g/H^2 = -6.750e-03
   T=1e+02: C - V_late = 2.000e-08 (Delta V (t_tr/T)^3 = 2.000e-08) ; g = C'/3 = -3.000e-08 ; g/H^2 = -6.750e-04
   T=1e+04: C - V_late = 2.000e-14 (Delta V (t_tr/T)^3 = 2.000e-14) ; g = C'/3 = -3.000e-14 ; g/H^2 = -6.750e-06
