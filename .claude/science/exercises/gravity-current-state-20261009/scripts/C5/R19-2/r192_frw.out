[C1] lift B on FRW, V^mu = (V(t),0,0,0):
     K^00 = -2*Derivative(V(t), t)  ;  K^i_j = K^{ij} g_{jj} = 2*V(t)*Derivative(A(t), t)/A(t)  ; off-diagonal zero: True
     => rho_K = -2 V',  p_K = 2 H V  (p_K = 0 only if H = 0: on Minkowski it reduces to R18-7's k = 0 content)
     nabla_mu K^{mu 0} = -2*Derivative(V(t), (t, 2)) - 6*Derivative(A(t), t)*Derivative(V(t), t)/A(t) + 6*V(t)*Derivative(A(t), t)**2/A(t)**2   [should equal rho_K' + 3H(rho_K + p_K) = -2V'' - 6 H V' + 6 H^2 V]
     check: True

