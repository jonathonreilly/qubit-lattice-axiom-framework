== C7: Snyder realisation, free worldline velocity (sympy) ==
dx^mu/dtau = [2*p0*(a**2*p0**2 - a**2*p1**2 - a**2*p2**2 - a**2*p3**2 - 1), -2*p1*(a**2*p0**2 - a**2*p1**2 - a**2*p2**2 - a**2*p3**2 - 1), -2*p2*(a**2*p0**2 - a**2*p1**2 - a**2*p2**2 - a**2*p3**2 - 1), -2*p3*(a**2*p0**2 - a**2*p1**2 - a**2*p2**2 - a**2*p3**2 - 1)]
dx^i/dx^0 = [-p1/p0, -p2/p0, -p3/p0]  (undeformed: p^i/p^0)
