+def atomic_transition(records, fixed_source_density):
+    """Decode R on the declared apparatus domain; source density is fixed law data.
+
+    This is not a validator or law on arbitrary record mosaics. The two
+    one-outcome prefixes are expressly outside the atomic domain.
+    """
+    targets = sorted(targets_from_records(records))
+    assert len(targets)==2, 'declared pair domain'
+    present = [s in records for s in targets]
+    if any(present) and not all(present):
+        raise ValueError('one-outcome prefix outside atomic domain')
+    decoded = []
+    for s in targets:
+        values = [records[site_add(s,d)] for d in NEIGHBORS if site_add(s,d) in records]
+        programs = [v for v in values if setting(v)]
+        assert T in values and len(programs)==1
+        nmat = add(programs[0],scale(I,-2))
+        assert adj(nmat)==nmat
+        n = tuple(tr(mul(nmat,sigma))/2 for sigma in PAULI)
+        assert direction(n)==nmat and dot(n,n)==1
+        decoded.append(n)
+    weights = joint(fixed_source_density,*decoded)
+    if all(present):
+        outcomes = tuple(1 if records[s]==I else -1 for s in targets)
+        assert all(records[s]==scale(I,a) for s,a in zip(targets,outcomes))
+        assert weights[outcomes]!=0, 'positive terminal branch domain'
+        return [(dict(records),Q(1))]
+    branches = []
+    for outcomes,weight in weights.items():
+        if weight==0:
+            continue
+        post = dict(records)
+        for s,a in zip(targets,outcomes):
+            post[s] = scale(I,a)
+        branches.append((post,weight))
+    return branches
+
+
+def state_key(records):
+    return tuple(sorted(records.items()))
 
 
