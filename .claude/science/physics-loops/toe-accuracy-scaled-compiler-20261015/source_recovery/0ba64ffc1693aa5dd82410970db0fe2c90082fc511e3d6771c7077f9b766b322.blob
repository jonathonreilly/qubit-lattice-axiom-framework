"""Verify source identity, recovery, immutable seals and actual receipts only."""
from pathlib import Path
from datetime import datetime, timezone
import ast
import hashlib
import json

D = Path(__file__).resolve().parent
N = D.parent


def read(path):
    return json.loads(path.read_text())


def pin(path):
    data = path.read_bytes()
    return {'path': str(path), 'bytes': len(data), 'sha256': hashlib.sha256(data).hexdigest()}


def same(path, row):
    got = pin(path)
    assert got['bytes'] == row['bytes'] and got['sha256'] == row['sha256'], (str(path), got)


x = read(D / 'SOURCE_MANIFEST.json')
assert x['scientific_programs_run'] == 0 and x['new_candidate_exposed'] is True
assert x['parent_source_accepted'] is True and x['new_candidate_root_accepted_in_this_record'] is False
for row in x['sources']:
    same(Path(row['path']), row)
    same(D / row['recovery'], row)
assert x['source_blobs'] == len({r['sha256'] for r in x['sources']})

seals = []
for folder, filename, key, expected in [
    ('accuracy_scaled_compiler_root_candidate', 'PROPOSAL_FREEZE.json', 'files', 2),
    ('conditioned_positive_compiler_independent', 'FINAL_FREEZE.json', 'members', 27),
    ('conditioned_positive_compiler_comparison', 'FINAL_FREEZE.json', 'members', 40),
    ('conditioned_positive_compiler_root_review', 'FINAL_FREEZE.json', 'files', 2),
]:
    root = N / folder
    f = read(root / filename)
    assert len(f[key]) == expected and f['scientific_programs_run'] == 0
    for row in f[key]:
        path = Path(row['path'])
        same(path if path.is_absolute() else root / path, row)
    seals.append({'freeze': pin(root / filename), 'members_verified': expected})

source_pins = read(N / 'accuracy_scaled_compiler_root_candidate/SOURCE_PINS.json')
assert len(source_pins['sources']) == 6 and source_pins['scientific_programs_run'] == 0
for row in source_pins['sources']:
    same(Path(row['path']), row)

receipt_path = N / 'runs/conditioned_source_acceptance_2104/EXECUTION.json'
r = read(receipt_path)
assert r['exit_code'] == 0
assert r['argv'] == ['python3', str(N / 'bootstrap/review_conditioned_sources_2104.py')]
for key in ['child_source_at_launch', 'recorder', 'stdout', 'stderr']:
    same(Path(r[key]['path']), r[key])
same(receipt_path.parent / 'executed_source.py', r['child_source_at_launch'])
assert Path(r['stderr']['path']).read_bytes() == b''
stdout = read(Path(r['stdout']['path']))
decision = N / 'conditioned_positive_compiler_root_review'
for key, name in [('acceptance', 'ACCEPTANCE.md'), ('review', 'REVIEW.json'), ('freeze', 'FINAL_FREEZE.json')]:
    same(decision / name, stdout[key])
assert read(decision / 'REVIEW.json')['scientific_programs_run'] == 0
assert read(decision / 'REVIEW.json')['publication_wrapper_accepted'] is False
assert 'not imported or accepted by this decision' in (decision / 'ACCEPTANCE.md').read_text()

c = read(D / 'metadata_runs/capture/EXECUTION.json')
assert c['exit_code'] == 0 and not c['timed_out'] and c['timeout_seconds'] == 60
assert c['scientific_programs_run'] == 0
for key in ['child_source_at_launch', 'source_capture', 'recorder', 'stdout', 'stderr']:
    same(Path(c[key]['path']), c[key])
for name in ['capture_sources.py', 'verify_metadata.py', 'record_metadata.py', 'seal.py']:
    ast.parse((D / name).read_text(), filename=name)
for name in ['REPORT.md', 'EXPOSURE.md', 'ACCESS_FAILURES.md']:
    data = (D / name).read_bytes()
    assert data.endswith(b'\n') and not data.endswith(b'\n\n')
    data.decode('utf-8')

out = {
    'verified_utc': datetime.now(timezone.utc).isoformat(),
    'report': pin(D / 'REPORT.md'),
    'source_rows': len(x['sources']),
    'source_blobs': x['source_blobs'],
    'source_seals_verified': seals,
    'candidate_source_pins_verified': 6,
    'actual_parent_receipt_linkage_verified': True,
    'metadata_helpers_parse': True,
    'scientific_programs_run': 0,
    'limits': 'Identity, selected recovery, schema, syntax and actual receipt linkage only. No coefficient/target/recurrence search, numerical fixture or scientific theorem execution.',
}
(D / 'VERIFICATION.json').write_text(json.dumps(out, indent=2, sort_keys=True) + '\n')
print(json.dumps(out, sort_keys=True))
