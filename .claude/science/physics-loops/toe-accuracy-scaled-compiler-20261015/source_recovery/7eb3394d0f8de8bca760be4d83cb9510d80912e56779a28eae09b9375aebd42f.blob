"""Capture selected exact sources and actual metadata receipt members; no science."""
from pathlib import Path
from datetime import datetime, timezone
import hashlib
import json

D = Path(__file__).resolve().parent
N = D.parent
W = N.parent / 'correlation_worktree'


def pin(path):
    data = path.read_bytes()
    return {'path': str(path), 'bytes': len(data), 'sha256': hashlib.sha256(data).hexdigest()}


specs = [
    (N / 'accuracy_scaled_compiler_root_candidate/DERIVATION.md', 12683, '6cae05fe6569b630041095b2cd44ad53a2cfedebdd0de30cd411975729f0186b', 'New candidate; complete source-exposed read, first batch observed20:59:15UTC; all six sections assessed.'),
    (N / 'accuracy_scaled_compiler_root_candidate/PROPOSAL_FREEZE.json', 744, '13e6827d1a6220280fdd75037fa0a3ba6a85b5d5a18ee7e70123692b41e0908c', 'Exact two-member source proposal seal; historical status retained.'),
    (N / 'accuracy_scaled_compiler_root_candidate/SOURCE_PINS.json', 1848, '8a19e5805e0095a270f7f954be186f5ffbc071edcce1861f9675cb5e63caafa0', 'Complete read of six source identities and historical pending status.'),
    (N / 'accuracy_scaled_compiler_root_readout/READOUT.md', 1855, '899a28b936f5d8213ca2fbf28da6dc0bf0bc59534a64b97d8f2116db53ff9dc5', 'Complete read and separate exposed analytic check of root k0 refinement.'),
    (N / 'conditioned_positive_compiler_independent/DERIVATION.md', 30870, 'dd6cca8552a117d97f7be21c7b999ecd2276382f6cc762954bd97d00e3a6ff04', 'Direct quantitative premise; prior complete authored/read coverage reused; affected sections1-2,4-8 reread in full.'),
    (N / 'conditioned_positive_compiler_independent/FINAL_FREEZE.json', 4866, '586523f983bef60f52cd76d235074f98ea05a4a114475d349b59b36953edb47b', 'Exact protected27-member seal; members checked at original paths, not recursively copied.'),
    (N / 'conditioned_positive_compiler_comparison/REPORT.md', 26979, '227180a0822eab4e3dbfc002b6604d914af23589c29add9cca71e1a2f3ae2db0', 'Own complete prior exposed parent assessment; exact qualification/chronology and target contracts reused.'),
    (N / 'conditioned_positive_compiler_comparison/FINAL_FREEZE.json', 7548, 'db7b2b696bbbb59e09f9b5c9bf41df61f0f95f66cbe31bc357ed363929bc64e0', 'Exact40-member comparison seal; selected recovery only.'),
    (N / 'conditioned_positive_compiler_root_candidate/DERIVATION.md', 18196, '2de387eb501aa8ead91afa1f5a26f7d3a0bbf11e51285d99786715152ad5b6d6', 'Earlier alternative fixed-certificate proof; complete prior read reused, not the source of the new exponent substitution.'),
    (N / 'conditioned_positive_compiler_root_readout/READOUT.md', 1598, 'd30ed09efe424a00942f79df8c4d94ab4f5a2e82dcf6f4a79a25365628a03048', 'Earlier mandatory chronology qualifications; unchanged complete prior read.'),
    (N / 'conditioned_positive_compiler_protected_root_read/READ.json', 3014, '2099790774c866ba2debf24b13a6b9a81e2b8c017ab72e60bc29346c9a56ec8e', 'Historical protected-read record referenced in new source pins; exact previous read reused.'),
    (N / 'conditioned_positive_compiler_root_review/ACCEPTANCE.md', 2939, '9f90d834ef33e01300eed265e196df1f8d66ec92f846bfa96d30716d7d25790d', 'Complete current decision read; accepts only fixed-certificate sources and excludes accuracy-scaled proposal.'),
    (N / 'conditioned_positive_compiler_root_review/REVIEW.json', 4651, 'ac640003d9322cb9d890b574ad7a7456ec30e4bf2c6a569f9c7eaf9f2a9afa44', 'Complete actual root review metadata read; no new science or new-proposal acceptance.'),
    (N / 'conditioned_positive_compiler_root_review/FINAL_FREEZE.json', 653, 'e6e1c8e0884b669aff569787685c5b12b1186ae2114428ac04015bb4a89442b8', 'Current two-member root decision seal; complete read.'),
    (N / 'single_port_program_research/DERIVATION.md', 33757, 'bda0be884fa79905ff81f0a2642def9e2efd5302796262f5f9eb4033b2c436c0', 'Original qualitative compiler geometry/background premise; prior complete read reused.'),
    (N / 'single_port_program_decisive_check/REPORT.md', 27426, '3ad0ab6540ba9fae892824119aafa6c4e61ca16892ba3d23a7c59f95df82e7b5', 'Original complete review reused, including double commutator, work and block-positivity qualifications.'),
    (W / 'AGENTS.md', 1265, 'f9a7b41213cee9ff0b7e9a28f79b555c152de52ef012ff3bcdd09b996d3aa32f', 'Already read applicable instructions; exact revision reused.'),
    (W / 'docs/ai_methodology/SCIENCE_WORKFLOW.md', 15435, '05f3ec8e58ccd7a4d2a87643fb7ed4f12998c6a1d5721e3632a502de8a0ad6ce', 'Already read workflow; exact revision reused, no audit action.'),
    (Path('/Users/jonreilly/.codex/skills/physics-claim-reviewer/SKILL.md'), 14490, '9d841edd05b9dc4c5145abcfd5352cd45460a1cc57c23c1eabd131590dbb1455', 'Already read skill, exact revision reused; source-exposed claim discipline, no audit status.'),
    (N / 'conditioned_positive_compiler_comparison/record_metadata.py', 2123, 'c707dc710885a6c2b988454a98667abc9a0e0c364fe2dbcf6832489cff464e4a', 'Current recorder is an exact byte-for-byte reuse; complete current read.'),
]

receipt_path = N / 'runs/conditioned_source_acceptance_2104/EXECUTION.json'
receipt_pin = pin(receipt_path)
receipt = json.loads(receipt_path.read_text())
assert receipt['exit_code'] == 0
assert receipt['argv'] == ['python3', str(N / 'bootstrap/review_conditioned_sources_2104.py')]
specs.append((receipt_path, receipt_pin['bytes'], receipt_pin['sha256'], 'Actual parent acceptance metadata launch21:00:28UTC; complete read, no invented launch file.'))
for key in ['child_source_at_launch', 'recorder', 'stdout', 'stderr']:
    row = receipt[key]
    specs.append((Path(row['path']), row['bytes'], row['sha256'], 'Actual receipt member: ' + key + '; full source/recorder/stdout read, empty stderr checked.'))
child = receipt['child_source_at_launch']
specs.append((receipt_path.parent / 'executed_source.py', child['bytes'], child['sha256'], 'Actual on-disk source capture, inventoried at its exact run directory and checked byte-identical.'))

blobs = D / 'sources'
blobs.mkdir(exist_ok=True)
rows = []
for path, size, sha, coverage in specs:
    row = pin(path)
    assert row['bytes'] == size and row['sha256'] == sha, (str(path), row)
    dest = blobs / sha
    if not dest.exists():
        dest.write_bytes(path.read_bytes())
    row.update({'coverage_and_role': coverage, 'recovery': str(dest.relative_to(D))})
    rows.append(row)
assert (D / 'record_metadata.py').read_bytes() == (N / 'conditioned_positive_compiler_comparison/record_metadata.py').read_bytes()
out = {
    'captured_utc': datetime.now(timezone.utc).isoformat(),
    'scope': 'Source-exposed analytic check; selected exact source/receipt recovery only.',
    'sources': rows,
    'source_blobs': len(list(blobs.iterdir())),
    'scientific_programs_run': 0,
    'new_candidate_exposed': True,
    'parent_source_accepted': True,
    'new_candidate_root_accepted_in_this_record': False,
    'recovery_limits': 'One blob per selected SHA. Older seals are checked at their original paths; unselected old members are not recursively copied.',
}
(D / 'SOURCE_MANIFEST.json').write_text(json.dumps(out, indent=2, sort_keys=True) + '\n')
print(json.dumps({'source_rows': len(rows), 'source_blobs': out['source_blobs'], 'scientific_programs_run': 0}, sort_keys=True))
