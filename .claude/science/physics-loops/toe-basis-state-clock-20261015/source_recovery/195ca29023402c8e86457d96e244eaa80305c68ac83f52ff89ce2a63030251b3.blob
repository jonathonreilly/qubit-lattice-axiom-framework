"""Capture only explicitly selected prior context; never inventory sibling research."""
from pathlib import Path
import datetime
import hashlib
import json

D = Path(__file__).resolve().parent
N = D.parent
W = N.parent / 'correlation_worktree'
OLD = N.parent / 'renewal_20261013_213733'
SK = Path('/Users/jonreilly/.codex/skills')

sources = [
    (W/'AGENTS.md', 'f9a7b41213cee9ff0b7e9a28f79b555c152de52ef012ff3bcdd09b996d3aa32f', 'Current instructions, fully read in this task'),
    (W/'docs/ai_methodology/SCIENCE_WORKFLOW.md', '05f3ec8e58ccd7a4d2a87643fb7ed4f12998c6a1d5721e3632a502de8a0ad6ce', 'Current workflow, fully read in this task'),
    (SK/'ai-physics-lane-builder/SKILL.md', 'ca2f2325ba990d868adef13bf2cea72d96b1a4b99bd07e84c32fa057a2c922f9', 'Current supporting skill, fully read in this task'),
    (W/'docs/ai_methodology/skills/SKILL_FRESHNESS_CHECK.md', 'b2593401141d5f88f65feb428b8a4b2072455e038ace1cf313ecbb5a667e64b0', 'Previously fully read unchanged procedural reference'),
    (W/'docs/WRITING_VOICE_GUIDE_2026-04-25.md', '3d123055d2dc54a288bea3fcf1d694fa8a56e0f969f4c48246e90f650440ed4b', 'Previously fully read unchanged procedural reference'),
    (W/'docs/POSITIVE_UNARY_CYCLE_CLOCK_BOUNDED_THEOREM_NOTE_2026-10-14.md', 'fa7028e0e9ad6c2c7d4c1c399feae8f9581f301dda5b46f8800eb6c355137542', 'Previously read canonical unary-clock context; not an imported theorem for this proof'),
    (OLD/'joint_unary_cycle_clock/DERIVATION.md', 'c7a19c3acb7d731a95b97bfadc8a32e2624196d60555ac08e8e77b3ad71d1135', 'Previously fully read unchanged unary-clock proof; context only'),
    (OLD/'joint_unary_cycle_clock_review/REPORT.md', '8d76345b8a28d7d9a80675dda5ee8b1d3f9964994375bae852f02ea084a9a7b3', 'Previously fully read unchanged unary-clock review; context only'),
    (N/'single_port_program_research/DERIVATION.md', 'bda0be884fa79905ff81f0a2642def9e2efd5302796262f5f9eb4033b2c436c0', 'Previously fully read compiler source; source-exposure context only'),
    (N/'single_port_program_decisive_check/REPORT.md', '3ad0ab6540ba9fae892824119aafa6c4e61ca16892ba3d23a7c59f95df82e7b5', 'Previously fully read compiler review; context only'),
    (N/'single_port_program_root_review/ACCEPTANCE.md', 'bbe2e9c911e3323f840855fb2e77cc5e86d1669486eb8c8dda2e8cdec3ff53eb', 'Previously fully read qualified compiler decision; context only'),
    (N/'single_port_autonomous_root_candidate/DERIVATION.md', '0e91f9369e387608f8fb3720c290e67f6aa98b10f13428866334c8507b9e989d', 'Previously fully read autonomous-controller source; not the new root clock candidate'),
    (N/'single_port_autonomous_decisive_check/REPORT.md', '52eb2e2dcd9fc56a7be490e193b57754bd85bfad5d585244d4a9fce947b4465d', 'Our previous source-exposed controller review, unchanged'),
    (N/'single_port_autonomous_root_review/ACCEPTANCE.md', '134cbee6390a6f999813dd0234fe869bdd0bec2dddbd5d47a2209091c0dcbe5f', 'Previously fully read qualified autonomous decision; context only'),
]

def sha(data):
    return hashlib.sha256(data).hexdigest()

archive = D/'source_recovery'
archive.mkdir(exist_ok=False)
records = []
for path, expected, coverage in sources:
    data = path.read_bytes()
    assert sha(data) == expected, str(path)
    target = archive/(expected+'.blob')
    if not target.exists():
        target.write_bytes(data)
    records.append({'original_path': str(path), 'bytes': len(data),
                    'sha256': expected, 'recovery': str(target.relative_to(D)),
                    'coverage': coverage, 'role': 'instruction or prior exposure; not mathematical proof import'})
web = D/'WEB_PRIOR_ART_RESPONSE.json'
data = web.read_bytes()
records.append({'original_path': str(web), 'bytes': len(data), 'sha256': sha(data),
                'recovery': web.name, 'coverage': 'Actual public abstract tool response read after route selection',
                'role': 'limited prior-art provenance; no unread paper theorem imported'})
manifest = {'captured_utc': datetime.datetime.now(datetime.timezone.utc).isoformat(),
            'scope': 'Explicit source identities only; no sibling directory inventory',
            'root_candidate_accessed': False, 'direct_theorem_imports': [],
            'scientific_programs_run': 0, 'sources': records}
(D/'SOURCE_MANIFEST.json').write_text(json.dumps(manifest, indent=2)+'\n')
print(json.dumps({'sources': len(records), 'recovery_blobs': len(list(archive.iterdir())),
                  'scope': manifest['scope'], 'scientific_programs_run': 0}))
