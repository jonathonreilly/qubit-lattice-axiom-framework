ce/physics-loops/toe-campaign-20261015/independent_check_B5/q1_uni_m0.out","additions":253,"deletions":0},{"path":".claude/science/physics-loops/toe-campaign-20261015/independent_check_B5/q1_uni_m0.sing","additions":116,"deletions":0},{"path":".claude/science/physics-loops/toe-campaign-20261015/independent_check_B5/q1_uni_m3.out","additions":253,"deletions":0},{"path":".claude/science/physics-loops/toe-campaign-20261015/independent_check_B5/q1_uni_m3.sing","additions":116,"deletions":0},{"path":".claude/science/physics-loops/toe-campaign-20261015/independent_check_B5/q2_G.py","additions":22,"deletions":0},{"path":".claude/science/physics-loops/toe-campaign-20261015/independent_check_B5/q2_max.py","additions":14,"deletions":0},{"path":".claude/science/physics-loops/toe-campaign-20261015/independent_check_B5/q2_numcheck.py","additions":48,"deletions":0},{"path":".claude/science/physics-loops/toe-campaign-20261015/independent_check_B5/q2_opt.py","additions":18,"deletions":0},{"path":".claude/science/physics-loops/toe-campaign-20261015/independent_check_B5/q2_plane.py","additions":25,"deletions":0},{"path":".claude/science/physics-loops/toe-campaign-20261015/independent_check_B5/q2_psd.py","additions":12,"deletions":0},{"path":".claude/science/physics-loops/toe-campaign-20261015/independent_check_B5/q2_series.py","additions":32,"deletions":0},{"path":".claude/science/physics-loops/toe-campaign-20261015/independent_check_B6/README.md","additions":28,"deletions":0},{"path":".claude/science/physics-loops/toe-campaign-20261015/independent_check_B6/common.py","additions":32,"deletions":0},{"path":".claude/science/physics-loops/toe-campaign-20261015/independent_check_B6/cplx_num.py","additions":36,"deletions":0},{"path":".claude/science/physics-loops/toe-campaign-20261015/independent_check_B6/exact_setup.py","additions":75,"deletions":0},{"path":".claude/science/physics-loops/toe-campaign-20261015/independent_check_B6/fastnum.py","additions":58,"deletions":0},{"path":".claude/science/physics-loops/toe-campaign-20261015/independent_check_B6/lines.py","additions":37,"deletions":0},{"path":".claude/science/physics-loops/toe-campaign-20261015/independent_check_B6/numsearch.py","additions":62,"deletions":0},{"path":".claude/science/physics-loops/toe-campaign-20261015/independent_check_B6/plane_build.py","additions":9,"deletions":0},{"path":".claude/science/physics-loops/toe-campaign-20261015/independent_check_B6/plane_cases.py","additions":38,"deletions":0},{"path":".claude/science/physics-loops/toe-campaign-20261015/independent_check_B6/plane_cases.sing","additions":261,"deletions":0},{"path":".claude/science/physics-loops/toe-campaign-20261015/independent_check_B6/plane_cases_verify.sing","additions":262,"deletions":0},{"path":".claude/science/physics-loops/toe-campaign-20261015/independent_check_B6/polysys.py","additions":78,"deletions":0}],"headRefOid":"0bf8f553c8fab89caa9a792cf402e5fb475ef626","title":"campaign: covariant one-tick kinematics (freeze, Dirac unfreezing) and order-blind 1-dependence"}
