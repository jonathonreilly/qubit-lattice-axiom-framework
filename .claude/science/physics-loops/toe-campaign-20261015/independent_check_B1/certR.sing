// certificate: slimgb of the real-form ideal J; then radical tests per real variable
option(redSB);
int tt=timer; ideal S=slimgb(J); "slimgb secs: "+string(timer-tt);
"GB size: "+string(size(S))+"   Krull dim: "+string(dim(S));
int j; int k; poly v; int f;
for(j=1;j<=nvars(r)-2;j++){
  v=var(j); f=0;
  for(k=1;k<=10;k++){ if(reduce(v^k,S)==0){ string(v)+"^"+string(k)+" in J"; f=1; break;} }
  if(f==0){ v=var(j)^2+var(j+1-2*((j+1) mod 2)+0)^2; }
  if(f==0){ string(var(j))+": no power<=10 in J"; }
}
poly u=var(nvars(r)-1)^2+var(nvars(r))^2-1;
for(k=1;k<=8;k++){ if(reduce(u^k,S)==0){ "(x0^2+y0^2-1)^"+string(k)+" in J"; break;} }
