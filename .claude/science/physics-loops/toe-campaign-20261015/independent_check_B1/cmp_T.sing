LIB "modstd.lib";
option(redSB);
ideal S1=slimgb(J);
ideal S2=modStd(J);
"slimgb vs modStd reduced GB sizes: "+string(size(S1))+" "+string(size(S2));
int ok=1; int i;
for(i=1;i<=size(S1);i++){ if(reduce(S1[i],S2)!=0){ok=0;} }
for(i=1;i<=size(S2);i++){ if(reduce(S2[i],S1)!=0){ok=0;} }
"identical ideals: "+string(ok);
for(i=1;i<=size(J);i++){ if(reduce(J[i],S1)!=0){ok=0;} }
"J reduces to 0 mod slimgb: "+string(ok);
quit;
