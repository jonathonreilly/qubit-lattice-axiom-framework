LIB "primdec.lib";
option(redSB);
ideal S=slimgb(J);
// all parameters other than z0,z1,z2 are in rad(J); so rad(J)=rad(J+(them))
ideal K=S;
int j; for(j=5;j<=28;j++){ K=K+var(j); }
K=std(K);
"reduced system:"; K;
list L=minAssGTZ(K);
"number of minimal primes: "+string(size(L));
for(j=1;j<=size(L);j++){ "--- prime "+string(j)+":"; std(L[j]); }
quit;
