ring r=0,(p0,p1,p2,p3,p4,p5,p6,p7,p8,p9,p10,p11,p12),dp;
option(redSB);
ideal I=4*p0^2 + 8*p1^2 + 4*p10^2 + 4*p11^2 + p12^2 + 8*p2^2 + 8*p3^2 + 8*p4^2 + 8*p5^2 + 4*p6^2 + 4*p7^2 + 4*p8^2 + 8*p9^2 - 1,
2*p0^2 + 2*p2^2 - 2*p3^2 - 2*p4^2 + 2*p5^2 + p6^2 - p7^2,
p0^2 - 2*p1^2,
p0*p10 + p1*p11 + p10*p6 + p10*p8 - p11*p9 + p12*p2 + p2*p6 + p2*p8 + p4*p9 + p5*p7 - p5*p9,
p0*p10 - p1*p11 + p2*p6 + p2*p8 - p4*p9 - p5*p7 - p5*p9,
2*p0*p12 + 4*p10*p2 - 4*p11*p5 + 2*p6^2 + p8^2 - 2*p9^2,
2*p0*p2 + 2*p1*p4 + 2*p1*p5 + p10*p12 + p10*p6 + 2*p10*p8 + p11*p7 + 2*p11*p9 + 2*p2*p6 + 2*p2*p8 + 2*p4*p7 + 2*p4*p9 + 2*p5*p9,
2*p0*p2 + 2*p1*p4 - 2*p1*p5 + p10*p6 - p11*p7 + 2*p2*p8 - 2*p4*p9 + 2*p5*p9,
p0*p2 - p1*p4 + p1*p5 + p2*p6 - p4*p7,
p0*p2 - p1*p4 - p1*p5,
4*p0*p6 + 4*p1*p7 + p10^2 + 4*p10*p2 - p11^2 + 4*p11*p5 + 2*p12*p6 + 2*p2^2 - 2*p3^2 + 2*p4^2 - 2*p5^2 + 2*p8^2,
2*p0*p6 - 2*p1*p7 + p2^2 + p3^2 - p4^2 - p5^2,
p0*p8 + 2*p1*p9 + p10^2 + 2*p10*p2 + 2*p11*p4 + p12*p8 + p2^2 - p3^2 + 2*p4*p5 + 2*p6*p8 + 2*p7*p9,
p0*p8 + p10*p2 - p11*p4 + p2^2 + p3^2 + p6*p8 - p7*p9,
p0*p8 - 2*p1*p9 + p2^2 - p3^2 - 2*p4*p5;
int t=timer; ideal G=std(I); "time",timer-t; "dim",dim(G); "vdim",vdim(G); "size",size(G);
LIB "primdec.lib";
list L=minAssGTZ(I); "ncomponents",size(L);
for(int i=1;i<=size(L);i++){"--- component",i, "dim", dim(std(L[i])); L[i];}
quit;
