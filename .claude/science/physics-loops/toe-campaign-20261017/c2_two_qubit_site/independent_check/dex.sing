LIB "elim.lib";
ring S=2,(x,y,z),dp; option(redSB);
ideal IC = x*z+x*y^2*z+x*y+x*y*z^2, y*z+x^2*y*z+x*z+x*y^2*z;
ideal I = IC, y*z+x^2*y*z+x*z+x*y^2*z+x*y+x*y*z^2;
ideal J = std(sat(I,x*y*z));
"J="; J;
ideal J0 = std(ideal((x+1)^2,(y+1)^2,(z+1)^2));
"J==J0:"; size(reduce(J,J0))==0 && size(reduce(J0,J))==0;
"vdim R/J:"; vdim(J);
"even moves in J:"; reduce(x2+1,J); reduce(y2+1,J); reduce(z2+1,J); reduce(x*y+1,J);
ideal ICs = std(sat(IC,x*y*z));
ideal Q = std(sat(quotient(ICs, x2+1),x*y*z));
"Q(2,0,0) subset J:"; size(reduce(Q,J))==0;
"Q==ICs:"; size(reduce(Q,ICs))==0;
ideal Q2 = std(sat(quotient(ICs, x+y),x*y*z));   // t=(1,-1,0)
"Q(1,-1,0) subset J:"; size(reduce(Q2,J))==0;
// independent triple test: (1,-1,0),(0,1,-1),(1,1,0)
ideal Q3 = std(sat(quotient(ICs, y+z),x*y*z));
ideal Q4 = std(sat(quotient(ICs, x*y+1),x*y*z));
ideal Qtr = std(intersect(Q2,Q3,Q4));
"triple intersection subset ICs:"; size(reduce(Qtr,ICs))==0;
quit;
