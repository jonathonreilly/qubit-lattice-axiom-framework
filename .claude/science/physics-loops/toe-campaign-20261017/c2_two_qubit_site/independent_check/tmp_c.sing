LIB "homolog.lib";
ring S=2,(x,y,z),dp;
option(redSB);
matrix E[3][4]=x*z+x*y^2*z+x*y+x*y*z^2,y*z+x^2*y*z+x*z+x*y^2*z,x*z+x*y^2*z+x*y+x*y*z^2,y*z+x^2*y*z+x*z+x*y^2*z,y*z+x^2*y*z+x*z+x*y^2*z,y*z+x^2*y*z+x*y+x*y*z^2,y*z+x^2*y*z+x*y+x*y*z^2,x*z+x*y^2*z+x*y+x*y*z^2,y*z+x^2*y*z+x*y+x*y*z^2,x*z+x*y^2*z+x*y+x*y*z^2,y*z+x^2*y*z+x*z+x*y^2*z,y*z+x^2*y*z+x*y+x*y*z^2;
module Im = module(E);
module E3 = Ext_R(3, Im);
ideal A3 = quotient(E3, freemodule(nrows(E3)));
ideal A3s = sat(A3, x*y*z);
print("EXT3ZERO "+string(size(reduce(1, std(A3s)))==0));
ring T=2,(w,x,y,z),dp;
matrix Vm[4][3]=x^2*y*z+y*z+x*y^2*z+x*z,x^2*y*z+y*z+x*y*z^2+x*y,x*y^2*z+x*z+x*y*z^2+x*y,x*y^2*z+x*z+x*y*z^2+x*y,x^2*y*z+y*z+x*y^2*z+x*z,x^2*y*z+y*z+x*y*z^2+x*y,x^2*y*z+y*z+x*y^2*z+x*z,x*y^2*z+x*z+x*y*z^2+x*y,x^2*y*z+y*z+x*y*z^2+x*y,x*y^2*z+x*z+x*y*z^2+x*y,x^2*y*z+y*z+x*y*z^2+x*y,x^2*y*z+y*z+x*y^2*z+x*z;
module N = module(Vm), (w*x*y*z+1)*gen(1),(w*x*y*z+1)*gen(2),(w*x*y*z+1)*gen(3),(w*x*y*z+1)*gen(4);
N=std(N);
quit;
