LIB "elim.lib";
ring T=2,(w,x,y,z),dp; option(redSB);
module Fr=(w*x*y*z+1)*gen(1);
module Im = Fr,[x*z+x*y^2*z+x*y+x*y*z^2],[y*z+x^2*y*z+x*z+x*y^2*z],[0],[y*z+x^2*y*z+x*z+x*y^2*z+x*y+x*y*z^2]; Im=std(Im);
module Rf = Fr,[x*z+x*y^2*z+x*y+x*y*z^2],[y*z+x^2*y*z+x*z+x*y^2*z],[y*z+x^2*y*z+x*y+x*y*z^2],[0],[x*z+x*y^2*z+x*y+x*y*z^2],[y*z+x^2*y*z+x*z+x*y^2*z],[y*z+x^2*y*z+x*y+x*y*z^2],[y*z+x^2*y*z+x*z+x*y^2*z+x*y+x*y*z^2],[y*z+x^2*y*z],[x*y+x*y*z^2],[x*z+x*y^2*z],[y*z+x^2*y*z+x*z+x*y^2*z+x*y+x*y*z^2],[y*z+x^2*y*z],[x*y+x*y*z^2],[x*z+x*y^2*z]; Rf=std(Rf);
module Q0 = std(quotient(Rf, ideal(1+x^2*z*w^1)));
module Q1 = std(quotient(Rf, ideal(1+x*y^2*w^1)));
module Q2 = std(quotient(Rf, ideal(1+x*y)));
module Qi = std(intersect(Q0,Q1,Q2));
print("RF diag "+string(size(reduce(Qi,Im))==0));
module Q0 = std(quotient(Rf, ideal(1+x^2)));
module Q1 = std(quotient(Rf, ideal(1+y^2)));
module Q2 = std(quotient(Rf, ideal(1+z^2)));
module Qi = std(intersect(Q0,Q1,Q2));
print("RF even "+string(size(reduce(Qi,Im))==0));
module Q0 = std(quotient(Rf, ideal(1+x)));
module Q1 = std(quotient(Rf, ideal(1+y)));
module Q2 = std(quotient(Rf, ideal(1+z)));
module Qi = std(intersect(Q0,Q1,Q2));
print("RF unit "+string(size(reduce(Qi,Im))==0));
module Q0 = std(quotient(Rf, ideal(1+x^2*z*w^1)));
module Q1 = std(quotient(Rf, ideal(1+x*y)));
module Q2 = std(quotient(Rf, ideal(1+z)));
module Qi = std(intersect(Q0,Q1,Q2));
print("RF mixed "+string(size(reduce(Qi,Im))==0));
quit;
