LIB "homolog.lib";
ring r=2,(x,y,z),dp;
option(redSB);
matrix E[1][6]=0,x^1*z^1+x^1*y^2*z^1,x^1*y^1+x^1*y^1*z^2,y^1*z^1+x^2*y^1*z^1,x^1*z^1+x^1*y^2*z^1,0;
module N=E;
int i;
for(i=2;i<=3;i++){
 module X=Ext_R(i,N);
 ideal a=quotient(X,freemodule(nrows(X)));
 ideal s=sat(a,x*y*z);
 s=std(s);
 print("Aprime_187member Ext^"+string(i)+" localized: dim(ann)="+string(dim(s))+"  isZero="+string(size(reduce(1,s))==0));
}
quit;
