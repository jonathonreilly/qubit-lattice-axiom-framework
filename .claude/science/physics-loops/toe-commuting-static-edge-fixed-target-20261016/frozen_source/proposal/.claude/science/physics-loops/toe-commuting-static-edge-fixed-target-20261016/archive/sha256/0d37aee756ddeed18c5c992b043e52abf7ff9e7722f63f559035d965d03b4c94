#!/usr/bin/env python3
"""Record the actual metadata-only subprocess and source-at-launch."""
import datetime as dt
import hashlib
import json
from pathlib import Path
import platform
import subprocess
import sys
import time

root = Path(__file__).resolve().parent
source = root/'seal_metadata.py'
run = root/'runs/metadata_001'
run.mkdir(parents=True, exist_ok=False)
raw = source.read_bytes()
(run/'source_at_launch.py').write_bytes(raw)
(run/'recorder_at_launch.py').write_bytes(Path(__file__).read_bytes())
argv = [sys.executable, str(source)]
start = dt.datetime.now(dt.timezone.utc).isoformat()
tic = time.monotonic()
try:
    result = subprocess.run(argv, cwd=root, stdin=subprocess.DEVNULL,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            timeout=30, check=False)
    stdout, stderr, code, timeout = result.stdout, result.stderr, result.returncode, False
except subprocess.TimeoutExpired as exc:
    stdout, stderr, code, timeout = exc.stdout or b'', exc.stderr or b'', None, True
(run/'stdout.txt').write_bytes(stdout)
(run/'stderr.txt').write_bytes(stderr)
receipt = {'kind': 'metadata only; no scientific calculation', 'argv': argv,
           'cwd': str(root), 'start_utc': start,
           'end_utc': dt.datetime.now(dt.timezone.utc).isoformat(),
           'elapsed_seconds': time.monotonic()-tic, 'exit_code': code,
           'timeout': timeout, 'wall_limit_seconds': 30,
           'cpu_ram_limits': 'no separate limits', 'python': sys.version,
           'executable': sys.executable, 'platform': platform.platform(),
           'source_sha256': hashlib.sha256(raw).hexdigest(),
           'stdout_sha256': hashlib.sha256(stdout).hexdigest(),
           'stderr_sha256': hashlib.sha256(stderr).hexdigest()}
(run/'EXECUTION.json').write_text(json.dumps(receipt, indent=2)+'\n')
sys.stdout.buffer.write(stdout)
sys.stderr.buffer.write(stderr)
print(json.dumps({'receipt': str(run/'EXECUTION.json'), 'exit_code': code,
                  'timeout': timeout}, sort_keys=True))
sys.exit(1 if timeout or code is None else code)
