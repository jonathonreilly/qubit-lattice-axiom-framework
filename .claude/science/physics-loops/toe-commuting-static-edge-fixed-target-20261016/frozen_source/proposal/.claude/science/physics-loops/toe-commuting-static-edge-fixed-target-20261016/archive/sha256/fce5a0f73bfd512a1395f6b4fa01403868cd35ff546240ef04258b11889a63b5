def sha(data):
    return hashlib.sha256(data).hexdigest()

def read(path, expected=None):
    data = path.read_bytes()
    if expected is not None:
        assert sha(data) == expected, str(path)
    return data

def save(rel, data):
    dest = P / rel
    dest.parent.mkdir(parents=True, exist_ok=True)
    assert not dest.exists(), str(dest)
    dest.write_bytes(data)
    return {'path': rel, 'bytes': len(data), 'sha256': sha(data)}

def capture(path, rel, expected=None, coverage='identity/capture only'):
    data = read(path, expected)
    row = save(rel, data)
    row.update(source=str(path), coverage=coverage)
    entries.append(row)
    assert read(path) == data, 'source changed while capturing'
    return data

def command(label, argv, allowed=(0,)):
    start = datetime.now(timezone.utc).isoformat()
    result = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=10)
    out = save('command_captures/' + label + '/stdout', result.stdout)
    err = save('command_captures/' + label + '/stderr', result.stderr)
    record = {'argv': argv, 'start_utc': start,
              'end_utc': datetime.now(timezone.utc).isoformat(),
              'exit_code': result.returncode, 'stdout': out, 'stderr': err,
              'kind': 'read-only metadata/source read; no scientific execution'}
    save('command_captures/' + label + '/COMMAND.json',
         (json.dumps(record, indent=2) + '\n').encode())
    commands.append(record)
    assert result.returncode in allowed, label
    return result.stdout

