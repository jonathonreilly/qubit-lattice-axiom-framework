"""Capture exact selected comparison sources and real historical receipt members."""
from pathlib import Path
from datetime import datetime, timezone
import hashlib
import json

D = Path(__file__).resolve().parent
N = D.parent
W = N.parent / 'correlation_worktree'


def pin(path):
    data = path.read_bytes()
    return {'path': str(path), 'bytes': len(data), 'sha256': hashlib.sha256(data).hexdigest()}


specs = [
    (N / 'conditioned_positive_compiler_root_candidate/DERIVATION.md', 18196, '2de387eb501aa8ead91afa1f5a26f7d3a0bbf11e51285d99786715152ad5b6d6', 'Root proof; complete first exposed read20:47:22UTC batch.'),
    (N / 'conditioned_positive_compiler_root_candidate/PROPOSAL_FREEZE.json', 770, 'e49ad0cd5e6031729fbecf236c61f973b74d0891491c18f43e6b79fafcb7844d', 'Root two-member proposal freeze; complete read.'),
    (N / 'conditioned_positive_compiler_root_candidate/SOURCE_PINS.json', 1346, '5a9db9605466bd03d70cf69b93cfbcda04b3f87d02b89d4acb68cf99a971aca5', 'Root selected provenance; complete read. Historical publication is not an extra theorem premise.'),
    (N / 'conditioned_positive_compiler_root_readout/READOUT.md', 1598, 'd30ed09efe424a00942f79df8c4d94ab4f5a2e82dcf6f4a79a25365628a03048', 'Two mandatory chronology qualifications; complete read.'),
    (N / 'conditioned_positive_compiler_independent/DERIVATION.md', 30870, 'dd6cca8552a117d97f7be21c7b999ecd2276382f6cc762954bd97d00e3a6ff04', 'Own protected proof; complete authored/read coverage reused unchanged.'),
    (N / 'conditioned_positive_compiler_independent/FINAL_FREEZE.json', 4866, '586523f983bef60f52cd76d235074f98ea05a4a114475d349b59b36953edb47b', 'Protected27-member freeze; verified without copying the complete older packet.'),
    (N / 'conditioned_positive_compiler_independent/EXPOSURE_AND_SCOPE.md', 3357, 'e71dfe0ec3333325a1caceedb7c325096281d6623c995a9f4def13aee5665aec', 'Protected exposure statement; unchanged.'),
    (N / 'conditioned_positive_compiler_independent/ROUTE_AND_LIMITS.md', 2311, '062f93d6050b8320a47bcea056490d7ab5be760578925fa90ba89d5c00c7adc5', 'Protected route and pre-freeze clarifications; unchanged.'),
    (N / 'conditioned_positive_compiler_protected_root_read/READ.json', 3014, '2099790774c866ba2debf24b13a6b9a81e2b8c017ab72e60bc29346c9a56ec8e', 'Actual complete pre-exposure root read record; not final acceptance.'),
    (N / 'runs/conditioned_protected_review_2050/EXECUTION.json', 1466, '83a15498975a7214727e923abd89e299368e5cbdbb54fe3a72460295230a28cf', 'Actual root metadata launch,20:47:00-01UTC,exit0; complete read.'),
    (N / 'single_port_program_research/DERIVATION.md', 33757, 'bda0be884fa79905ff81f0a2642def9e2efd5302796262f5f9eb4033b2c436c0', 'Only old mathematical proof import; prior complete read reused.'),
    (N / 'single_port_program_decisive_check/REPORT.md', 27426, '3ad0ab6540ba9fae892824119aafa6c4e61ca16892ba3d23a7c59f95df82e7b5', 'Only old mathematical review import; complete reread in protected task, reused.'),
    (W / 'AGENTS.md', 1265, 'f9a7b41213cee9ff0b7e9a28f79b555c152de52ef012ff3bcdd09b996d3aa32f', 'Previously read instructions; matched exact revision.'),
    (W / 'docs/ai_methodology/SCIENCE_WORKFLOW.md', 15435, '05f3ec8e58ccd7a4d2a87643fb7ed4f12998c6a1d5721e3632a502de8a0ad6ce', 'Previously read workflow; matched exact revision.'),
    (Path('/Users/jonreilly/.codex/skills/physics-claim-reviewer/SKILL.md'), 14490, '9d841edd05b9dc4c5145abcfd5352cd45460a1cc57c23c1eabd131590dbb1455', 'Previously read claim-discipline skill; no audit invocation.'),
    (N / 'conditioned_positive_compiler_independent/record_metadata.py', 2123, 'c707dc710885a6c2b988454a98667abc9a0e0c364fe2dbcf6832489cff464e4a', 'Exact byte-for-byte current recorder reuse; metadata only.'),
]
receipt = json.loads((N / 'runs/conditioned_protected_review_2050/EXECUTION.json').read_text())
for key in ['child_source_at_launch', 'recorder', 'stdout', 'stderr']:
    row = receipt[key]
    specs.append((Path(row['path']), row['bytes'], row['sha256'], 'Actual root receipt member: ' + key + '; source/recorder/stdout completely read, empty stderr verified.'))
child = receipt['child_source_at_launch']
specs.append((N / 'runs/conditioned_protected_review_2050/executed_source.py', child['bytes'], child['sha256'], 'Actual captured source file, verified identical to source-at-launch; no invented LAUNCH file.'))
for label in ['capture', 'verify']:
    p = N / 'conditioned_positive_compiler_independent/metadata_runs' / label / 'EXECUTION.json'
    r = pin(p)
    specs.append((p, r['bytes'], r['sha256'], 'Protected derivation actual metadata receipt; linkage and member pins checked against unchanged protected freeze.'))
blobs = D / 'sources'
blobs.mkdir(exist_ok=True)
rows = []
for path, size, sha, coverage in specs:
    row = pin(path)
    assert row['bytes'] == size and row['sha256'] == sha, (str(path), row)
    q = blobs / sha
    if not q.exists():
        q.write_bytes(path.read_bytes())
    row.update({'coverage_and_role': coverage, 'recovery': str(q.relative_to(D))})
    rows.append(row)
assert (D / 'record_metadata.py').read_bytes() == (N / 'conditioned_positive_compiler_independent/record_metadata.py').read_bytes()
out = {'captured_utc': datetime.now(timezone.utc).isoformat(), 'scope': 'Exposed analytic comparison; selected exact source and actual receipt recovery only.', 'sources': rows, 'source_blobs': len(list(blobs.iterdir())), 'scientific_programs_run': 0, 'new_root_candidate_exposed': True, 'recovery_limits': 'Selected sources are copied once per SHA. Protected27-member freeze is checked at its original paths; unselected members and historical publication records are not recursively archived.'}
(D / 'SOURCE_MANIFEST.json').write_text(json.dumps(out, indent=2, sort_keys=True) + '\n')
print(json.dumps({'source_rows': len(rows), 'source_blobs': out['source_blobs'], 'scientific_programs_run': 0}, sort_keys=True))
