  "mutations": [
    {
      "name": "offdiagonal_population_leak",
      "before": "('directed bond', 4, {1:2})",
      "after": "('directed bond', 4, {1:2,2:2})",
      "expected_assertion": "off-diagonal unit feeds populations"
    },
    {
      "name": "collision_capacity_power",
      "before": "lam = base * K*K",
      "after": "lam = base * K",
      "expected_assertion": "all-fiber collision count"
    },
    {
      "name": "collision_output_vacancy",
      "before": "vacancy = (1-sp.Rational(n[k],K))*(1-sp.Rational(n[l],K))",
      "after": "vacancy = 1",
      "expected_assertion": "all-fiber collision count"
    },
    {
      "name": "hop_capacity_power",
      "before": "actual=sum((q*K for z in words",
      "after": "actual=sum((q for z in words",
      "expected_assertion": "hop port capacity normalization"
    },
    {
      "name": "fast_fiber_bias",
      "before": "A[i,ix[zz]]+=1; A[i,i]-=1",
      "after": "rate=1+bit(z,2*a); A[i,ix[zz]]+=rate; A[i,i]-=rate",
      "expected_assertion": "uniform fast-fiber stationarity"
    },
    {
      "name": "count_generator_vacancy",
      "before": "rate=base*n[i]*n[j]*(1-sp.Rational(n[k],K))*(1-sp.Rational(n[l],K))",
      "after": "rate=base*n[i]*n[j]",
      "expected_assertion": "actual averaged generator equals independent capacity-rate matrix"
    },
    {
      "name": "finite_path_fast_rate",
      "before": "E=expm((T/2)*(nu*An+Bn))",
      "after": "E=expm((T/2)*Bn)",
      "expected_assertion": "two-time count law uniformization control"
    },
    {
      "name": "renewal_first_gap",
      "before": "rate*sp.exp(-rate*u)*(1+rate*(t-u))",
      "after": "rate*sp.exp(-rate*u)*(rate*(t-u))",
      "expected_assertion": "Poisson renewal identity including the first waiting gap"
    },
    {
      "name": "capacity_deficit_constant",
      "before": "sp.Rational(total**3,16*cap)",
      "after": "sp.Rational(total**3,32*cap)",
      "expected_assertion": "collision capacity bound N^3/(16K)"
    },
    {
      "name": "reaction_energy_key",
      "before": "+(sum(t*t for t in V[i]+V[j]),)",
      "after": "+()",
      "expected_assertion": "collision preserves assigned momentum and kinetic energy"
    },
    {
      "name": "collision_patch_range",
      "before": "(4*r+2,3,0)]",
      "after": "(4*r+4,3,0)]",
      "expected_assertion": "collision patch diameter two"
    },
    {
      "name": "streaming_translation",
      "before": "shift[d]=velocity[d]*side",
      "after": "shift[d]=velocity[d]*(side-1)",
      "expected_assertion": "streaming is an actual nearest-neighbor bond across tiles"
    },
    {
      "name": "native_tree_depth",
      "before": "p=todo.popleft()",
      "after": "p=todo.pop()",
      "expected_assertion": "native tree is breadth-first for its actual coordinate graph"
    },
    {
      "name": "complete_graph_gap",
      "before": "factor=sp.Rational(2,K)",
      "after": "factor=sp.Rational(1,2*K)",
      "expected_assertion": "complete-graph Poincare positive-definite Gram"
    },
    {
      "name": "tree_route_return",
      "before": "return forward+forward[-2::-1]",
      "after": "return forward",
      "expected_assertion": "endpoint transposition routing must restore interior sites"
    },
    {
      "name": "product_mixing_factor",
      "before": "claimed=sp.Rational(5,16)",
      "after": "claimed=sp.Rational(1,4)",
      "expected_assertion": "integrated product TV differs from one-compartment TV"
    },
    {
      "name": "epsilon_capacity_half",
      "before": "ceil_fraction(2*T0*Ccap/eps0)",
      "after": "ceil_fraction(T0*Ccap/eps0)",
      "expected_assertion": "capacity part of epsilon allocation"
    },
    {
      "name": "epsilon_mixing_half",
      "before": "ceil_fraction(2*tau0*B0*(1+T0*B0)/eps0)",
      "after": "ceil_fraction(tau0*B0*(1+T0*B0)/eps0)",
      "expected_assertion": "mixing part of epsilon allocation"
    },
    {
      "name": "stopped_collision_direction",
      "before": "stopped_bound=8*omega**2*contribution/capacity_box",
      "after": "stopped_bound=4*omega**2*contribution/capacity_box",
      "expected_assertion": "stopped collision deficit includes both directions"
    },
    {
      "name": "stopped_hop_dimensions",
      "before": "sum(abs(x) for x in v)*weights[j]**2",
      "after": "abs(v[0])*weights[j]**2",
      "expected_assertion": "stopped hopping coefficient from actual equilibrium weights"
    },
    {
      "name": "selective_quantum_instrument",
      "before": "post=P@evolved@P",
      "after": "post=evolved",
      "expected_assertion": "actual quantum selective count-instrument joint law"
    },
    {
      "name": "inactive_factor_readout",
      "before": "np.kron(np.diag((count_A==n).astype(float)),np.eye(2))",
      "after": "np.kron(np.diag((count_A==n).astype(float)),np.diag([1,0]))",
      "expected_assertion": "actual quantum selective count-instrument joint law"
    },
    {
      "name": "nonlinear_resource_denominator",
      "before": "collision_exit=Km**2*cm/(Nm*wm**2)",
      "after": "collision_exit=Km**2*cm/(wm**2)",
      "expected_assertion": "stopped nonlinear resource exponent substitution"
    },
    {
