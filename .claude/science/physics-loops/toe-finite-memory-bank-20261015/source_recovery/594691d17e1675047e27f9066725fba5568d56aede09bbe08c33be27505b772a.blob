"""Capture exact bank and previously checked Markov/readiness sources; metadata only."""
from pathlib import Path
from datetime import datetime,timezone
import hashlib,json
OUT=Path(__file__).resolve().parent;N=OUT.parent;W=N.parent/'correlation_worktree'
def now():return datetime.now(timezone.utc).isoformat()
def meta(p):
    b=p.read_bytes();return {'path':str(p),'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
started=now();rows=[]
def save(src,rel,sha,scope):
    got=meta(src);assert got['sha256']==sha,str(src)
    dst=OUT/rel;dst.parent.mkdir(parents=True,exist_ok=True);dst.write_bytes(src.read_bytes())
    rows.append({'origin':got,'recovery':meta(dst),'scope':scope})
spec=[
('finite_memory_bank_root_candidate/DERIVATION.md','bank/DERIVATION.md','162d7504ad3951ed29add0facefc0bbdb227fcdf582e22250baad04a4f63c521','complete new source read and load-bearing composition reconstructed'),
('finite_memory_bank_root_candidate/PROPOSAL_FREEZE.json','bank/PROPOSAL_FREEZE.json','f5def3706984cd0a22b403eec48483c05baa6eabfa355edfd0dba190afc2f45f','complete one-member proposal checked'),
('correlated_markov_memory_candidate/DERIVATION.md','markov/DERIVATION.md','685db9bdbdefb04b855c28e0b45f03fae7401324b6f52589a25b2b25a045d9ea','prior full reading/check reused; needed probability/geometry/routing/control/scalar passages refreshed'),
('correlated_markov_memory_candidate/FINAL_FREEZE.json','markov/FINAL_FREEZE.json','80dd4aee7427ca5e87b283ecc2685691d2c4597b8365d2bf45d43c10c792d615','identity only; no recursive parent archive verification'),
('correlated_markov_memory_independent/comparison/REPORT.md','prior_reviews/MARKOV_REPORT.md','c001e42e06fe230e0e0d990f3664fef981d1d7e869b293beb1051fb04d4da3ef','exact own prior full comparison reused'),
('correlated_markov_memory_independent/comparison/FINAL_FREEZE.json','prior_reviews/MARKOV_FINAL_FREEZE.json','2eac27db7d14018db5f700df9ac318b7a01e7b3a7a0e26620fd2ed985c555f3a','prior seal identity only'),
('local_clock_joint_readiness_correction/DERIVATION.md','joint/DERIVATION.md','dcee9d6fbbe2e5a29a45a0ad6066c7038426398ececce8cefda7f08a7aa73179','prior complete corrected readiness check reused; pertinent phase/guard/resource passages refreshed'),
('rotated_gibbs_memory_decisive_check/FINAL_FREEZE.json','exposure/PRIOR_ROTATED_FINAL_FREEZE.json','7fa048ec66f485ae1f3a1e1ddee410dbf1d99354f42b6f5a7f9871000e1f021a','prior-task sequencing/exposure receipt only; not a theorem premise')]
for rel,dst,sha,scope in spec:save(N/rel,'sources/'+dst,sha,scope)
for p,dst,sha in [
(W/'AGENTS.md','AGENTS.md','f9a7b41213cee9ff0b7e9a28f79b555c152de52ef012ff3bcdd09b996d3aa32f'),
(W/'docs/ai_methodology/SCIENCE_WORKFLOW.md','SCIENCE_WORKFLOW.md','05f3ec8e58ccd7a4d2a87643fb7ed4f12998c6a1d5721e3632a502de8a0ad6ce'),
(Path('/Users/jonreilly/.codex/skills/physics-claim-reviewer/SKILL.md'),'physics-claim-reviewer.SKILL.md','9d841edd05b9dc4c5145abcfd5352cd45460a1cc57c23c1eabd131590dbb1455'),
(Path('/Users/jonreilly/.codex/skills/workhorse/SKILL.md'),'workhorse.SKILL.md','9801055aea637b0e6f765f1558113a9998fe6b4d5a213b0d03d096fe96cb4cdb')]:
    save(p,'instructions/'+dst,sha,'prior complete instruction reading reused at unchanged bytes; no delegation authorized')
canon=W/'docs/ROUTED_AUXILIARY_AND_JOINT_READINESS_BOUNDED_THEOREM_NOTE_2026-10-15.md';c=meta(canon)
assert c['sha256']=='00c2097abfb8ef1bc9fe1eb5e8f126c0fcbf897e132b74a25a879c14a6e60b4e'
assert canon.read_bytes()[70024:110857]==(OUT/'sources/joint/DERIVATION.md').read_bytes()
rows.append({'origin':c,'recovery':None,'scope':'canonical identity and corrected body [70024,110857) verified; exact body copy saved separately'})
f=json.loads((OUT/'sources/bank/PROPOSAL_FREEZE.json').read_text())
for row in f['files']:
    got=meta(OUT/'sources/bank'/row['path']);assert got['bytes']==row['bytes'] and got['sha256']==row['sha256']
result={'started_utc':started,'completed_utc':now(),'kind':'metadata-only capture after complete analytic reading','sources':rows,'proposal_members_verified':len(f['files']),'scientific_executions':0,'scientific_replays':0,'provisional_bias_or_rotation_used_as_premise':False,'other_worker_sources_opened':False}
(OUT/'SOURCE_MANIFEST.json').write_text(json.dumps(result,indent=2)+'\n')
print(json.dumps({'source_count':len(rows),'proposal_members':len(f['files']),'source_manifest':meta(OUT/'SOURCE_MANIFEST.json'),'scientific_executions':0},sort_keys=True))
