def sha(b): return hashlib.sha256(b).hexdigest()
def dump(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(value, indent=2) + "\n")
def write(rel, data):
    path=OUT/rel; path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(data if isinstance(data,bytes) else data.encode())
def checked(path, expected=None, size=None):
    data=path.read_bytes()
    if expected is not None: assert sha(data)==expected, str(path)
    if size is not None: assert len(data)==size, str(path)
    return data

if (D/"FINAL_FREEZE.json").exists():
    raise RuntimeError("Frozen proposal must not be rebuilt in place")
now=datetime.datetime.now(datetime.timezone.utc).isoformat()
wrapper=(D/"wrapper.md").read_bytes()
note=wrapper
body_map=[]
sources=[]
recovery_by_sha={}
freshness=[]
for name,rel,size,digest in BODIES:
    data=checked(N/rel,digest,size)
    note += ("\n\n---\n\n## Immutable source body: "+name+"\n\nHistorical source retained exactly; current status and interpretation are given above.\n\n").encode()
    start=len(note); note+=data; end=len(note)
    row={"name":name,"container":NOTE,"start_byte_inclusive":start,"end_byte_exclusive":end,"bytes":size,"sha256":digest}
    body_map.append(row)
    recovery={"kind":"body_interval","body_name":name,"container":NOTE,"start_byte_inclusive":start,"end_byte_exclusive":end}
    recovery_by_sha[digest]=recovery
    sources.append({"source":"campaign/"+rel,"role":"immutable_proof_or_review_body","bytes":size,"sha256":digest,"recovery":recovery})
    freshness.append({"original":str(N/rel),"bytes":size,"sha256":digest})
write(NOTE,note)
for row in body_map:
    raw=note[row["start_byte_inclusive"]:row["end_byte_exclusive"]]
    assert sha(raw)==row["sha256"] and note.count(raw)==1

dependencies=[]
for rel,size,digest,claim,rawrel,rawsha in PARENTS:
    data=checked(W/rel,digest,size)
    raw=checked(N/rawrel,rawsha)
    assert data.count(raw)==1
    start=data.index(raw)
    interval={"container":rel,"start_byte_inclusive":start,"end_byte_exclusive":start+len(raw),"bytes":len(raw),"sha256":rawsha}
    dependencies.append({"path":rel,"bytes":size,"sha256":digest,"claim_id":claim,"accepted_raw_source_sha256":rawsha,"accepted_body_interval":interval,"role":"direct_mathematical_parent"})
    recovery_by_sha[digest]={"kind":"external_pinned","path":rel}
    recovery_by_sha[rawsha]={"kind":"external_body_interval",**interval}
    sources.append({"source":"repository/"+rel,"role":"direct_mathematical_parent","bytes":size,"sha256":digest,"recovery":recovery_by_sha[digest]})
    sources.append({"source":"campaign/"+rawrel,"role":"parent_accepted_body","bytes":len(raw),"sha256":rawsha,"recovery":recovery_by_sha[rawsha]})
    freshness.append({"original":str(W/rel),"bytes":size,"sha256":digest})

objects={}
def archive(path,role):
    data=path.read_bytes(); digest=sha(data)
    try: label="campaign/"+str(path.relative_to(N))
    except ValueError: label="repository/"+str(path.relative_to(W))
    recovery=recovery_by_sha.get(digest)
    if recovery is None:
        rel=PACK+"/source_recovery/"+digest+".blob"
        write(rel,data)
        recovery={"kind":"blob","path":rel}
        recovery_by_sha[digest]=recovery
        objects[digest]={"path":rel,"bytes":len(data),"sha256":digest,"aliases":[]}
    if digest in objects: objects[digest]["aliases"].append(label)
    sources.append({"source":label,"role":role,"bytes":len(data),"sha256":digest,"recovery":recovery})
    freshness.append({"original":str(path),"bytes":len(data),"sha256":digest})

freeze_checks=[]
frozen_member_records=[]
for rel,digest in FREEZES:
    path=N/rel; payload=json.loads(checked(path,digest))
    members=payload.get("files",payload.get("members"))
    assert isinstance(members,list)
    for row in members:
        p=Path(row["path"])
        if not p.is_absolute(): p=path.parent/p
        checked(p,row["sha256"],row["bytes"])
        frozen_member_records.append({"freeze":"campaign/"+rel,"original":str(p),"bytes":row["bytes"],"sha256":row["sha256"]})
    freeze_checks.append({"source":"campaign/"+rel,"sha256":digest,"members_verified":len(members)})

roots=[N/rel for rel in ["correlated_markov_memory_candidate","correlated_markov_memory_independent/independent","correlated_markov_memory_independent/comparison","local_gibbs_memory_interface_root_candidate","local_gibbs_memory_interface_decisive_check","correlated_memory_root_review","gibbs_markov_composition_root_candidate","gibbs_markov_composition_decisive_check","gibbs_markov_composition_root_review"]]
selected={p for root in roots for p in root.iterdir() if p.is_file()}
for rel in ["correlated_markov_memory_candidate/draft_snapshot","correlated_markov_memory_independent/independent/metadata_runs","correlated_markov_memory_independent/comparison/metadata_runs","runs/correlated_memory_root_acceptance_1628","gibbs_markov_composition_decisive_check/metadata_runs","runs/gibbs_markov_composition_root_acceptance_1640"]:
    selected.update(p for p in (N/rel).rglob("*") if p.is_file())
selected.update(N/rel for rel in ["joint_readiness_root_review/ACCEPTANCE.md","local_clock_biased_memory_root_review/ACCEPTANCE.md"])
selected.add(N/"main_refresh_1622/REFS.json")
selected.add(N/"run.py")
body_paths={N/row[1] for row in BODIES}
for p in sorted(selected-body_paths):
    role="selected_historical_metadata_or_source"
    if p.parent.name=="correlated_memory_root_review" and p.name.endswith("ACCEPTANCE.md"): role="root_conditional_source_acceptance"
    if p.parent.name=="gibbs_markov_composition_root_review" and p.name=="ACCEPTANCE.md": role="root_conditional_source_acceptance"
    archive(p,role)
for key,filename in [("markov","MARKOV_ACCEPTANCE.md"),("gibbs","GIBBS_ACCEPTANCE.md")]:
    checked(N/"correlated_memory_root_review"/filename,ACCEPTANCES[key])
checked(N/"correlated_memory_root_review/VERIFICATION.json","3343903af4e62f2d205207213b245b047d38db47e603bfb37d2a9f690c86e56f")
checked(N/"gibbs_markov_composition_root_review/ACCEPTANCE.md",ACCEPTANCES["composition"],4125)
checked(N/"gibbs_markov_composition_root_review/VERIFICATION.json","664293ebf52d1112336adf34495d058ce7dcf7db0a26d63e2edb2b586209ef96")
checked(N/"main_refresh_1622/REFS.json","c1f2d21025b1d2904b4be008d76506149b1b8f32b637e20d6e9a42bb1d688e5c",2658)

instruction_rels=["AGENTS.md","docs/ai_methodology/SCIENCE_WORKFLOW.md","docs/ai_methodology/skills/physics-loop/SKILL.md","docs/ai_methodology/skills/physics-loop/references/DELIVERY.md","docs/ai_methodology/skills/physics-loop/references/CLAIM_STATUS.md","docs/ai_methodology/REVIEW_LOOP_PR_CONFORMANCE_SPEC.md","docs/ai_methodology/skills/PRIMITIVE_REGISTRY_CHECK.md","docs/ai_methodology/skills/SKILL_FRESHNESS_CHECK.md","docs/audit/data/axiom_premise_nodes.json","docs/REALIZED_STATE_PRIMITIVE_NOTE_2026-06-11.md"]
for rel in instruction_rels: archive(W/rel,"instruction_or_premise_classification_provenance_only")
checked(W/"docs/ai_methodology/SCIENCE_WORKFLOW.md","05f3ec8e58ccd7a4d2a87643fb7ed4f12998c6a1d5721e3632a502de8a0ad6ce")

selection=[]
for row in frozen_member_records:
    recovery=recovery_by_sha.get(row["sha256"])
    selection.append({**row,"recovery":recovery,"selection_status":"recoverable_selected_identity" if recovery else "not_selected_prior_source_snapshot","limit":None if recovery else "Historical freeze records this member; its bytes are not promised in this compact source package. Mathematical use is through the two exact canonical parents, not recursive archive closure."})

def packet_json(name,value): write(PACK+"/"+name,json.dumps(value,indent=2)+"\n")
packet_json("BODY_MAP.json",{"note":NOTE,"bodies":body_map})
packet_json("DEPENDENCIES.json",{"dependencies":dependencies,"geometry":"transitive through joint parent","git_ancestry_is_not_mathematical_dependency":True})
packet_json("SOURCE_MANIFEST.json",{"schema":"portable_source_recovery_v1","sources":sources,"scope":"Selected exact recovery, not recursive historical publication archives"})
packet_json("ARCHIVE_INDEX.json",{"schema":"sha256_deduplicated_recovery_v1","objects":sorted(objects.values(),key=lambda x:x["sha256"]),"immutable_bodies_stored_only_in_note":True})
packet_json("RECOVERY_SELECTION.json",{"current_source_freezes_checked":freeze_checks,"members":selection,"scope":"Historical frozen manifests are preserved literally; only listed recovered identities are portable package payload"})
packet_json("CANONICAL_BINDING.json",{"kind":"observed_exact_parent_bytes_not_actual_checkout_binding","expected_git_base":BASE,"parent_sha256":{x[0]:x[2] for x in PARENTS},"actual_binding":None,"source_acceptances":ACCEPTANCES})
packet_json("PUBLICATION_STATE.json",{"kind":"dated_source_proposal_not_actual_binding","created_utc":now,"canonical_binding":None,"git_base":None,"primary_execution":None,"cache_execution":None,"mutation_execution":None,"graph_execution":None,"publication_action":None,"retained_audit":None,"composition_source_decision":ACCEPTANCES["composition"],"scientific_programs_run":0,"historical_programs_replayed":0})
packet_json("ACTUAL_BINDING.json",{"kind":"unbound_source_proposal","canonical_parent_binding_complete":False,"root_read_complete":None,"note_sha256":None,"parent_sha256":None,"source_acceptances":None,"git_base":None,"receipt_paths":[]})

for p in sorted((D/"packet_text").glob("*")): write(PACK+"/"+p.name,p.read_bytes())
write(PACK+"/PR_TITLE.txt","[physics-loop] correlated-memory-delivery: bounded_theorem / conditional-support\n")

inputs=[]
for p in sorted(OUT.rglob("*")):
    if p.is_file() and str(p.relative_to(OUT)) not in {PRIMARY,PACK+"/INPUT_MANIFEST.json",PACK+"/ACTUAL_BINDING.json"}:
        data=p.read_bytes();inputs.append({"path":str(p.relative_to(OUT)),"bytes":len(data),"sha256":sha(data)})
manifest={"schema":"source_integrity_inputs_v1","inputs":inputs,"scope":"All package integrity reads; two external canonical parents are explicit additional inputs. No scientific execution."}
packet_json("INPUT_MANIFEST.json",manifest)
manifest_path=PACK+"/INPUT_MANIFEST.json"
declared=sorted({x["path"] for x in inputs}|{manifest_path,PACK+"/ACTUAL_BINDING.json"}|{x[0] for x in PARENTS})
template=(D/"primary_template.py").read_text()
template=template.replace("__MANIFEST_SHA256__",sha((OUT/manifest_path).read_bytes()))
template=template.replace("__AUDIT_INPUT_PATHS__",repr(declared))
template=template.replace("__EXPECTED_BODIES__",repr({x[0]:x[3] for x in BODIES}))
write(PRIMARY,template)
ast.parse(template)
for p in [D/"build_proposal.py",D/"primary_template.py"]: ast.parse(p.read_text())
dump(D/"SOURCE_FRESHNESS.json",{"verified_utc":now,"identities":freshness,"freezes":freeze_checks,"scope":"Metadata identity checks only; complete reading coverage is separately described"})
dump(D/"BUILD_RESULT.json",{"built_utc":datetime.datetime.now(datetime.timezone.utc).isoformat(),"note_bytes":len(note),"note_sha256":sha(note),"immutable_bodies":len(body_map),"mathematical_parents":len(dependencies),"selected_source_records":len(sources),"unique_recovery_blobs":len(objects),"proposal_files":sum(p.is_file() for p in OUT.rglob('*')),"scientific_programs_run":0,"historical_programs_replayed":0,"primary_executed":False,"actual_binding":None,"composition_claim_imported":True,"composition_source_decision":ACCEPTANCES["composition"]})
print((D/"BUILD_RESULT.json").read_text())
