"""One exact small discriminator for literal phase/order and logical routing.

No old compiler import, physical propagation, floating tolerance, or theorem
certification. Matrices are constructed from the stated elementary factors.
"""
from pathlib import Path
import json
import platform
import sys
import sympy as s

OUT = Path(sys.argv[1]); OUT.mkdir(exist_ok=False)
I=s.eye(2); X=s.Matrix([[0,1],[1,0]]); Y=s.Matrix([[0,-s.I],[s.I,0]]); Z=s.diag(1,-1)
H=s.Matrix([[1,1],[1,-1]])/s.sqrt(2); S=s.diag(1,s.I)

def local(a,site,n):
    factors=[I]*n; factors[site]=a
    return s.kronecker_product(*factors)

def cz(a,b,n):
    return s.diag(*[(-1)**(((x>>(n-1-a))&1)*((x>>(n-1-b))&1)) for x in range(2**n)])

def gate(label,matrix):
    return (label,matrix)

def multiply(factors):
    out=s.eye(factors[0][1].rows)
    # Stored factor convention is left-to-right matrix multiplication;
    # chronological emitted order is its reverse, recorded separately.
    for _,matrix in factors:
        out=out*matrix
    return out.applyfunc(s.simplify)

def sq(a):
    return s.simplify(s.trace(a.conjugate().T*a))

def cx(c0,s0,b):
    half=c0*I+s.I*s0*X; signed=c0*I+s.I*((-1)**b)*s0*X
    return [gate('X_half',local(half,1,2)),gate('CZ_01',cz(0,1,2)),
            gate('X_signed_half',local(signed,1,2)),gate('CZ_01',cz(0,1,2))]

def cnot(c,t,n):
    return [gate(f'H_{t}',local(H,t,n)),gate(f'CZ_{c}{t}',cz(c,t,n)),gate(f'H_{t}',local(H,t,n))]

def serialize(a):
    return [[str(s.simplify(a[i,j])) for j in range(a.cols)] for i in range(a.rows)]

matrices={}; words={}; findings=[]
U=((-161*I+240*s.I*X)/289)*((-119*I+120*s.I*Y)/169)*((-7*I+24*s.I*X)/25)
assert U.det()==1 and sq(U.conjugate().T*U-I)==0
for b in [0,1]:
    yword=[gate('S',local(S,1,2))]+cx(s.Rational(5,13),s.Rational(12,13),b)+[gate('S_adjoint',local(S.conjugate().T,1,2))]
    factors=cx(s.Rational(8,17),s.Rational(15,17),b)+yword+cx(s.Rational(3,5),s.Rational(4,5),b)
    actual=multiply(factors)
    expected=s.diag(U,I) if b==0 else s.diag(I,U)
    residual=sq(actual-expected);assert residual==0 and len(factors)==14
    key=f'controlled_SU2_b{b}'
    findings.append({'case':key,'letters':len(factors),'exact_squared_frobenius_error':str(residual)})
    matrices[key]={'actual':serialize(actual),'expected':serialize(expected)}
    words[key]=[name for name,_ in reversed(factors)]

zplus=(I+s.I*Z)/s.sqrt(2); zminus=(I-s.I*Z)/s.sqrt(2)
phase=[gate('scalar_exp_i_pi_over_4',local((1+s.I)*I/s.sqrt(2),0,2)),
       gate('Z0_minus_pi_over_4',local(zminus,0,2)),gate('Z1_plus_pi_over_4',local(zplus,1,2))]
phase+=cnot(1,0,2)+[gate('Z0_minus_pi_over_4',local(zminus,0,2))]+cnot(1,0,2)
actual=multiply(phase); target=s.diag(1,1,-1,1); mutant=multiply(phase[1:])
assert len(phase)==10 and sq(actual-target)==0
mutant_error=sq(mutant-target);assert s.simplify(mutant_error-(8-4*s.sqrt(2)))==0 and mutant_error.is_positive
findings.append({'case':'determinant_projector_phase','letters':len(phase),'exact_squared_frobenius_error':'0',
                 'omitted_scalar_squared_error':str(mutant_error),'predicted_mutant_squared_error':'8-4sqrt(2)'})
matrices['phase']={'actual':serialize(actual),'expected':serialize(target),'mutant':serialize(mutant)}
words['phase']=[name for name,_ in reversed(phase)]

swap=cnot(0,1,3)+cnot(1,0,3)+cnot(0,1,3)
route=swap+[gate('CZ_12',cz(1,2,3))]+swap
actual=multiply(route);target=cz(0,2,3);mutant=multiply(route[9:])
assert len(route)==19 and sq(actual-target)==0 and sq(mutant-target)==8
findings.append({'case':'adjacent_logical_route_CZ02','letters':len(route),'exact_squared_frobenius_error':'0',
                 'omitted_return_squared_error':'8'})
matrices['route']={'actual':serialize(actual),'expected':serialize(target),'mutant':serialize(mutant)}
words['route']=[name for name,_ in reversed(route)]
report={'kind':'exact_finite_logical_phase_and_route_discriminator','python':sys.version,'sympy':s.__version__,
        'platform':platform.platform(),'findings':findings,'arithmetic':'exact SymPy rational/radical matrices',
        'physical_circuit_compiler_executed':False,'general_theorem_certificate':False}
(OUT/'RESULT.json').write_text(json.dumps(report,indent=2)+'\n')
(OUT/'EXACT_MATRICES.json').write_text(json.dumps(matrices,indent=2)+'\n')
(OUT/'CHRONOLOGICAL_WORD_LABELS.json').write_text(json.dumps(words,indent=2)+'\n')
print(json.dumps(report,indent=2))
