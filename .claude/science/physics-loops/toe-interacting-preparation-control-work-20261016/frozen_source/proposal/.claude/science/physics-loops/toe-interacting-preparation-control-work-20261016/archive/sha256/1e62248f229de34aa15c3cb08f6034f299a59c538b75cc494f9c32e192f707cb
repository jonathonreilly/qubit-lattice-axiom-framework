"""Preserve the actual bounded check source, launcher, precheck and streams."""
from datetime import datetime,timezone
from pathlib import Path
import hashlib,json,os,resource,shutil,subprocess,sys,time
ROOT=Path(__file__).resolve().parent;RUN=ROOT/'runs/ramp_interface';RUN.mkdir(parents=True,exist_ok=False)
def info(p):
 b=p.read_bytes();return {'path':str(p),'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
def cpu():resource.setrlimit(resource.RLIMIT_CPU,(45,45))
for a,b in [('ramp_interface_check.py','SOURCE_AT_LAUNCH.py'),('run_check.py','LAUNCHER_AT_LAUNCH.py'),('PRECHECK_FINDINGS.md','PRECHECK_AT_LAUNCH.md')]:shutil.copyfile(ROOT/a,RUN/b)
argv=[sys.executable,'-B',str(RUN/'SOURCE_AT_LAUNCH.py'),str(RUN/'output')]
env=dict(os.environ);env.update(PYTHONDONTWRITEBYTECODE='1',OPENBLAS_NUM_THREADS='1',OMP_NUM_THREADS='1')
r={'kind':'actual_new_numerical_interface_check','argv':argv,'cwd':str(ROOT),'started_utc':datetime.now(timezone.utc).isoformat(),
   'source':info(RUN/'SOURCE_AT_LAUNCH.py'),'launcher':info(RUN/'LAUNCHER_AT_LAUNCH.py'),'precheck':info(RUN/'PRECHECK_AT_LAUNCH.md'),
   'limits':{'cpu_seconds':45,'wall_seconds':90,'address_space':None},'environment_overrides':{'PYTHONDONTWRITEBYTECODE':'1','OPENBLAS_NUM_THREADS':'1','OMP_NUM_THREADS':'1'}}
(RUN/'EXECUTION.json').write_text(json.dumps(r,indent=2)+'\n');start=time.monotonic()
try:
 p=subprocess.run(argv,cwd=ROOT,env=env,capture_output=True,timeout=90,preexec_fn=cpu)
 out,err=p.stdout,p.stderr;r['exit_code']=p.returncode
except Exception as exc:
 out=getattr(exc,'stdout',None) or b'';err=(getattr(exc,'stderr',None) or b'')+repr(exc).encode();r['exit_code']=None;r['exception']=repr(exc)
(RUN/'stdout.txt').write_bytes(out);(RUN/'stderr.txt').write_bytes(err)
r.update(finished_utc=datetime.now(timezone.utc).isoformat(),elapsed_wall_seconds=time.monotonic()-start,stdout=info(RUN/'stdout.txt'),stderr=info(RUN/'stderr.txt'))
(RUN/'EXECUTION.json').write_text(json.dumps(r,indent=2)+'\n');print(json.dumps(r,indent=2),flush=True);sys.exit(0 if r['exit_code']==0 else 1)
