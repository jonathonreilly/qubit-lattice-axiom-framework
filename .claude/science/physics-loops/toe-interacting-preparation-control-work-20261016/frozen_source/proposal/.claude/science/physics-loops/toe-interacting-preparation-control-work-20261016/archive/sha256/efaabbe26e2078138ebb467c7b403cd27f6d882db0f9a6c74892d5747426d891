def identity(path):
    data=path.read_bytes()
    return {'bytes':len(data),'sha256':hashlib.sha256(data).hexdigest()}

records=[]
for rel,expected,coverage in SPECS:
    src=N/rel
    ident=identity(src)
    assert ident['sha256']==expected,(rel,ident)
    dest=ROOT/'sources'/rel
    dest.parent.mkdir(parents=True,exist_ok=True)
    if dest.exists():
        assert dest.read_bytes()==src.read_bytes(),str(dest)
    else:
        shutil.copyfile(src,dest)
    records.append({'original_path':str(src),'snapshot_path':str(dest.relative_to(ROOT)),**ident,'coverage':coverage})

freeze_checks=[]
for rel,expected,coverage in SPECS:
    if not rel.endswith('/FREEZE.json'):continue
    src=N/rel
    members=json.loads(src.read_text())['members']
    for entry in members:
        p=Path(entry['path'])
        if not p.is_absolute():p=src.parent/p
        got=identity(p)
        assert got['bytes']==entry['bytes'] and got['sha256']==entry['sha256'],str(p)
    freeze_checks.append({'path':str(src),'direct_members_verified':len(members),'recursive_archive_traversal':False})

run=ROOT/'runs/ramp_interface'
receipt=json.loads((run/'EXECUTION.json').read_text())
for key in ['source','launcher','precheck','stdout','stderr']:
    recorded=receipt[key]
    got=identity(Path(recorded['path']))
    assert got['bytes']==recorded['bytes'] and got['sha256']==recorded['sha256'],key
assert receipt['exit_code']==0
