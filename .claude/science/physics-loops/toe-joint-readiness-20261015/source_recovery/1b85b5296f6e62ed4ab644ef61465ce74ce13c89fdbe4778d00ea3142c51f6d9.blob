#!/usr/bin/env python3
"""Refresh exact sources and recovery members; no scientific execution."""
from pathlib import Path
import json,hashlib,datetime
ROOT=Path(__file__).resolve().parent
def identity(p):
    b=p.read_bytes(); return {'path':str(p),'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
manifest=json.loads((ROOT/'SOURCE_MANIFEST.json').read_text())
verified=[]
for row in manifest['sources']:
    got=identity(Path(row['path']))
    assert got==row,row['path']
    verified.append(got)
cand=ROOT.parent/'local_clock_routed_auxiliary_preparation_candidate'
copies=[]
for p in sorted((ROOT/'sources').rglob('*')):
    if p.is_file():
        rel=p.relative_to(ROOT/'sources')
        assert p.read_bytes()==(cand/rel).read_bytes(),str(rel)
        copies.append(identity(p))
assert (ROOT/'REPORT.md').stat().st_size>20000
assert (ROOT/'READ_COVERAGE.md').is_file()
result={'checked_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'scope':'Exact source integrity and recovery-member freshness only; no scientific verification or replay.','source_count':len(verified),'copied_member_count':len(copies),'sources':verified,'recovery_copies':copies,'report':identity(ROOT/'REPORT.md'),'coverage':identity(ROOT/'READ_COVERAGE.md')}
(ROOT/'FINAL_SOURCE_RECHECK.json').write_text(json.dumps(result,indent=2)+'\n')
print(json.dumps({k:v for k,v in result.items() if k not in ('sources','recovery_copies')},indent=2))
