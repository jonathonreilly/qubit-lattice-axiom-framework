"""Source-only capture; no scientific evaluation or previous program execution."""
from pathlib import Path
from datetime import datetime, timezone
import hashlib, json
OUT=Path(__file__).resolve().parent
N=OUT.parent
W=N.parent/'correlation_worktree'
def now(): return datetime.now(timezone.utc).isoformat()
def meta(p):
    b=p.read_bytes()
    return {'path':str(p),'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
started=now()
spec=[
('rotated_gibbs_memory_root_candidate/DERIVATION.md','rotated/DERIVATION.md','30d934ee3f8d6f85ff8a3643cc2af285c478d6adb892ef1c83061a74ca86efa2','complete new argument read'),
