canon=W/'docs/ROUTED_AUXILIARY_AND_JOINT_READINESS_BOUNDED_THEOREM_NOTE_2026-10-15.md'
c=meta(canon)
assert c['sha256']=='00c2097abfb8ef1bc9fe1eb5e8f126c0fcbf897e132b74a25a879c14a6e60b4e'
body=canon.read_bytes()[70024:110857]
assert body==(OUT/'sources/joint/DERIVATION.md').read_bytes()
rows.append({'origin':c,'recovery':None,'scope':'canonical identity and exact corrected body interval [70024,110857) verified; body recovery saved separately'})
nested=[]
for rel in ['sources/rotated/PROPOSAL_FREEZE.json','sources/local_bias_provisional/PROPOSAL_FREEZE.json','sources/local_bias_qualification/FINAL_FREEZE.json']:
    p=OUT/rel
    f=json.loads(p.read_text())
    for row in f['files']:
        got=meta(p.parent/row['path'])
        assert got['bytes']==row['bytes'] and got['sha256']==row['sha256']
    nested.append({'freeze':str(p),'members':len(f['files'])})
result={'started_utc':started,'completed_utc':now(),'kind':'metadata-only source capture after analytic reading','sources':rows,'nested_small_source_freezes':nested,'scientific_executions':0,'scientific_replays':0,'other_worker_local_bias_opened':False,'finite_bank_candidate_opened':False}
(OUT/'SOURCE_MANIFEST.json').write_text(json.dumps(result,indent=2)+'\n')
print(json.dumps({'source_count':len(rows),'small_freeze_members':sum(x['members'] for x in nested),'source_manifest':meta(OUT/'SOURCE_MANIFEST.json'),'scientific_executions':0},sort_keys=True))
