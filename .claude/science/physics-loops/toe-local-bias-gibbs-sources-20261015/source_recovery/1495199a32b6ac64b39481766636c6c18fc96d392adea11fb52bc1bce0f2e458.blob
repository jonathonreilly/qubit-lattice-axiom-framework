('gibbs_markov_composition_decisive_check/REPORT.md','prior_reviews/COMPOSITION_REPORT.md','406f011ca08f7c7d7bfc37ac232c11bfe7c32c1c0ae70abad0ba3a9591ded24b','own prior composition check reused; target/error/work passages reread'),
('gibbs_markov_composition_decisive_check/FINAL_FREEZE.json','prior_reviews/COMPOSITION_FINAL_FREEZE.json','de54ab338a81d76ace04601e2bd93edd122422a518ac86a5823c8d473f9804e6','prior seal identity only'),
('local_clock_joint_readiness_correction/DERIVATION.md','joint/DERIVATION.md','dcee9d6fbbe2e5a29a45a0ad6066c7038426398ececce8cefda7f08a7aa73179','prior full corrected proof check reused; unchanged readiness consumer'),
('local_bias_noncommuting_boundary_decisive_check/REPORT.md','prior_reviews/BOUNDARY_REPORT.md','ea09041f874b7685aee1d7c2d05ff7a003c31c4bb077ed54c1e1afc0a4237f7c','prior boundary review completed before rotated-source exposure'),
('local_bias_noncommuting_boundary_decisive_check/FINAL_FREEZE.json','prior_reviews/BOUNDARY_FINAL_FREEZE.json','e2611ac1546fe0bb94a5ca0a23e92ea9a9982ec3f45c4b7b38d7fa119e43a8d7','prior seal identity only')]
rows=[]
def save(src,rel,sha,scope):
    got=meta(src)
    assert got['sha256']==sha,str(src)
    dst=OUT/rel
    dst.parent.mkdir(parents=True,exist_ok=True)
    dst.write_bytes(src.read_bytes())
    rows.append({'origin':got,'recovery':meta(dst),'scope':scope})
for rel,dst,sha,scope in spec: save(N/rel,'sources/'+dst,sha,scope)
instructions=[
(W/'AGENTS.md','AGENTS.md','f9a7b41213cee9ff0b7e9a28f79b555c152de52ef012ff3bcdd09b996d3aa32f'),
