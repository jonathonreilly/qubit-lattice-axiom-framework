"""Actual recorder for source metadata only; scientific programs are not allowed."""
from pathlib import Path
from datetime import datetime,timezone
import hashlib,json,subprocess,sys
OUT=Path(__file__).resolve().parent
name,label=sys.argv[1:3]
assert name in ['capture_metadata.py','verify_metadata.py']
run=OUT/'metadata_runs'/label;run.mkdir(parents=True,exist_ok=False)
script=OUT/name
def now():return datetime.now(timezone.utc).isoformat()
def meta(p):
 b=p.read_bytes();return {'path':str(p),'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
def write(p,x):p.write_text(json.dumps(x,indent=2)+'\n')
(run/'child_source.py').write_bytes(script.read_bytes());(run/'recorder_source.py').write_bytes(Path(__file__).read_bytes())
argv=[sys.executable,'-B',str(script)]
write(run/'LAUNCH.json',{'started_utc':now(),'argv':argv,'cwd':str(OUT),'interpreter':sys.version,'child':meta(script),'recorder':meta(Path(__file__)),'timeout_seconds':60,'kind':'metadata only; no science, replay or Git'})
try:
 r=subprocess.run(argv,cwd=OUT,capture_output=True,timeout=60);code,out,err=r.returncode,r.stdout,r.stderr
except subprocess.TimeoutExpired as e:
 code,out,err=124,e.stdout or b'',(e.stderr or b'')+b'\nmetadata timeout\n'
(run/'stdout').write_bytes(out);(run/'stderr').write_bytes(err)
write(run/'EXECUTION.json',{'finished_utc':now(),'exit_code':code,'launch':meta(run/'LAUNCH.json'),'stdout':meta(run/'stdout'),'stderr':meta(run/'stderr')})
sys.stdout.buffer.write(out);sys.stderr.buffer.write(err);raise SystemExit(code)
