    "615f13aaa70e82d50cdf1a8aa479eb40d6ce70a3bb7b152ac63fd88bee341f37",
    "unchanged_registry_scope", "Prior exact complete coverage reused; no new primitive claim")

freeze_results = []
for directory, filename in [("local_gibbs_controller_independent", "FINAL_FREEZE.json"),
                            ("local_gibbs_controller_root_candidate", "PROPOSAL_FREEZE.json")]:
    base = N / directory
    freeze = json.loads((base / filename).read_text())
    members = []
    for entry in freeze["files"]:
        path = Path(entry["path"])
        path = path if path.is_absolute() else base / path
        if not path.resolve().is_relative_to(base.resolve()):
            raise ValueError("Unexpected freeze member escape: " + str(path))
        members.append(verify(path, entry["bytes"], entry["sha256"]))
    freeze_results.append({"base": str(base), "freeze": digest(base / filename),
                           "members_verified": len(members), "members": members})

root_external = []
for row in json.loads((N / "local_gibbs_controller_root_candidate/SOURCE_PINS.json").read_text())["sources"]:
    root_external.append(verify(Path(row["path"]), row["bytes"], row["sha256"]))

manifest = {"actual_utc": datetime.now(timezone.utc).isoformat(), "sources": sources,
            "original_freezes": freeze_results, "root_external_pins_identity_only": root_external,
            "source_exposed_comparison": True, "scientific_programs_run": 0,
            "scientific_replays": 0, "metadata_is_science": False,
            "editable_prompt_changes": [],
            "scope": "Exact source identities, selected recovery and original frozen-member preservation only"}
(O / "SOURCE_MANIFEST.json").write_text(json.dumps(manifest, indent=2) + "\n")
result = {"actual_utc": datetime.now(timezone.utc).isoformat(),
          "kind": "metadata_only_verification", "source_rows": len(sources),
          "recovery_files": len(list(recovery.iterdir())),
          "original_freeze_member_counts": [x["members_verified"] for x in freeze_results],
          "root_external_identity_pins": len(root_external),
          "report": digest(O / "REPORT.md"), "manifest": digest(O / "SOURCE_MANIFEST.json"),
          "scientific_runs": 0, "scientific_replays": 0, "proof_acceptance": None,
          "scope": "This result does not verify mathematics, supply a Gibbs state, or confer audit/publication status"}
text = json.dumps(result, indent=2) + "\n"
(O / "METADATA_VERIFICATION.json").write_text(text)
print(text, end="")
