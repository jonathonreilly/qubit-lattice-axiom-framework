    "395deb75d4d733683c51ba18a53fa3d1735cc86f62112c2f0c5d7fb2e94a4273",
    "root_source_scope", "Complete read; all exact external pins verified below", True)
add(N / "local_gibbs_controller_root_candidate/PRIMARY_CONTEXT_TOOL_RESPONSE.json", 10987,
    "32f18faf93644d5b32e35b9a60787297c00e07e612d4b8426a9ed5957b8d2db8",
    "root_literature_exposure", "Complete saved response; abstract/metadata only, no full paper", True)
add(N / "local_gibbs_controller_independent/REPORT.md", 3705,
    "1217498d36a7bc38d92a9b2cf2a2e29ec453bd53373112810315dbe0349ab302",
    "independent_scope_report", "Complete read", True)
