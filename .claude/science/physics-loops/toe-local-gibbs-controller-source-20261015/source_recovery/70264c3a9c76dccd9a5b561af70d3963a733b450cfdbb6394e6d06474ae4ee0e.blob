"""Byte identity/recovery verification only; no mathematical experiment."""
from pathlib import Path
from datetime import datetime, timezone
import hashlib
import json
import sys

O = Path(sys.argv[1]).resolve()
N = O.parent
W = N.parent / "correlation_worktree"
assert O.name == "local_gibbs_controller_comparison"


def digest(path):
    data = path.read_bytes()
    return {"path": str(path), "bytes": len(data), "sha256": hashlib.sha256(data).hexdigest()}


def verify(path, size, sha):
    row = digest(path)
    if row["bytes"] != size or row["sha256"] != sha:
        raise ValueError({"source_changed": str(path), "expected": [size, sha], "actual": row})
    return row


sources = []
recovery = O / "source_recovery"
recovery.mkdir()


def add(path, size, sha, role, scope, copy=False):
    row = verify(path, size, sha)
    row.update(role=role, read_scope=scope)
    if copy:
        dest = recovery / (sha + path.suffix)
        if not dest.exists():
            dest.write_bytes(path.read_bytes())
        r = verify(dest, size, sha)
        r["path"] = str(dest.relative_to(O))
        row["recovery"] = r
    sources.append(row)
    return row


add(N / "local_gibbs_controller_independent/DERIVATION.md", 31566,
    "4e0c90fb7fa515868aaa491525e89c1e80014180e2e88189b32c07f04d2eeb40",
    "pre_exposure_independent_proof", "Complete author/read coverage and all313 lines reread", True)
