"""Capture an explicit permitted source list; metadata only, no science run."""
from pathlib import Path
import datetime
import hashlib
import json

D = Path(__file__).resolve().parent
N = D.parent
W = N.parent / 'correlation_worktree'

SOURCES = [
    (N/'basis_state_clock_comparison/REPORT.md', '8c3ba783afdfa526e9da08df73760d8b6f0477c2598002b4c71fc042e480a2c2', 'Complete unchanged permitted comparison; prior complete read reused'),
    (N/'basis_state_clock_comparison/FINAL_FREEZE.json', '6e678e807ac242b7caeeaf0ec4e40df801b482180a4bc6d5cfe8418c351df8f3', 'Prior immutable comparison freeze; all members checked as bytes'),
    (N/'basis_state_clock_comparison/READ_COVERAGE.md', '10c6e80c36ce5e4691c045ed2045aba6f78c75e8d5ef7f404e4479a6ea87b95f', 'Prior exact reading/exposure record'),
    (N/'single_port_autonomous_root_candidate/DERIVATION.md', '0e91f9369e387608f8fb3720c290e67f6aa98b10f13428866334c8507b9e989d', 'Complete unchanged permitted autonomous source; prior complete read reused'),
    (N/'single_port_autonomous_root_candidate/PROPOSAL_FREEZE.json', 'f3b497f3db6c64809877be9b8b547e048e673da9203e3a7d40a106d51e166d10', 'Exact earlier candidate freeze; no current polynomial candidate accessed'),
    (N/'single_port_autonomous_decisive_check/REPORT.md', '52eb2e2dcd9fc56a7be490e193b57754bd85bfad5d585244d4a9fce947b4465d', 'Complete unchanged permitted autonomous review; prior complete read reused'),
    (N/'single_port_autonomous_decisive_check/FINAL_FREEZE.json', '6d0eb6e19a96167e3bb967a16f3a38f80daf2077563ac98195631c4622be6fe4', 'Earlier report freeze; exact byte verification, not a new science check'),
    (W/'AGENTS.md', 'f9a7b41213cee9ff0b7e9a28f79b555c152de52ef012ff3bcdd09b996d3aa32f', 'Unchanged current instructions; previous complete reading reused'),
    (W/'docs/ai_methodology/SCIENCE_WORKFLOW.md', '05f3ec8e58ccd7a4d2a87643fb7ed4f12998c6a1d5721e3632a502de8a0ad6ce', 'Unchanged current workflow; previous complete reading reused'),
    (Path('/Users/jonreilly/.codex/skills/physics-claim-reviewer/SKILL.md'), '9d841edd05b9dc4c5145abcfd5352cd45460a1cc57c23c1eabd131590dbb1455', 'Previously read unchanged reviewer skill; not an audit invocation'),
    (N/'basis_state_clock_comparison/record_metadata.py', 'c707dc710885a6c2b988454a98667abc9a0e0c364fe2dbcf6832489cff464e4a', 'Byte-exact reuse of bounded metadata recorder'),
]


def digest(data):
    return hashlib.sha256(data).hexdigest()


def checked(path, expected):
    data = path.read_bytes()
    assert digest(data) == expected, str(path)
    return data


freeze_checks = []
for index in (1, 4, 6):
    path, expected, _ = SOURCES[index]
    freeze = json.loads(checked(path, expected))
    for row in freeze['files']:
        member = Path(row['path'])
        if not member.is_absolute():
            member = path.parent / member
        assert member.resolve().is_relative_to(path.parent.resolve())
        data = checked(member, row['sha256'])
        assert len(data) == row['bytes']
    freeze_checks.append({'path': str(path), 'sha256': expected,
                          'members_verified_as_bytes': len(freeze['files'])})

recovery = D/'source_recovery'
recovery.mkdir(exist_ok=False)
records = []
for path, expected, coverage in SOURCES:
    data = checked(path, expected)
    target = recovery/(expected+'.blob')
    if not target.exists():
        target.write_bytes(data)
    records.append({'original_path': str(path), 'bytes': len(data),
                    'sha256': expected, 'recovery': str(target.relative_to(D)),
                    'coverage': coverage})
assert (D/'record_metadata.py').read_bytes() == SOURCES[-1][0].read_bytes()
manifest = {
    'schema': 'polynomial-path-independent-source-manifest-v1',
    'captured_utc': datetime.datetime.now(datetime.timezone.utc).isoformat(),
    'scope': 'Pre-exposure derivation; selective exact source recovery',
    'current_root_polynomial_candidate_accessed': False,
    'other_worker_current_sources_accessed': False,
    'earlier_mass_regularization_exposure': True,
    'scientific_programs_run': 0,
    'source_freezes_verified': freeze_checks,
    'sources': records,
}
(D/'SOURCE_MANIFEST.json').write_text(json.dumps(manifest, indent=2)+'\n')
print(json.dumps({'sources': len(records), 'recovery_blobs': len(list(recovery.iterdir())),
                  'freeze_checks': freeze_checks, 'scientific_programs_run': 0}))
