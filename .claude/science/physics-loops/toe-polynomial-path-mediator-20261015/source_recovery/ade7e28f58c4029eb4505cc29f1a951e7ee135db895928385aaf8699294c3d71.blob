"""One bounded scientific sanity fixture, not a universal proof or independent audit."""
from pathlib import Path
import datetime, hashlib, json
import numpy as np
import scipy
N=Path('/Users/jonreilly/Documents/Codex/research_runs/toe_leap_20261009/renewal_20261014_214309')
D=N/'polynomial_path_mediator_root_fixture'; D.mkdir(exist_ok=False)
I=np.eye(2,dtype=complex); X=np.array([[0,1],[1,0]],complex); Y=np.array([[0,-1j],[1j,0]],complex); Z=np.diag([1.,-1.]); occ=(I-Z)/2
def local(mat,site,m):
    a=np.array([[1.]],complex)
    for j in range(m): a=np.kron(a,mat if j==site else I)
    return a
def aux(m,mu):
    ns=[local(occ,j,m) for j in range(m)]; xs=[local(X,j,m) for j in range(m)]; ys=[local(Y,j,m) for j in range(m)]
    L=mu*sum(ns)
    for j in range(m-1): L=L+ns[j]+ns[j+1]-(xs[j]@xs[j+1]+ys[j]@ys[j+1])/2
    return L,ns,xs,ys
def lap(m):
    B=np.zeros((m,m))
    for j in range(m-1):
        B[j,j]+=1;B[j+1,j+1]+=1;B[j,j+1]-=1;B[j+1,j]-=1
    return B
def norm(a): return float(np.linalg.norm(a,2))
def close(a,b,tol=2e-9):
    err=norm(np.atleast_2d(a-b)); assert err<=tol*max(1,norm(np.atleast_2d(a)),norm(np.atleast_2d(b))),err
    return err
spectra=[];responses=[];correctors=[]
for exponent in (2,3):
    for m in range(2,9):
        mu=m**(-exponent);L,*_=aux(m,mu);ev=np.linalg.eigvalsh(L)
        e0=close(ev[:1],np.array([0.]));eg=close(ev[1:2],np.array([mu]));en=close(ev[-1:],np.array([2*(m-1)+mu*m]))
        spectra.append(dict(m=m,mass_exponent=exponent,gap=float(ev[1]),norm=float(ev[-1]),errors=[e0,eg,en]))
    for m in [2,3,5,8,16,31,64]:
        mu=m**(-exponent);T=np.linalg.inv(lap(m)+mu*np.eye(m))
        if exponent==2:
            assert T[0].min()>=m/2-1e-7 and T[0].max()<=2*m+1e-7
            assert np.diag(T).min()>=m-1e-7 and np.diag(T).max()<=2*m+1e-7
        else:
            assert T.min()>=7*m*m/8-1e-6 and T.max()<=9*m*m/8+1e-6
        responses.append(dict(m=m,mass_exponent=exponent,min=float(T.min()),max=float(T.max()),endpoint_min=float(T[0].min())))
    n=2;r=n+1;m=n+4;mu=m**(-exponent);tau=1.3;Omega=np.pi/(2*tau)
    L,ns,xs,ys=aux(m,mu);d=2**m;R=np.zeros_like(L);R[1:,1:]=np.linalg.inv(L[1:,1:]);T=np.linalg.inv(lap(m)+mu*np.eye(m))
    assert close(norm(R),m**exponent)<1e-6
    q=1. if exponent==2 else 1/m
    aa=np.array([0.,.4,0.]);bb=np.array([0.,.2,0.]);cc=np.array([0.,-.17,0.]);zs=-(bb+1j*cc)/(2*q*T[0,3:])
    Kc=Omega*n*np.eye(r)
    for j in range(n):Kc[j,j+1]=Kc[j+1,j]=-Omega*np.sqrt((j+1)*(n-j))
    Hp=I+.17*X+.23*Y+.19*Z
    base=np.kron(Hp,np.eye(r))+np.kron(I,Kc)
    kap=4*q*q*T[0,0];ds=abs(zs)**2*np.diag(T)[3:]
    Cct=np.kron(kap*occ,np.eye(r))+np.kron(I,np.diag(ds))
    W=np.kron(X,np.diag(bb))+np.kron(Y,np.diag(cc))
    A0=base+np.kron(I,np.diag(aa))+Cct;Htar=base+np.kron(I,np.diag(aa))+W
    V=q*(np.kron(np.kron(X,np.eye(r)),xs[0])+np.kron(np.kron(Y,np.eye(r)),ys[0]))
    for j in range(r):
        pj=np.zeros((r,r));pj[j,j]=1
        V+=np.kron(np.kron(I,pj),zs[j].real*xs[j+3]+zs[j].imag*ys[j+3])
    vac=np.eye(d)[:,0:1];J=np.kron(np.eye(2*r),vac);Re=np.kron(np.eye(2*r),R);Le=np.kron(np.eye(2*r),L);A=np.kron(A0,np.eye(d))
    Xc=Re@V@J;Yc=Re@V@Xc;sig=J.conj().T@V@Xc
    contract_error=close(sig,Cct-W);two=np.array([int(k).bit_count()==2 for k in range(d)])
    off_two=norm((np.kron(np.eye(2*r),np.diag(1-two.astype(int))))@Yc);assert off_two<1e-8
    v=2*q+sum(abs(zs));rhoP=(I+.15*X+.2*Y+.1*Z)/2;rho0=np.kron(rhoP,np.diag([1.,0.,0.]));rho=J@rho0@J.conj().T
    DP=Hp+kap*occ
    for Delta in [5.,50.]:
        eps=Delta**-.5;Zc=J-eps*Xc+eps*eps*Yc;K=Delta*Le+np.sqrt(Delta)*V+A
        left=K@Zc-Zc@Htar;right=eps*(V@Yc-A@Xc+Xc@Htar)+eps*eps*(A@Yc-Yc@Htar)
        residual_error=close(left,right)
        reserve=np.sqrt(Delta)*v;Kp=K+reserve*np.eye(K.shape[0]);mean=float(np.trace(rho@Kp).real);variance=float(np.trace(rho@Kp@Kp).real-mean*mean)
        expected_mean=float(np.trace(rhoP@DP).real+Omega*n+reserve)
        expected_var=float(np.trace(rhoP@DP@DP).real-np.trace(rhoP@DP).real**2+Omega**2*n+4*Delta*q*q*np.trace(rhoP@occ).real)
        moment_errors=[close(mean,expected_mean),close(variance,expected_var)]
        correctors.append(dict(mass_exponent=exponent,n=n,m=m,Delta=Delta,q=q,contraction_error=contract_error,two_excitation_support_error=off_two,residual_error=residual_error,mean=mean,variance=variance,moment_errors=moment_errors))
def pin(p):
    b=p.read_bytes();return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
report=dict(utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),kind='Bounded numerical scientific sanity fixture',scientific_programs_run=1,universal_proof=False,independent_derivation=False,numpy=np.__version__,scipy=scipy.__version__,source=pin(Path(__file__)),proof_sources=[pin(N/'polynomial_path_mediator_root_candidate/DERIVATION.md'),pin(N/'polynomial_path_mediator_independent/DERIVATION.md')],full_auxiliary_spectra=spectra,response_checks=responses,full_auxiliary_one_clock_sector_correctors=correctors,limitations='Double precision, finitely many dimensions/parameters; no long-time evolution test or blanket theorem validation. Auxiliary full excitation sectors are retained; the contraction/runtime fixture uses the permitted one-clock-head sector. No native device, preparation, work identification, or empirical evidence.',editable_prompt_files_changed=[])
p=D/'RESULTS.json';p.write_text(json.dumps(report,indent=2)+'\n');print(json.dumps({'result':pin(p),'spectra':len(spectra),'responses':len(responses),'correctors':len(correctors),'scientific_programs_run':1}))
