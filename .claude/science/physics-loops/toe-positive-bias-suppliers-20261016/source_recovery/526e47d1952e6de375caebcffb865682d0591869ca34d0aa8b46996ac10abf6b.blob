"""Hash-only provenance verification and final review freeze; no science rerun."""
from datetime import datetime, timezone
from pathlib import Path
import hashlib
import json

base = Path(__file__).resolve().parent
N = base.parent
candidate = N / "positive_chain_strong_point_candidate"
W = N.parent / "correlation_worktree"

def identity(path):
    data = path.read_bytes()
    return {"path": str(path), "bytes": len(data), "sha256": hashlib.sha256(data).hexdigest()}

def verify(path, expected, size=None):
    item = identity(path)
    assert item["sha256"] == expected, str(path)
    if size is not None:
        assert item["bytes"] == size, str(path)
    return item

frozen = verify(candidate / "FREEZE.json", "f507ca272de325aada74b249e8eae9881791979a9ee2374bce2828fe1e1e86c7")
candidate_freeze = json.loads((candidate / "FREEZE.json").read_text())
members = [verify(candidate / row["path"], row["sha256"], row["bytes"]) for row in candidate_freeze["members"]]
verify(candidate / "DERIVATION.md", "54cdf957111f03d6efadd2d6df91a871ea943859dea8639c47343022bfab0d12", 22051)

parent_manifest = json.loads((candidate / "SOURCE_MANIFEST.json").read_text())
parent_snapshots = []
for row in parent_manifest["sources"]:
    snap = verify(candidate / row["snapshot"], row["sha256"], row["bytes"])
    original = verify(Path(row["original"]), row["sha256"], row["bytes"])
    parent_snapshots.append({"snapshot": snap, "original": original})

proof_freeze = json.loads((base / "PROOF_FINDINGS_FREEZE.json").read_text())
verify(Path(proof_freeze["path"]), proof_freeze["sha256"], proof_freeze["bytes"])
receipt_path = base / "noncommuting_check/EXECUTION.json"
receipt = json.loads(receipt_path.read_text())
for key in ("source_at_launch", "launcher_at_launch", "stdout", "stderr"):
    row = receipt[key]
    verify(Path(row["path"]), row["sha256"], row["bytes"])
assert receipt["exit_code"] == 0 and not receipt["timed_out"]
assert json.loads((base / "noncommuting_check/stdout.json").read_text())["all_assertions_passed"]
verify(base / "check_noncommuting_leading_term.py", receipt["source_at_launch"]["sha256"])
verify(base / "run_reviewer_check.py", receipt["launcher_at_launch"]["sha256"])

read_sources = [
    (candidate / "DERIVATION.md", "Complete 217-line argument read before candidate check code. The subsequent numbered duplicate read was truncated, but the original full reading was complete; lines 1-44 were reread separately."),
    (candidate / "FREEZE.json", "Complete metadata read; every member verified by current bytes/hash."),
    (candidate / "SOURCE_MANIFEST.json", "Complete manifest read; all seven snapshots and their current original files hash-verified."),
    (candidate / "SOURCE_EXPOSURE.md", "Complete exposure record read."),
    (N / "positive_chain_root_proposal/PROPOSED_LEMMAS.md", "Complete exposed ancestor read after the initial proof findings were recorded; not treated as accepted mathematics."),
    (candidate / "source_snapshots/static_bias_transfer_candidate__DERIVATION.md", "Complete parent derivation previously read; unchanged identity verified. This reviewer authored it; not independently revalidated here."),
    (candidate / "source_snapshots/static_bias_transfer_root_review__QUALIFIED_ACCEPTANCE.json", "Complete exact qualified acceptance read for the imported scope; historical reviewer programs/streams not inspected."),
    (candidate / "source_snapshots/static_bias_transfer_root_review__FINAL_QUALIFICATIONS.md", "Complete qualifications read, including computable inputs, target/time order, actual phases and supplier limits."),
    (candidate / "source_snapshots/strongly_regular_bus_root_review__FINAL_QUALIFICATIONS.md", "Complete bus qualifications read; underlying bus author proof previously read/authored, not independently revalidated here."),
    (candidate / "source_snapshots/strongly_regular_bus_root_review__QUALIFIED_ACCEPTANCE.json", "Identity verified from the source manifest; body not separately read in this review. Needed mathematical scope was read from the final qualifications."),
    (candidate / "check_induction.py", "Complete scientific executable read only after initial proof findings were frozen; not executed by this reviewer."),
    (candidate / "run_check.py", "Complete recorder read after the proof findings; source-at-launch/stream hashes checked."),
    (candidate / "AUTHOR_CHECK.md", "Complete evidence description read and compared against actual code/streams."),
    (candidate / "check_run_01/LAUNCH.json", "Complete launch receipt read."),
    (candidate / "check_run_01/EXECUTION.json", "Complete execution receipt read; exit zero; no identical rerun."),
    (candidate / "check_run_01/stdout.json", "Complete stdout read and compared against finite claims."),
    (candidate / "check_run_01/stderr.txt", "Complete empty stderr read."),
    (W / "docs/ai_methodology/skills/physics-claim-reviewer/SKILL.md", "Complete installed text read and verified identical to this selected snapshot; focused applicability assessed."),
    (W / "docs/ai_methodology/skills/SKILL_FRESHNESS_CHECK.md", "Complete source read; no Git/ref refresh authorized in this bounded task."),
    (W / "docs/ai_methodology/skills/physics-loop/references/proof-search-governance.md", "Complete proof-governance source read from the same selected snapshot."),
    (W / "docs/ai_methodology/skills/review-loop/SKILL.md", "Relevant focused-review and boundary sections read through line 145; later operations are outside this task and not imported."),
    (N / "bootstrap/planning/AGENTS.md", "Complete coherent-campaign instruction reading reused; latest inline instructions and bounded task restrictions also apply."),
    (N / "bootstrap/sources/docs/ai_methodology/SCIENCE_WORKFLOW.md", "Complete prior coherent-campaign reading reused, same selected instruction snapshot."),
    (N / "bootstrap/sources/docs/ai_methodology/skills/workhorse/SKILL.md", "Complete prior reading reused; inherited model/effort preserved, no new delegation.")
]
sources = [{**identity(path), "coverage": coverage} for path, coverage in read_sources]
assert identity(Path("/Users/jonreilly/.codex/skills/physics-claim-reviewer/SKILL.md"))["sha256"] == "9d841edd05b9dc4c5145abcfd5352cd45460a1cc57c23c1eabd131590dbb1455"
verify(W / "docs/ai_methodology/skills/physics-claim-reviewer/SKILL.md", "9d841edd05b9dc4c5145abcfd5352cd45460a1cc57c23c1eabd131590dbb1455")
verify(N / "bootstrap/planning/AGENTS.md", "3d409e93abb3b58796a9c10ca6d21ba93b7edc73b8fb24e7364da97c805580a9")
verify(N / "bootstrap/sources/docs/ai_methodology/SCIENCE_WORKFLOW.md", "05f3ec8e58ccd7a4d2a87643fb7ed4f12998c6a1d5721e3632a502de8a0ad6ce")
verify(N / "bootstrap/sources/docs/ai_methodology/skills/workhorse/SKILL.md", "9801055aea637b0e6f765f1558113a9998fe6b4d5a213b0d03d096fe96cb4cdb")
now = datetime.now(timezone.utc).isoformat()
verification = {"verified_utc": now, "kind": "File and receipt integrity only; not a mathematical verdict", "candidate_freeze": frozen, "candidate_members_verified": len(members), "parent_snapshot_original_pairs": parent_snapshots, "reviewer_execution_receipt": identity(receipt_path), "proof_before_code_freeze": identity(base / "PROOF_FINDINGS_FREEZE.json")}
(base / "VERIFICATION.json").write_text(json.dumps(verification, indent=2) + "\n")
manifest = {"created_utc": now, "sources": sources, "exposure": "Source-exposed same-model adversarial reconstruction. Initial proof findings frozen before ancestor/check-code reading. Reviewer authored the reused bus/transfer parents; this is not independent verification of those parents. One new noncommuting-H exact check after code exposure; no candidate executable rerun.", "later_padding_extension_imported": False, "scientific_runs_this_review": 1, "editable_prompt_files_changed": [], "write_boundary": str(base)}
(base / "SOURCE_MANIFEST.json").write_text(json.dumps(manifest, indent=2) + "\n")
review = identity(base / "REVIEW.md")
(base / "CHECKPOINT.md").write_text(f"""# Final review checkpoint

Frozen at {now}. REVIEW.md is {review['bytes']} bytes, SHA256 `{review['sha256']}`.

Verdict: no material mathematical defect found; recommend conditional source acceptance on the specified occupied Hamiltonian-path and positive old-site/edge access domain. No canonical status or retained audit is assigned.

Reconstructed all repeated-gap classes and uncancelled-pole splitting, the essential d=2 exception, complex contour/projector bounds, quartic energy remainder, both complex transition slopes and Cauchy tails, positive blocks/scalar/incident load, exact leading complex Gram coefficient/degree, and finite computable rational selection for arbitrary noncommuting H. Parent target/time order and window/phase accounting remain qualified dependencies.

Initial proof findings were frozen at 2026-10-16T02:11:10.556129+00:00 before candidate check-code reading. The complete candidate check source and evidence were subsequently read; no identical test was rerun. A new exact 2x2 complex noncommuting-H Gram check ran once, exit zero, preserving source-at-launch, full streams and 20/30-second limits. It produced 256(s^2+6s+14)(s^2+2s+3)^2, leading coefficient 256, and rejected the no-adjoint mutant.

Preserve the identity-deletion failed construction and H=-C coefficient-one counterexample. Do not enlarge this into a generic single-port theorem, assume an occupied Hamiltonian path, infer vacant exterior access, or import a later padding extension. State/preparation/timing/calibration/isolation, operational energy, records and reset remain outside this supplier.

All {len(members)} candidate freeze members and seven parent snapshot/original pairs match their pinned identities. The reviewer authored the reused bus/transfer parents and does not claim independent review of them. Only this assigned directory was written. Root owns acceptance/publication; no model override, subagent, Git/PR, canonical, prompt, axiom, cache/graph or lock operation occurred.
""")
own_files = [identity(path) for path in sorted(base.rglob("*")) if path.is_file() and path.name != "REVIEW_FREEZE.json"]
freeze = {"frozen_utc": now, "review": review, "verdict": "No material defect found; recommend conditional mathematical source acceptance on the explicit occupied-path interaction domain", "candidate_derivation_sha256": "54cdf957111f03d6efadd2d6df91a871ea943859dea8639c47343022bfab0d12", "candidate_freeze_sha256": frozen["sha256"], "independence": "Exposed same-model review; no independent claim for reviewer-authored parents", "scientific_runs": 1, "retained_audit": False, "native_realization": False, "padding_extension_imported": False, "files": own_files}
(base / "REVIEW_FREEZE.json").write_text(json.dumps(freeze, indent=2) + "\n")
print(json.dumps({"review": review, "freeze": identity(base / "REVIEW_FREEZE.json"), "frozen_utc": now, "candidate_members_verified": len(members), "review_files_frozen": len(own_files)}, indent=2))
