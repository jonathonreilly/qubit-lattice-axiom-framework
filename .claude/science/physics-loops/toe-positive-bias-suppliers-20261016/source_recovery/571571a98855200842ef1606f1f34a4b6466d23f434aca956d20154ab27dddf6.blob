"""Bounded source-exposed reviewer checks; no author-code imports.
Exact complex Krylov example, four-level rank exclusions, target-ball response
samples, and one rational Taylor-certified post-time logarithm witness.
"""
import json, math
from fractions import Fraction as F
import numpy as np
import sympy as sp
from scipy.linalg import expm
from scipy.optimize import brentq

def emit(row): print(json.dumps(row), flush=True)

l=sp.symbols('lambda',real=True)
X=sp.Matrix([[0,1],[1,0]]);Y=sp.Matrix([[0,-sp.I],[sp.I,0]]);Z=sp.diag(1,-1)
H=sp.Rational(3,10)*X+sp.Rational(1,5)*Z
C=sp.Rational(7,10)*sp.eye(2)+sp.Rational(2,5)*Z
B=X+Y/3+Z/5
A=H+l*C
F1=A*B-B*A;F2=A*F1-F1*A
gram=sp.Matrix([[(u.conjugate().T*v).trace() for v in [F1,F2]] for u in [F1,F2]])
p=sp.factor(gram.det())
h=sp.Matrix([sp.Rational(3,10),0,sp.Rational(1,5)+sp.Rational(2,5)*l])
b=sp.Matrix([1,sp.Rational(1,3),sp.Rational(1,5)])
cross=h.cross(b)
expected=256*(h.dot(h))*(cross.dot(cross))**2
assert sp.simplify(p-expected)==0
assert sp.Poly(p,l).degree()<=6 and p.subs(l,1)>0
emit({'check':'exact_noncommuting_complex_Krylov_polynomial','polynomial':str(p),'degree':sp.Poly(p,l).degree(),'bound':6,'cross_parity_inner':str(sp.simplify(gram[0,1])),'scalar_bias_cancels':bool(F1==(H+l*(C-sp.Rational(7,10)*sp.eye(2)))*B-B*(H+l*(C-sp.Rational(7,10)*sp.eye(2))))})

v=sp.Matrix([1,2,3,4]);Q=sp.eye(4)-2*v*v.T/(v.dot(v))
port=Q.T*sp.diag(1,1,-1,-1)*Q
assert Q.T*Q==sp.eye(4)
assert all(port[a,b]!=0 for a in range(4) for b in range(4) if a!=b)
energies=[0,1,3+2*l,7]
indices=[(a,b) for a in range(4) for b in range(4) if a!=b]
gaps=[sp.sympify(energies[a])-energies[b] for a,b in indices]
vf=sp.prod((gap*port[a,b])**2 for gap,(a,b) in zip(gaps,indices))*sp.prod((gaps[j]-gaps[i])**2 for i in range(12) for j in range(i+1,12))
vf=sp.factor(vf)
rows=[]
for value in [sp.Rational(1),sp.Rational(1,2),sp.Rational(1,16)]:
    K=sp.Matrix([[(gap.subs(l,value))**(j+1)*port[a,b] for j in range(12)] for gap,(a,b) in zip(gaps,indices)])
    direct=(K.T*K).det(method='domain-ge')
    assert direct==vf.subs(l,value)
    rank=K.rank()
    rows.append({'lambda':str(value),'rank':rank,'positive_Gram':bool(direct>0)})
    assert (rank==12)==(value!=sp.Rational(1,2))
zeroport=port.copy();zeroport[0,1]=zeroport[1,0]=0
Kzero=sp.Matrix([[(gap.subs(l,1))**(j+1)*zeroport[a,b] for j in range(12)] for gap,(a,b) in zip(gaps,indices)])
assert Kzero.rank()==10
degree=sp.Poly(vf,l).degree();D=12*13
node=sp.Rational(1,16)/(D+2)
assert vf.subs(l,node)>0
emit({'check':'four_level_exact_Krylov_rank_and_bad_node','n':12,'degree':degree,'degree_bound':D,'rows':rows,'zero_port_pair_rank':Kzero.rank(),'small_D_plus_1_grid_witness':str(node),'physical_port':'conjugate of local Z tensor I by an exact rational orthogonal energy basis','limit':'finite exact instances and factor formula; no full parameter-family enumeration'})

mu=np.array([.75,1.25]);nu=10.;rho=.01;omega=1.;Bnp=np.array([[.4,1.],[1.,-.2]])
def cone(mu):
    energies=np.array([0.,1.]);f=[sum(abs(Bnp[j,a])**2/(energies[a]-energies[j]-mu) for j in range(2)) for a in range(2)]
    return f[1]-f[0]
fp,fm=cone(mu[0]),cone(mu[1]);negative=2*fp
def bus(x):
    weights=np.array([x,negative]);S=sum(weights);p=weights/S
    a=float(p@mu);t=(mu[1]-mu[0])*math.sqrt(p[0]*p[1]);d=float(sum(mu)-a)
    mat=np.diag([a,d,nu,nu,nu,nu]);mat[0,1]=mat[1,0]=t
    for i,j in [(1,2),(2,3),(3,4),(4,5)]:mat[i,j]=mat[j,i]=rho
    return mat,S
def calibration(x):
    mat,S=bus(x);en=[0.,1.];vals=[]
    for a in range(2):
        vals.append(S*sum(abs(Bnp[b,a])**2*np.linalg.inv((en[a]-en[b])*np.eye(6)-mat)[0,0] for b in range(2)))
    return vals[1]-vals[0]
xmin,xmax=4.,10.;Smax=xmax+negative
tmin=(mu[1]-mu[0])*math.sqrt(xmin*negative)/Smax
Dbus=nu+3*rho+omega;gmin=tmin*rho**4/Dbus**6
targetrows=[]
for target in [-8.,-4.,0.,4.,8.]:
    root=brentq(lambda x:calibration(x)-target,xmin,xmax,xtol=1e-13)
    mat,S=bus(root);response=np.linalg.inv(mat-omega*np.eye(6))[0,5]
    residual=abs(calibration(root)-target)
    assert abs(response)>gmin and residual<1e-10
    targetrows.append({'diagonal_target':target,'positive_weight':root,'calibration_residual':residual,'response':response,'response_over_uniform_lower_bound':abs(response)/gmin})
emit({'check':'uniform_target_box_response_and_calibration_samples','dimension':6,'positive_weight_box':[xmin,xmax],'t_min_bound':tmin,'g_min_bound':gmin,'rows':targetrows,'limit':'one-particle samples; no full Q/P gap or contraction certificate inferred'})

# Exact complex-rational 2x2 arithmetic for a posteriori Taylor certification.
zero=(F(0),F(0));one=(F(1),F(0))
def c(real=0,imag=0):return (F(real),F(imag))
def add(a,b):return (a[0]+b[0],a[1]+b[1])
def neg(a):return (-a[0],-a[1])
def mul(a,b):return (a[0]*b[0]-a[1]*b[1],a[0]*b[1]+a[1]*b[0])
def conj(a):return (a[0],-a[1])
def madd(A,B):return [[add(A[i][j],B[i][j]) for j in range(2)] for i in range(2)]
def mscale(A,z):return [[mul(A[i][j],z) for j in range(2)] for i in range(2)]
def mmul(A,B):return [[add(mul(A[i][0],B[0][j]),mul(A[i][1],B[1][j])) for j in range(2)] for i in range(2)]
def adj(A):return [[conj(A[j][i]) for j in range(2)] for i in range(2)]
Id=[[one,zero],[zero,one]]
def asnp(A):return np.array([[float(z[0])+1j*float(z[1]) for z in row] for row in A])
def exp_cert(K):
    assert K==adj(K)
    bound=max(sum(abs(z[0])+abs(z[1]) for z in row) for row in K)
    k=0
    while bound/(2**k)>F(1,2):k+=1
    a=bound/(2**k);A=mscale(K,c(0,-F(1,2**k)))
    term=Id;P=Id
    order=20
    for j in range(1,order+1):
        term=mscale(mmul(term,A),c(F(1,j)));P=madd(P,term)
    small_error=2*a**(order+1)/math.factorial(order+1)
    assert (2**k)*small_error<F(1,2)
    error=(2**(k+1))*small_error
    for _ in range(k):P=mmul(P,P)
    return P,error,k

Hq=[[c(F(1,5)),c(F(3,10))],[c(F(3,10)),c(-F(1,5))]]
Cq=[[c(F(11,10)),zero],[zero,c(F(3,10))]]
lam=F(1,5);T=F(23)
Hlam=madd(Hq,mscale(Cq,c(lam)))
W=[[c(F(3,5)),c(0,F(4,5))],[c(0,F(4,5)),c(F(3,5))]]
assert mmul(adj(W),W)==Id
U=expm(1j*float(T)*asnp(Hlam))@asnp(W)@expm(-1j*float(T)*asnp(Hq))
eta=F(1,4);candidate=None;tested=0
for den in [1,2,4,8]:
    vals=np.arange(-4*den+1,4*den)/den
    xx,yy=np.meshgrid(vals,vals,indexing='ij');xs=xx.ravel();ys=yy.ravel()
    for aa in vals:
        for dd in vals:
            center=(aa+dd)/2;zz=(aa-dd)/2;rr=np.sqrt(zz*zz+xs*xs+ys*ys)
            valid=np.maximum(abs(center+rr),abs(center-rr))<3.999
            sinc=np.sinc(rr/np.pi);pref=np.exp(-1j*center)
            pa=pref*(np.cos(rr)-1j*sinc*zz);pd=pref*(np.cos(rr)+1j*sinc*zz)
            pb=pref*(-1j*sinc*(xs+1j*ys));pc=pref*(-1j*sinc*(xs-1j*ys))
            errors=abs(pa-U[0,0])**2+abs(pb-U[0,1])**2+abs(pc-U[1,0])**2+abs(pd-U[1,1])**2
            tested+=len(xs)
            good=np.where(valid & (errors<(float(eta)*.8)**2))[0]
            if len(good):
                j=good[0];candidate=(F(round(aa*den),den),F(round(dd*den),den),F(round(xs[j]*den),den),F(round(ys[j]*den),den));break
        if candidate is not None:break
    if candidate is not None:break
assert candidate is not None, 'bounded witness search exhausted; retain this failure if reached'
aa,dd,xx,yy=candidate
M=[[c(aa),c(xx,yy)],[c(xx,-yy),c(dd)]]
for sign in [-1,1]:
    assert 4+sign*aa>0
    assert (4+sign*aa)*(4+sign*dd)-xx*xx-yy*yy>0
PA,eA,kA=exp_cert(mscale(Hlam,c(-T)))
PB,eB,kB=exp_cert(mscale(Hq,c(T)))
PM,eM,kM=exp_cert(M)
PU=mmul(mmul(PA,W),PB);eU=eA+eB+eA*eB
difference=madd(PM,mscale(PU,c(-1)))
frob2=sum(z[0]**2+z[1]**2 for row in difference for z in row)
margin=eta-eM-eU
assert margin>0 and frob2<margin*margin
emit({'check':'post_time_rational_log_witness_with_exact_certificate','T':str(T),'lambda':str(lam),'lambda_T':str(lam*T),'eta':str(eta),'candidate_entries':[str(x) for x in candidate],'enumerated_numeric_candidates':tested,'norm_less_than_4_exact_Sylvester_tests':True,'Taylor_order':20,'Taylor_scaling_exponents':[kA,kB,kM],'exact_Frobenius_error_approx':math.sqrt(float(frob2)),'exponential_certificate_error_upper':float(eM+eU),'exact_rational_strict_error_test':True,'limit':'one bounded rational witness; numeric screening followed by exact rational certification; no all-accuracy controller execution'})

# Complete scalar ordering and fixed-window bias discriminator, using this T.
cC=F(7,10);reserve=1.23;cM=-.41;xi2=1/float(T)
phase_rows=[]
for s in [0.,.31,.7]:
    t=float(T)+s
    actual=np.exp(-1j*(reserve*t+cM*xi2*t))*expm(-1j*t*asnp(Hlam))@expm(-1j*(1+xi2*s)*asnp(M))
    comparator=np.exp(-1j*(reserve*t+cM*xi2*t+float(lam*cC)*s))*expm(-1j*s*asnp(Hq))@asnp(W)@expm(-1j*float(T)*asnp(Hq))
    error=np.linalg.norm(actual-comparator,2)
    bound=float(eta)+xi2*s*4+float(lam)*s*.4
    assert error<=bound+1e-12
    wrong=np.exp(-1j*float(lam*cC)*float(T))*comparator
    phase_rows.append({'s':s,'error':error,'bound':bound,'extra_scalar_lambda_c_T_mutant_error':float(np.linalg.norm(actual-wrong,2))})
emit({'check':'complete_phase_order_with_log_and_bias_budget','rows':phase_rows,'no_lambda_T_smallness':True,'scope':'finite old-space algebra; full controller factors inherited analytically'})
