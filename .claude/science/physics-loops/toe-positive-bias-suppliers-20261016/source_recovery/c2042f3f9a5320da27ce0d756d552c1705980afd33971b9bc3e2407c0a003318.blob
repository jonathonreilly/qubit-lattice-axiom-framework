"""Record the actual bounded scientific execution without overwriting evidence."""
import datetime,hashlib,json,subprocess,sys
from pathlib import Path
root=Path(__file__).resolve().parent
src=root/'finite_check.py';launch=root/'finite_check.at_launch.py'
if launch.exists():raise RuntimeError('Refuse to overwrite scientific launch source')
data=src.read_bytes();launch.write_bytes(data)
command=[sys.executable,str(launch)]
receipt=dict(start_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),command=command,cwd=str(root),source_sha256=hashlib.sha256(data).hexdigest(),source_bytes=len(data),timeout_seconds=30,max_matrix_dimension=2,scientific_role='bounded author algebra only',launcher_sha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest())
(root/'CHECK_LAUNCH.json').write_text(json.dumps(receipt,indent=2)+'\n')
with (root/'finite_check.stdout.log').open('w') as out,(root/'finite_check.stderr.log').open('w') as err:
    try:
        p=subprocess.run(command,cwd=root,stdout=out,stderr=err,timeout=30,check=False)
        result=dict(returncode=p.returncode,timed_out=False)
    except subprocess.TimeoutExpired:result=dict(returncode=None,timed_out=True)
result['finished_utc']=datetime.datetime.now(datetime.timezone.utc).isoformat()
(root/'CHECK_RESULT.json').write_text(json.dumps(result,indent=2)+'\n')
print(json.dumps(result))
sys.exit(0 if result['returncode']==0 else 1)
