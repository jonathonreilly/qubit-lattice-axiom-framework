import hashlib
import json
import sys
from datetime import datetime, timezone
from pathlib import Path

out = Path(sys.argv[1]).resolve()
name = sys.argv[2]
assert name in ("SCIENCE_SOURCE_FREEZE.json", "FREEZE.json")
members = []
if name == "SCIENCE_SOURCE_FREEZE.json":
    paths = [out / "enclose_chart.py", out / "record.py", out / "PRELAUNCH.md",
             out / "INPUT_FREEZE.json", out / "INPUT_MANIFEST.json"] + sorted((out / "inputs").iterdir())
else:
    paths = sorted(p for p in out.rglob("*") if p.is_file()
                   and p.name != "FREEZE.json" and "final_freeze" not in p.parts)
for p in paths:
    b = p.read_bytes()
    members.append({"path": str(p.relative_to(out)), "bytes": len(b), "sha256": hashlib.sha256(b).hexdigest()})
obj = {"kind": "pre-execution source freeze" if name.startswith("SCIENCE") else "candidate final freeze",
       "created_utc": datetime.now(timezone.utc).isoformat(), "members": members,
       "self_hash_excluded": True, "final_freeze_recorder_outside_member_list": name == "FREEZE.json"}
dest = out / name
assert not dest.exists()
dest.write_text(json.dumps(obj, indent=2) + "\n")
b = dest.read_bytes()
print(json.dumps({"path": str(dest), "members": len(members), "bytes": len(b),
                  "sha256": hashlib.sha256(b).hexdigest()}, indent=2))
