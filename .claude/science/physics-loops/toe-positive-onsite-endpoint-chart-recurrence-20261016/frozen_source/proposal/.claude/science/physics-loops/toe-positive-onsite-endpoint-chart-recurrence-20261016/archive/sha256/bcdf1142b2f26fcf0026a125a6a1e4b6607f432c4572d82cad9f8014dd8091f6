from pathlib import Path
from datetime import datetime,timezone
import hashlib,json,sys
out=Path(sys.argv[1]).resolve();parent=out.parent/'endpoint_chart_certificate_candidate'
def pin(p):
 b=p.read_bytes();return {'path':str(p),'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
assert pin(parent/'FREEZE.json')['sha256']=='485d29b8c62083a9d3754a1245ef65889f46cf343f6e76557bfadfe8fe6c37cf'
for row in json.loads((parent/'FREEZE.json').read_text())['members']:
 x=pin(parent/row['path']);assert x['bytes']==row['bytes'] and x['sha256']==row['sha256']
specs=[('PARENT_DERIVATION.md','DERIVATION.md','b1ee702a4ef20ff2722b7271443058e3b71b865a7d7d7d17038d124ccf9c51ef'),
 ('PARENT_FREEZE.json','FREEZE.json','485d29b8c62083a9d3754a1245ef65889f46cf343f6e76557bfadfe8fe6c37cf'),
 ('SELECTED_INPUT.json','inputs/SELECTED_INPUT.json','c708c0ad2b6aafb9da9c309c53c0d7847b05540386ba679ec4ec288cc1de1f80'),
 ('PARENT_CERTIFICATE.json','enclosure_001_output/certificate.json','d4df628f9a021ee7adb9b289df51161adae6bdc6aa793f8692240528deb48509'),
 ('PARENT_ENCLOSURE_SOURCE.py','enclose_chart.py','af32cd53c37df6d21c9dfc75fc0abc6d6f4477aa20322efbd7f55a34315232d9')]
(out/'inputs').mkdir(exist_ok=False);rows=[]
for name,rel,h in specs:
 p=parent/rel;assert pin(p)['sha256']==h
 d=out/'inputs'/name;d.write_bytes(p.read_bytes());rows.append({'original':pin(p),'capture':pin(d)})
import mpmath
manifest={'created_utc':datetime.now(timezone.utc).isoformat(),'sources':rows,
 'coverage':'Parent complete derivation and source previously authored/read; exact frozen identities and all 45 members refreshed, no execution replay.',
 'parent_status':'Provisional chart premise; separate checking/acceptance pending at dispatch.',
 'mpmath_version':mpmath.__version__,'mpmath_location':mpmath.__file__,
 'mpmath_scope':'Heuristic eigenphase proposal only; never accepted as interval evidence.',
 'new_science_runs_before_this_capture':0}
(out/'INPUT_MANIFEST.json').write_text(json.dumps(manifest,indent=2)+'\n')
print(json.dumps(manifest,indent=2))
