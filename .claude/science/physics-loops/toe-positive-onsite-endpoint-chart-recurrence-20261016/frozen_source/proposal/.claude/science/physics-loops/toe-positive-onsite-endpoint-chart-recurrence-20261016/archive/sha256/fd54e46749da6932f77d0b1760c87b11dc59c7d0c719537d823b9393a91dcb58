from pathlib import Path
from datetime import datetime, timezone
import ast, hashlib, json, shutil
O = Path.cwd()
assert O.name == 'endpoint_chart_exposed_check'
N = O.parent

def pin(p):
    b = p.read_bytes()
    return dict(path=str(p), bytes=len(b), sha256=hashlib.sha256(b).hexdigest())

def read(p):
    return json.loads(p.read_text())

def check(p, row):
    got = pin(p)
    assert got['bytes'] == row['bytes'] and got['sha256'] == row['sha256'], str(p)

def write(p, obj):
    assert not p.exists()
    p.write_text(json.dumps(obj, indent=2, sort_keys=True) + '\n')

assert pin(O/'PRE_ENCLOSURE_FREEZE.json')['sha256'] == 'bd6e3042dce21422bd2d3c8d387c7b36ebb58f4f788146802973332239eacd05'
for row in read(O/'PRE_ENCLOSURE_FREEZE.json')['members']:
    check(Path(row['path']), row)
