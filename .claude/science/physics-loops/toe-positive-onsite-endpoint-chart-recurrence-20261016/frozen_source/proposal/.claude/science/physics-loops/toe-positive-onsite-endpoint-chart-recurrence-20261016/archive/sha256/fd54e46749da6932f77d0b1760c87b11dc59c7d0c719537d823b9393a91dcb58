# Complete deterministic function-source map; this is parsing, not executing candidate code.
programs = ['enclose_chart.py','capture_inputs.py','record.py','metadata_freeze.py','validate_metadata.py']
functions = []
for rel in programs:
    p = C/rel
    text = p.read_text()
    parsed = ast.parse(text)
    for node in ast.walk(parsed):
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            segment = ast.get_source_segment(text, node)
            functions.append(dict(file=rel,name=node.name,start_line=node.lineno,end_line=node.end_lineno,
                                  source_sha256=hashlib.sha256(segment.encode()).hexdigest(),
                                  ast_sha256=hashlib.sha256(ast.dump(node,include_attributes=False).encode()).hexdigest()))
functions.sort(key=lambda x:(x['file'],x['start_line']))
write(O/'CODE_FUNCTION_MAP.json',dict(files=[pin(C/p) for p in programs],functions=functions,
                                  coverage='Complete source read; function inventory is navigational, not proof.'))
