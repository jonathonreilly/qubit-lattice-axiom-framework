"""Metadata-only bounded source capture; no mathematical solver is invoked."""
from pathlib import Path
import datetime, hashlib, json, shutil, sys

out = Path(sys.argv[1]).resolve()
root = out.parent
assert out.name == 'endpoint_target_compilation_candidate'
specs = [
 ('endpoint_target_compilation_proposal/PROPOSAL.md', '9aa1028a51efa1acf5851a5537d07f4b96768f6addc87d003be233d698cbf47f', 'sources/target_proposal.md', 'Complete proposed derivation reread; fixed attempt specification.'),
 ('endpoint_target_compilation_proposal/CURRENT_STATUS.md', 'a8a9452cabe58e6aa54880c1a21e2fb1e8df4bb222631923400cd19bfa384f82', 'sources/target_proposal_status.md', 'Historical additive status; current root qualifications below control.'),
 ('endpoint_target_compilation_proposal/FREEZE.json', 'c356704d9703b904461c162e72dc50a449b2c7cd8a7f5e07bf0ad8f7d09048f3', 'sources/target_proposal_freeze.json', 'Metadata identity, not science replay.'),
 ('endpoint_chart_root_proposal/PROPOSED_LEMMAS.md', '3d426ff7327fca150a712329dc23f59897893278665c82ecfa436e446b359169', 'sources/chart_root_proposal.md', 'Complete argument already read; retained at same identity.'),
 ('endpoint_chart_certificate_candidate/DERIVATION.md', 'b1ee702a4ef20ff2722b7271443058e3b71b865a7d7d7d17038d124ccf9c51ef', 'sources/chart_derivation.md', 'Authored/read complete parent; source-exposed reuse, not fresh independent validation.'),
 ('endpoint_chart_certificate_candidate/FREEZE.json', '485d29b8c62083a9d3754a1245ef65889f46cf343f6e76557bfadfe8fe6c37cf', 'sources/chart_freeze.json', 'Metadata identity.'),
 ('endpoint_chart_certificate_candidate/inputs/SELECTED_INPUT.json', 'c708c0ad2b6aafb9da9c309c53c0d7847b05540386ba679ec4ec288cc1de1f80', 'inputs/SELECTED_INPUT.json', 'Complete exact nominal amplitudes, selected coordinates and rational inverse.'),
 ('endpoint_chart_certificate_candidate/enclosure_001_output/certificate.json', 'd4df628f9a021ee7adb9b289df51161adae6bdc6aa793f8692240528deb48509', 'inputs/CHART_CERTIFICATE.json', 'Saved strengthened residual used; no Jacobian recomputation.'),
 ('endpoint_chart_root_review/ACCEPTANCE.json', '112ecd184bf4e0fbb76814c73bffe0fa911b35ba808825e09bb574c790f6faf7', 'sources/chart_acceptance.json', 'Root source qualification read in prior continuation.'),
 ('endpoint_chart_root_review/FINAL_QUALIFICATIONS.md', '6cf3c69fa21a34985fbe1dba646e0512693e65729b373c9d8cfe380e10048f86', 'sources/chart_qualifications.md', 'Complete controlling qualifications reread.'),
 ('endpoint_chart_root_review/FREEZE.json', 'd2c3cce2cde80aad2b105ead8a12671bdc8682d90fdc774fe0737e6390aae223', 'sources/chart_review_freeze.json', 'Metadata identity.'),
 ('endpoint_recurrence_candidate/DERIVATION.md', '5ff51f7b8079804435f8d1d4e7eb258cbc77d6941948a1ec9c140e9e85d5688a', 'sources/recurrence_derivation.md', 'Authored/read complete parent; relevant tail/power argument reread.'),
 ('endpoint_recurrence_candidate/certify_recurrence.py', 'c62b5b6c7c9d81dbcbe01511bbc7be7be1ede9eb77eef2b753e5d86a68ae7771', 'sources/recurrence_program.py', 'Complete source reread; U-only interval routines adapted, not executed.'),
 ('endpoint_recurrence_candidate/FREEZE.json', '33f7d3b47e70451af22e3d8058b92b948833ecee4e25f30f746be794d24e1e9c', 'sources/recurrence_freeze.json', 'Metadata identity.'),
 ('endpoint_recurrence_candidate/recurrence_001_output/ENDPOINT_ENCLOSURE.json', '454d338285d0bf91c51b50ddbc23e2b3dc21732e3092ace5b1ed2aaea76878de', 'inputs/NOMINAL_ENDPOINT.json', 'Saved N320/S768 endpoint and all slots; no nominal reintegration.'),
