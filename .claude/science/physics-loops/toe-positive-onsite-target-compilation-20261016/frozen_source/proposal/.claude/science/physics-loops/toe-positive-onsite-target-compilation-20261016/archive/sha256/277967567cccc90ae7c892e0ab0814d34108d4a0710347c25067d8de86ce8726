 ('endpoint_recurrence_root_review/ACCEPTANCE.json', '36e72537f8d2546bc15c9baf69dd526fb22d854bafc36d07a020a7225c73465e', 'sources/recurrence_acceptance.json', 'Complete root source qualification read before freeze.'),
 ('endpoint_recurrence_root_review/FINAL_QUALIFICATIONS.md', '69af491dcc68b0bb96eae71e3b0bef44a9d78a7380d0d388ccc2f233c5db6d55', 'sources/recurrence_qualifications.md', 'Complete controlling qualifications read before freeze.'),
 ('endpoint_recurrence_root_review/FREEZE.json', '7e4268b5', 'sources/recurrence_review_freeze.json', 'Prefix supplied by root; full identity captured, plus exact members checked below.'),
]
members = []
for relative, expected, destination, coverage in specs:
    source = root / relative
    raw = source.read_bytes()
    actual = hashlib.sha256(raw).hexdigest()
    assert actual.startswith(expected), (relative, expected, actual)
    target = out / destination
    target.parent.mkdir(parents=True, exist_ok=True)
    assert not target.exists()
    target.write_bytes(raw)
    members.append({'source': str(source), 'copy': destination, 'bytes': len(raw),
                    'sha256': actual, 'coverage': coverage})
for name in ('chart_review_freeze.json', 'recurrence_review_freeze.json'):
    data = json.loads((out / 'sources' / name).read_text())
    source_dir = root / ('endpoint_chart_root_review' if name.startswith('chart') else 'endpoint_recurrence_root_review')
    for member in data['members']:
        raw = (source_dir / member['path']).read_bytes()
        assert len(raw) == member['bytes'] and hashlib.sha256(raw).hexdigest() == member['sha256']
manifest = {'utc': datetime.datetime.now(datetime.timezone.utc).isoformat(),
            'purpose': 'Source-only candidate; parent science reused, not rerun.',
            'source_exposure': 'Same author/model as chart, recurrence and plan; no independent-validation claim.',
            'members': members, 'canonical_binding': None, 'publication': None,
            'new_scientific_runs_at_capture': 0, 'editable_prompt_files_changed': []}
(out / 'SOURCE_MANIFEST.json').write_text(json.dumps(manifest, indent=2) + '\n')
print(json.dumps({'status': 'SOURCE_CAPTURE_COMPLETE', 'members': len(members),
                  'source_manifest_sha256': hashlib.sha256((out / 'SOURCE_MANIFEST.json').read_bytes()).hexdigest()}))
