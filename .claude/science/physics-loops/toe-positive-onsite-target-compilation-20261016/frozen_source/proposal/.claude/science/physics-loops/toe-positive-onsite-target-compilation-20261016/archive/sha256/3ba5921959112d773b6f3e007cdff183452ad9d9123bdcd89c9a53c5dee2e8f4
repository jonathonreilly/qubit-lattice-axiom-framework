"""Metadata-only binding and source/receipt capture after the explicit root GO."""
from pathlib import Path
from datetime import datetime, timezone
import hashlib
import json
import shutil

P=Path(__file__).resolve().parent
A=P.parents[1]/'endpoint_target_compilation_candidate'

def pin(path):
    raw=Path(path).read_bytes()
    return {'path':str(path),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest()}

assert not (P/'INPUT_BINDING.json').exists()
freeze=pin(A/'FREEZE.json')
receipt=pin(A/'runs/target_001/EXECUTION.json')
assert (freeze['bytes'],freeze['sha256'])==(22438,'0f61e1040c491541eb24e4f94396d805c1b6a251202485c276570af1491d31fc')
assert (receipt['bytes'],receipt['sha256'])==(2777,'4b8f622e076acee771ebd466c96fda8f6fba3b37196dbe45296f86ff3e83bb1a')
manifest=json.loads((A/'FREEZE.json').read_text())
assert len(manifest['members'])==132
for row in manifest['members']:
    path=A/row['path'];assert path.resolve().is_relative_to(A.resolve())
    actual=pin(path);assert all(actual[k]==row[k] for k in ['bytes','sha256'])
binding={'status':'bound_immutable_author_evidence','author_bundle_root':str(A),'author_final_freeze':freeze,'freeze_member_key':'members','author_execution':receipt}
(P/'INPUT_BINDING.json').write_text(json.dumps(binding,indent=2)+'\n')
paths=['FREEZE.json','runs/target_001/EXECUTION.json','runs/target_001/LAUNCH.json','runs/target_001/source_at_launch.py','runs/target_001/recorder_at_launch.py','runs/target_001/stdout','runs/target_001/stderr']
captures=[]
for name in paths:
    source=A/name;target=P/'captured_author'/name;target.parent.mkdir(parents=True,exist_ok=True)
    shutil.copyfile(source,target);assert pin(source)['sha256']==pin(target)['sha256']
    captures.append({'original':pin(source),'captured':pin(target)})
result={'kind':'metadata_only_input_binding','utc':datetime.now(timezone.utc).isoformat(),'source_at_execution':pin(Path(__file__).resolve()),'members_verified':132,'binding':pin(P/'INPUT_BINDING.json'),'captures':captures,'scientific_execution':False,'authorization':'Explicit parent GO received after complete source review for exactly one unchanged 180-second saved-arithmetic run; no retry.'}
(P/'BINDING_PROVENANCE.json').write_text(json.dumps(result,indent=2)+'\n')
print(json.dumps(result,indent=2))
