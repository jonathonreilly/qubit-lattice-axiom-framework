"""Metadata-only syntax/source freeze. Does not import the science program."""
from pathlib import Path
import ast, datetime, hashlib, json, sys

out = Path(sys.argv[1]).resolve()
assert out.name == 'endpoint_target_compilation_candidate'
assert not (out/'PRELAUNCH_FREEZE.json').exists()
for name in ('compile_target.py','record.py','capture_inputs.py','freeze_prelaunch.py'):
    ast.parse((out/name).read_text(), filename=name)
members = []
for path in sorted(out.rglob('*')):
    if not path.is_file() or path == out/'PRELAUNCH_FREEZE.json':
        continue
    # The current metadata receipt is not yet complete; close it separately.
    if 'runs/prelaunch_freeze/' in str(path.relative_to(out)):
        continue
    raw = path.read_bytes()
    members.append({'path': str(path.relative_to(out)), 'bytes': len(raw),
                    'sha256': hashlib.sha256(raw).hexdigest()})
freeze = {'utc': datetime.datetime.now(datetime.timezone.utc).isoformat(),
          'status': 'SOURCE_AND_INPUTS_FROZEN_AWAITING_ROOT_GO',
          'scientific_runs': 0, 'syntax_only_no_program_import': True,
          'members': members, 'terminal_metadata_receipt_outside_freeze': 'runs/prelaunch_freeze/EXECUTION.json',
          'canonical_binding': None, 'publication': None}
path = out/'PRELAUNCH_FREEZE.json'
path.write_text(json.dumps(freeze, indent=2)+'\n')
print(json.dumps({'freeze_bytes': path.stat().st_size,
                  'freeze_sha256': hashlib.sha256(path.read_bytes()).hexdigest(),
                  'source_sha256': hashlib.sha256((out/'compile_target.py').read_bytes()).hexdigest(),
                  'members': len(members), 'science_launched': False}, indent=2))
