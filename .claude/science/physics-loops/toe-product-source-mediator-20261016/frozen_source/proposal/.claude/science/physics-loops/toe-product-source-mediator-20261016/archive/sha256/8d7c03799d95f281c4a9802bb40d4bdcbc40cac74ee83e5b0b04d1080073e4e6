"""Record one actual metadata-only inspection, including source-at-launch."""
from pathlib import Path
import datetime
import hashlib
import json
import subprocess
import sys
import time

root = Path(__file__).resolve().parent
run = root / "metadata"
run.mkdir(exist_ok=False)
source = root / "inspect_sources.py"
captured = source.read_bytes()
(run / "executed_source.py").write_bytes(captured)
launcher = Path(__file__).read_bytes()
(run / "launcher_source.py").write_bytes(launcher)
argv = [sys.executable, "-B", str(source)]
started = datetime.datetime.now(datetime.timezone.utc).isoformat()
tick = time.monotonic()
with (run / "stdout").open("wb") as out, (run / "stderr").open("wb") as err:
    proc = subprocess.run(argv, cwd=root, stdout=out, stderr=err, timeout=30)
receipt = {"scope": "metadata only; no scientific execution", "argv": argv, "cwd": str(root), "started_at": started, "finished_at": datetime.datetime.now(datetime.timezone.utc).isoformat(), "elapsed_seconds": time.monotonic()-tick, "exit_code": proc.returncode, "timeout_seconds": 30, "timed_out": False, "source_sha256": hashlib.sha256(captured).hexdigest(), "launcher_sha256": hashlib.sha256(launcher).hexdigest(), "source_unchanged_during_run": source.read_bytes() == captured, "scientific_executions": 0}
(run / "EXECUTION.json").write_text(json.dumps(receipt, indent=2) + "\n")
print(json.dumps(receipt, indent=2))
raise SystemExit(proc.returncode)
