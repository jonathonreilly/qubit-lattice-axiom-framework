"""Exact text/source comparisons only; no scientific execution."""
from pathlib import Path
from datetime import datetime, timezone
import difflib
import hashlib
import json
import os
import re

D=Path(__file__).resolve().parent
N=D.parent
C=N/'polynomial_joint_readiness_correction'
R=N/'polynomial_joint_readiness_decisive_check'
O=N/'polynomial_joint_readiness_root_candidate'

def utc(): return datetime.now(timezone.utc).isoformat()
def ident(p):
    b=p.read_bytes()
    return {'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
def save(name,obj):
    (D/name).write_text(json.dumps(obj,indent=2)+'\n')

started=utc()
save('METADATA_LAUNCH.json',{'kind':'contemporaneous metadata-only launch',
     'utc':started,'pid':os.getpid(),'program':ident(Path(__file__)),
     'scope':'Exact text replacement/diff, identity, displayed-text and freeze-member comparisons. No physical calculation or historical scientific replay.'})

expected={
 C/'DERIVATION.md':(10500,'b083c9d942d589ef927c868fc89720bd16e91051f0e29b20ef6404d85eb8d5a2'),
 C/'CORRECTION.diff':(7782,'465e95c3312a2e993888ed66b7a5b8f16abb391885d52687e4456df127d3955c'),
 C/'FINAL_FREEZE.json':(None,'ff8cf33e30c43fed1b976a22b985189110fb9ac3524cd0e8359b50e56e1497ea'),
 O/'DERIVATION.md':(9213,'b34df6b7479df5b3960b02bf383ff7954621a10b1efb6831a25c65466d8da783'),
 R/'REPORT.md':(25745,'aab0856d58f58dca9ec51afd1b792c2eb792d37f8666491d4ac2bc2fb065d512'),
 R/'FINAL_FREEZE.json':(3188,'99f418f191eb26bb1cc9bd2b63a32457f0a6b5b07964b30997b812b91016374e'),
}
# The correction seal's caller-supplied hash is exact; its size is measured.
for p,(size,h) in expected.items():
    actual=ident(p)
    assert actual['sha256']==h and (size is None or actual['bytes']==size),str(p)

manifest=json.loads((C/'SOURCE_MANIFEST.json').read_text())
source_rows=[]
paths=set(expected)|{C/'SCOPE.md',C/'SOURCE_MANIFEST.json'}
for item in manifest['sources']:
    p=Path(item['path'])
    assert ident(p)=={'bytes':item['bytes'],'sha256':item['sha256']},str(p)
    paths.add(p)
for p in sorted(paths):
    relative=Path('sources')/p.relative_to(N)
    target=D/relative
    target.parent.mkdir(parents=True,exist_ok=True)
    target.write_bytes(p.read_bytes())
    source_rows.append({'original':str(p),'copy':str(relative),**ident(p)})
save('SOURCE_MANIFEST.json',{'utc':utc(),'sources':source_rows,
     'exposure':'Same author as frozen resource check and joint-preparation source; correction binding only, no fresh independence claim.',
     'scientific_executions':0})

old=(O/'DERIVATION.md').read_text()
new=(C/'DERIVATION.md').read_text()
replacements=manifest['exact_replacements']
assert len(replacements)==5
transformed=old
replacement_rows=[]
for before,after in replacements.items():
    assert transformed.count(before)==1
    transformed=transformed.replace(before,after,1)
    replacement_rows.append({'old_text_sha256':hashlib.sha256(before.encode()).hexdigest(),
                             'new_text_sha256':hashlib.sha256(after.encode()).hexdigest(),
                             'old_occurrences':1})
assert transformed==new
exact_diff=''.join(difflib.unified_diff(old.splitlines(True),new.splitlines(True),
 fromfile='frozen_b34df6b7/DERIVATION.md',tofile='corrected/DERIVATION.md'))
assert exact_diff==(C/'CORRECTION.diff').read_text()
old_blocks=re.findall(r'(?m)(?:^ {4}.*\n)+',old)
new_blocks=re.findall(r'(?m)(?:^ {4}.*\n)+',new)
assert len(old_blocks)==4 and old_blocks==new_blocks
old_powers=re.findall(r'O\([^)]*\)',old)
new_powers=re.findall(r'O\([^)]*\)',new)
assert old_powers==new_powers

freeze_checks=[]
for freeze in [C/'FINAL_FREEZE.json',R/'FINAL_FREEZE.json']:
    data=json.loads(freeze.read_text())
    members=[]
    for row in data['files']:
        p=Path(row['path'])
        if not p.is_absolute(): p=freeze.parent/p
        assert ident(p)=={'bytes':row['bytes'],'sha256':row['sha256']},str(p)
        members.append(str(p))
    freeze_checks.append({'freeze':str(freeze),**ident(freeze),
                          'verified_member_count':len(members),'members':members})

save('BINDING_RESULT.json',{'kind':'actual metadata-only comparison result',
     'started_utc':started,'comparison_completed_utc':utc(),'pid':os.getpid(),
     'exact_five_replacements':True,'replacement_identities':replacement_rows,
     'unified_diff_byte_exact':True,'unchanged_displayed_blocks':len(old_blocks),
     'unchanged_big_O_texts':old_powers,'source_identities_checked':len(source_rows),
     'original_freeze_members_verified':freeze_checks,'scientific_executions':0,
     'process_exit_status':'Reported by the tool after process exit; not fabricated inside the running process.'})
print(json.dumps({'exact_replacements':5,'exact_diff':True,
 'unchanged_equation_blocks':len(old_blocks),'unchanged_big_O_text_count':len(old_powers),
 'source_identities':len(source_rows),'freeze_members':[x['verified_member_count'] for x in freeze_checks],
 'scientific_executions':0},indent=2))
