"""Metadata-only final seal. Successful tool exit confirms completion."""
from pathlib import Path
from datetime import datetime, timezone
import hashlib, json, sys

OUT = Path(__file__).resolve().parent
def stamp(): return datetime.now(timezone.utc).isoformat()
def pin(path):
    raw = Path(path).read_bytes()
    return {'path': str(path), 'bytes': len(raw), 'sha256': hashlib.sha256(raw).hexdigest()}
def same(path, expected):
    actual = pin(path)
    assert actual['bytes'] == expected['bytes'] and actual['sha256'] == expected['sha256'], str(path)
def read(path): return json.loads(Path(path).read_text())
def write(path, value): path.write_text(json.dumps(value, indent=2) + '\n')
assert not (OUT / 'FINAL_FREEZE.json').exists()
started = stamp()
fresh = read(OUT / 'FINAL_SOURCE_RECHECK.json')
for row in fresh['sources']:
    same(row['path'], row)
    if row['recovery_copy']: same(OUT / row['recovery_copy'], row)
same(OUT / 'REPORT.md', fresh['report'])
same(OUT / 'READ_COVERAGE.md', fresh['reading_coverage'])
receipts = []
for label in ('capture', 'final'):
    folder = OUT / 'metadata_runs' / label
    launch, receipt = read(folder / 'LAUNCH.json'), read(folder / 'EXECUTION.json')
    assert receipt['returncode'] == 0 and launch['scientific_execution'] is False
    same(folder / 'LAUNCH.json', receipt['launch'])
    same(folder / 'child_source.py', launch['source_at_launch'])
    same(folder / 'recorder_source.py', launch['recorder_at_launch'])
    for output in receipt['outputs']: same(output['path'], output)
    receipts.append({'label': label, 'launch': pin(folder / 'LAUNCH.json'), 'receipt': pin(folder / 'EXECUTION.json')})
write(OUT / 'SEAL_RECEIPT.json', {'started_utc': started, 'preseal_completed_utc': stamp(),
    'command': [sys.executable, '-B', str(Path(__file__).resolve())], 'source_at_launch': pin(__file__),
    'actual_metadata_receipts_checked': receipts,
    'scope': 'In-process source/freshness/preseal record; final completion confirmed by successful tool exit. No independent launcher or scientific execution claimed.',
    'scientific_programs_run': 0, 'historical_scientific_replays': 0})
write(OUT / 'HANDOFF.json', {'status': 'bounded separate analytic check complete; no audit verdict',
    'report': pin(OUT / 'REPORT.md'), 'coverage': pin(OUT / 'READ_COVERAGE.md'),
    'source_manifest': pin(OUT / 'SOURCE_MANIFEST.json'), 'freshness': pin(OUT / 'FINAL_SOURCE_RECHECK.json'),
    'disposition': 'No blocking mathematical defect found under the complete stated supplied-resource and actual-baseline hypotheses; see report for exact limits and preserved failure witnesses.',
    'candidate_unchanged': True, 'scientific_programs_run': 0, 'historical_scientific_replays': 0,
    'computational_diagnostic_predeclared': False, 'model_or_effort_override': False,
    'delegation': False, 'editable_prompt_files_changed': [],
    'independence_limits': 'Root-authored source exposed; same-model/family, prior mass/geometry reviewer involvement; separate analytic derivations, no blind/model-diverse/experimental or audit independence.'})
rows = [{**pin(path), 'path': str(path.relative_to(OUT))} for path in sorted(OUT.rglob('*')) if path.is_file()]
write(OUT / 'FINAL_FREEZE.json', {'frozen_utc': stamp(), 'status': 'bounded source-exposed analytic report complete; no audit verdict',
    'files': rows, 'scientific_programs_run': 0, 'historical_scientific_replays': 0})
for row in rows: same(OUT / row['path'], row)
assert {str(path.relative_to(OUT)) for path in OUT.rglob('*') if path.is_file()} == {row['path'] for row in rows} | {'FINAL_FREEZE.json'}
print(json.dumps({'report': pin(OUT / 'REPORT.md'), 'freeze': pin(OUT / 'FINAL_FREEZE.json'),
    'handoff': pin(OUT / 'HANDOFF.json'), 'member_count': len(rows),
    'source_count': fresh['source_count'], 'recovery_copy_count': fresh['recovery_copy_count'],
    'scientific_programs_run': 0}, indent=2))
