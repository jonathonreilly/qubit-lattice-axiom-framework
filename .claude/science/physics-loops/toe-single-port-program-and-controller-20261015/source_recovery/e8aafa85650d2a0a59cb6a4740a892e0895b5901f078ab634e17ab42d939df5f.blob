from pathlib import Path
from datetime import datetime, timezone
import hashlib
import json

O = Path(__file__).resolve().parent
N = O.parent
W = N.parent / 'correlation_worktree'
OLD = N.parent / 'renewal_20261013_213733'


def digest(data):
    return hashlib.sha256(data).hexdigest()


def capture(path, expected_sha, role, coverage, expected_bytes=None):
    data = path.read_bytes()
    actual_sha = digest(data)
    assert actual_sha == expected_sha, (str(path), actual_sha, expected_sha)
    if expected_bytes is not None:
        assert len(data) == expected_bytes, (str(path), len(data), expected_bytes)
    relative = f'source_blobs/{actual_sha}.bin'
    destination = O / relative
    if destination.exists():
        assert destination.read_bytes() == data
    else:
        destination.write_bytes(data)
    return {
        'path': str(path), 'bytes': len(data), 'sha256': actual_sha,
        'recovery': relative, 'role': role, 'read_coverage': coverage,
        'line_count': len(data.splitlines()),
    }


def main():
    assert not (O / 'FINAL_FREEZE.json').exists(), 'Frozen output is immutable'
    (O / 'source_blobs').mkdir(exist_ok=False)
    specs = [
