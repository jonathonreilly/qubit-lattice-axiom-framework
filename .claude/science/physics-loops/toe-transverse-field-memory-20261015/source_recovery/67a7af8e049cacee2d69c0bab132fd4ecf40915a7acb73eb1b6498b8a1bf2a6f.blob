"""Static source/text/AST/recovery inspection; never import or execute the primary."""
from pathlib import Path
import ast
import datetime
import difflib
import hashlib
import json
import re

D=Path(__file__).resolve().parent;N=D.parent;W=N.parent/"correlation_worktree";OUT=D/"proposal"
PACK=".claude/science/physics-loops/toe-finite-memory-bank-20261015"
NOTE="docs/FINITE_CONSUMED_MEMORY_BANK_BOUNDED_THEOREM_NOTE_2026-10-15.md"
PRIMARY="scripts/finite_consumed_memory_bank_2026_10_15.py"
PARENT="docs/CORRELATED_MEMORY_DELIVERY_AND_READINESS_BOUNDED_THEOREM_NOTE_2026-10-15.md"
def sha(b):return hashlib.sha256(b).hexdigest()
def read(name):return json.loads((OUT/PACK/name).read_text())
def identity(b,row):assert (len(b),sha(b))==(row["bytes"],row["sha256"]),row
def container(path):return (OUT/path).read_bytes() if (OUT/path).exists() else (W/path).read_bytes()
def recover(row):
    r=row["recovery"]
    if r["kind"]=="blob":b=(OUT/r["path"]).read_bytes()
    elif r["kind"]=="external_pinned":b=(W/r["path"]).read_bytes()
    else:b=container(r["container"])[r["start_byte_inclusive"]:r["end_byte_exclusive"]]
    identity(b,row);return b

note=(OUT/NOTE).read_bytes();bodies=read("BODY_MAP.json")["bodies"]
assert len(bodies)==2 and {r["name"] for r in bodies}=={"bank_author","bank_assessment"}
for row in bodies:
    raw=note[row["start_byte_inclusive"]:row["end_byte_exclusive"]]
    identity(raw,row);assert note.count(raw)==1
parents=read("DEPENDENCIES.json")["dependencies"]
assert len(parents)==1 and parents[0]["path"]==PARENT
for row in parents:
    b=(W/row["path"]).read_bytes();identity(b,row)
    for key in ("accepted_body_interval","accepted_review_interval"):
        r=row[key];raw=b[r["start_byte_inclusive"]:r["end_byte_exclusive"]]
        identity(raw,r);assert b.count(raw)==1
sources=read("SOURCE_MANIFEST.json")["sources"]
for row in sources:recover(row)
blobs=read("ARCHIVE_INDEX.json")["objects"]
assert len({r["sha256"] for r in blobs})==len(blobs)
for row in blobs:identity((OUT/row["path"]).read_bytes(),row)
manifest=read("INPUT_MANIFEST.json")
for row in manifest["inputs"]:identity((OUT/row["path"]).read_bytes(),row)
parsed=ast.parse((OUT/PRIMARY).read_text())
names={"AUDIT_INPUT_PATHS","MANIFEST_SHA256","EXPECTED_BODIES","AUDIT_TIMEOUT_SEC","EXPECTED_GIT_BASE"}
assign={n.targets[0].id:ast.literal_eval(n.value) for n in parsed.body if isinstance(n,ast.Assign) and isinstance(n.targets[0],ast.Name) and n.targets[0].id in names}
assert assign["MANIFEST_SHA256"]==sha((OUT/PACK/"INPUT_MANIFEST.json").read_bytes())
assert assign["EXPECTED_BODIES"]=={r["name"]:r["sha256"] for r in bodies}
expected={r["path"] for r in manifest["inputs"]}|{PACK+"/INPUT_MANIFEST.json",PACK+"/ACTUAL_BINDING.json",PARENT}
assert set(assign["AUDIT_INPUT_PATHS"])==expected
assert assign["AUDIT_TIMEOUT_SEC"]==60 and assign["EXPECTED_GIT_BASE"] is None
state=read("PUBLICATION_STATE.json");binding=read("ACTUAL_BINDING.json")
for field in ["canonical_binding","git_base","primary_execution","cache_execution","mutation_execution","graph_execution","publication_action","retained_audit"]:assert state[field] is None
assert state["source_decision"]=="5bf680ccc41224a0446210d20cbc110ef5ebd63c426ed02de72612148a22e908"
assert binding["canonical_parent_binding_complete"] is False and binding["note_sha256"] is None and binding["receipt_paths"]==[]
assert b"canonical_parent_binding_complete: false\n" in note.split(b"---",2)[1]
assert b"Primary-runner role: source integrity only" in note[:4000]
assert (OUT/PACK/"PR_TITLE.txt").read_text().strip()=="[physics-loop] finite-memory-bank: bounded_theorem / conditional-support"

# Lexical link inspection is not a graph build, graph acknowledgment or science check.
local_targets=[]
for target in re.findall(rb"\[[^\]]*\]\(([^)\s#]+\.md)(?:#[^)]*)?\)",note):
    target=target.decode()
    if "://" in target:continue
    p=(OUT/"docs"/target).resolve()
    if p.is_relative_to((OUT/"docs").resolve()):local_targets.append(str(p.relative_to(OUT)))
    else:assert p.is_relative_to(OUT.resolve()) and p.is_file(),target
assert set(local_targets)=={PARENT}

fresh=json.loads((D/"SOURCE_FRESHNESS.json").read_text())
for row in fresh["identities"]:identity(Path(row["original"]).read_bytes(),row)
for p in [D/x for x in ("build_proposal.py","primary_template.py","record_metadata.py","inspect_proposal.py","seal_packet.py")]:ast.parse(p.read_text())
change_map=json.loads((D/"CHANGED_CODE_MAP.json").read_text())
for row in change_map["files"]:
    name=row["file"];a=(D/"template_snapshot"/name).read_text();b=(D/name).read_text()
    assert sha(a.encode())==row["old_sha256"] and sha(b.encode())==row["new_sha256"]
    diff=''.join(difflib.unified_diff(a.splitlines(True),b.splitlines(True),fromfile='correlated_memory_publication_draft/'+name,tofile='finite_bank_publication_draft/'+name))
    assert (D/row["complete_diff"]).read_text()==diff
    assert (OUT/PACK/"packaging_diffs"/(name+".diff")).read_text()==diff
    if name.endswith(".py"):
        aa={x.name:x for x in ast.parse(a).body if isinstance(x,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef))}
        bb={x.name:x for x in ast.parse(b).body if isinstance(x,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef))}
        assert {x["name"] for x in row["functions"]}==set(aa)|set(bb)
        for f in row["functions"]:
            n=f["name"];status='added' if n not in aa else 'removed' if n not in bb else 'same_AST' if ast.dump(aa[n],include_attributes=False)==ast.dump(bb[n],include_attributes=False) else 'changed_AST'
            assert f["status"]==status
for p in sorted((D/"packet_text").glob("*")):
    old=D/"template_snapshot/packet_text"/p.name;a=old.read_text() if old.exists() else '';b=p.read_text()
    diff=''.join(difflib.unified_diff(a.splitlines(True),b.splitlines(True),fromfile='correlated_memory_publication_draft/packet_text/'+p.name if old.exists() else '/dev/null',tofile='finite_bank_publication_draft/packet_text/'+p.name))
    assert (D/"diffs"/('packet_'+p.name+'.diff')).read_text()==diff
    assert (OUT/PACK/"packaging_diffs"/('packet_'+p.name+'.diff')).read_text()==diff
run=D/"metadata_runs/build";receipt=json.loads((run/"EXECUTION.json").read_text())
assert receipt["exit_code"]==0 and receipt["failure"] is None and receipt["scientific_execution"] is False
for key in ["stdout","stderr","child_source_at_launch","recorder","recorder_at_launch"]:
    row=receipt[key];identity(Path(row["path"]).read_bytes(),row)
assert not (run/"stderr").read_bytes()
assert sha((run/"executed_source.py").read_bytes())==sha((D/"build_proposal.py").read_bytes())
result={"checked_utc":datetime.datetime.now(datetime.timezone.utc).isoformat(),"scope":"Static source/text/AST/recovery metadata only; primary was not imported or executed","note":{"path":NOTE,"bytes":len(note),"sha256":sha(note)},"immutable_bodies":len(bodies),"direct_mathematical_parents":len(parents),"selected_source_records":len(sources),"unique_recovery_blobs":len(blobs),"literal_declared_inputs":len(expected),"lexical_local_doc_targets":sorted(set(local_targets)),"complete_code_or_wrapper_diffs":len(change_map["files"]),"packet_text_diffs":len(list((D/"packet_text").glob("*"))),"actual_binding":None,"primary_execution":None,"scientific_programs_run":0,"historical_programs_replayed":0,"root_source_decisions":"Actual finite-bank source acceptance preserved; no publication or audit inferred"}
(D/"VERIFICATION.json").write_text(json.dumps(result,indent=2)+"\n")
print(json.dumps(result,indent=2))
