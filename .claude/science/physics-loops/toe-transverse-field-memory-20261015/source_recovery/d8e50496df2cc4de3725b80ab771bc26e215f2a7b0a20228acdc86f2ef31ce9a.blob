"""One-time source freshness and complete comparison seal; no science execution."""
from pathlib import Path
import datetime
import hashlib
import json

D=Path(__file__).resolve().parent;target=D/'FINAL_FREEZE.json';assert not target.exists()
started=datetime.datetime.now(datetime.timezone.utc).isoformat()
def ident(p):
    b=p.read_bytes();return {'path':str(p),'relative_path':str(p.relative_to(D)),'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
def verify(row):
    p=Path(row['path']);b=p.read_bytes();assert (len(b),hashlib.sha256(b).hexdigest())==(row['bytes'],row['sha256']),str(p)
m=json.loads((D/'SOURCE_MANIFEST.json').read_text());count=0
for row in m['sources']:
    verify(row['original']);verify(row['captured']);count+=2
for block in m['original_freeze_checks']:
    verify(block['freeze']);count+=1
    for row in block['verified_members']:verify(row);count+=1
for row in m['local_sources']:verify(row);count+=1
for row in m['instruction_checks']:
    for key in ['original','captured']:verify({'path':row[key],'bytes':row['bytes'],'sha256':row['sha256']});count+=1
for phase in ['capture','verification']:
    folder=D/'metadata_runs'/phase;r=json.loads((folder/'EXECUTION.json').read_text())
    assert r['exit_code']==0 and r['failure'] is None and r['scientific_execution'] is False
    for key in ['child_source_at_launch','recorder_at_launch','launch','stdout','stderr']:verify(r[key]);count+=1
    for row in json.loads((folder/'LAUNCH.json').read_text())['inputs']:
        verify(row['original']);verify(row['captured']);count+=2
v=json.loads((D/'VERIFICATION.json').read_text());assert v['prior_originals_unchanged'] is True and v['scientific_programs_run']==0
(D/'SEAL_OPERATION.json').write_text(json.dumps({'started_utc':started,'checked_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'scope':'actual in-process source freshness and freeze, not an invented subprocess receipt','identities_checked':count,'actual_metadata_subprocesses':2,'scientific_programs_run':0,'historical_programs_replayed':0,'original_candidate_and_independent_sources_unchanged':True,'root_candidate_exposure':'only after independent acdce882 freeze','files_excluded':[str(target)]},indent=2)+'\n')
files=[ident(p) for p in sorted(D.rglob('*')) if p.is_file() and p!=target]
freeze={'frozen_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'scope':'source-exposed bounded comparison following sealed pre-exposure derivation; not audit','scientific_programs_run':0,'files':files}
target.write_text(json.dumps(freeze,indent=2)+'\n')
for row in files:verify(row)
print(json.dumps({'freeze':ident(target),'members':len(files),'report':ident(D/'REPORT.md'),'source_manifest':ident(D/'SOURCE_MANIFEST.json'),'metadata_receipts':[ident(D/'metadata_runs'/p/'EXECUTION.json') for p in ['capture','verification']]},indent=2))
