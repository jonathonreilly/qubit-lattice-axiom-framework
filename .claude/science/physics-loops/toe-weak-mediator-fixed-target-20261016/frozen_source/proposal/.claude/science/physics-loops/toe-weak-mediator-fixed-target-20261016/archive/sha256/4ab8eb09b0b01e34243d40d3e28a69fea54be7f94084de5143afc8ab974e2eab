]

def write_report(status,inputs,error=None):
    report={'status':status,'checks':CHECKS,'computed':DATA,
            'analytic_premises_not_computed':PREMISES,'statistics':STATS,
            'fixed_inputs':inputs,'source_sha256':hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
            'input_sha256':hashlib.sha256(Path(ARGS.inputs).read_bytes()).hexdigest(),'error':error}
    total=0
    with (OUTPUT/'REPORT.json').open('x') as stream:
        for piece in json.JSONEncoder(indent=2,sort_keys=True).iterencode(report):
            total+=len(piece.encode())
            if total+1>LIMITS['report_byte_ceiling']:
                raise RuntimeError('report byte ceiling; partial report retained')
            stream.write(piece)
        stream.write('\n')

if __name__=='__main__':
    parser=argparse.ArgumentParser()
    parser.add_argument('--inputs',required=True)
    parser.add_argument('--output',required=True)
    ARGS=parser.parse_args()
    inputs={}
    try:
        inputs=json.loads(Path(ARGS.inputs).read_text())
        LIMITS.update(inputs)
        output=Path(ARGS.output)
        output.mkdir(parents=False,exist_ok=False)
        OUTPUT=output
        run(inputs)
        write_report('completed exact polynomial and rational checks; analytic and physical premises remain',inputs)
        print(json.dumps({'completed':True,'checks':len(CHECKS),'statistics':STATS,'report':str(OUTPUT/'REPORT.json')},sort_keys=True),flush=True)
    except BaseException as exc:
        traceback.print_exc()
        if OUTPUT is not None and not (OUTPUT/'REPORT.json').exists():
            try: write_report('failed; no retry',inputs,repr(exc))
            except BaseException: traceback.print_exc()
        sys.exit(1)
