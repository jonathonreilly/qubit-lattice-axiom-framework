#!/usr/bin/env python3
"""Capture one metadata-only sealing process; no scientific source import."""
import datetime as dt
import hashlib
import json
from pathlib import Path
import platform
import subprocess
import sys
import time

root=Path(__file__).resolve().parent;source=root/'seal_metadata.py'
run=root/'runs/metadata_001';run.mkdir(parents=True,exist_ok=False)
raw=source.read_bytes()
(run/'source_at_launch.py').write_bytes(raw)
(run/'recorder_at_launch.py').write_bytes(Path(__file__).read_bytes())
argv=[sys.executable,'-I','-B',str(source)]
start=dt.datetime.now(dt.timezone.utc).isoformat();tic=time.monotonic()
try:
    result=subprocess.run(argv,cwd=root,stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE,timeout=30,check=False)
    out,err,code,timeout=result.stdout,result.stderr,result.returncode,False
except subprocess.TimeoutExpired as exc:
    out,err,code,timeout=exc.stdout or b'',exc.stderr or b'',None,True
(run/'stdout.txt').write_bytes(out);(run/'stderr.txt').write_bytes(err)
receipt={'kind':'metadata only; no coefficient calculation','argv':argv,'cwd':str(root),
         'start_utc':start,'end_utc':dt.datetime.now(dt.timezone.utc).isoformat(),
         'elapsed_seconds':time.monotonic()-tic,'exit_code':code,'timeout':timeout,
         'wall_limit_seconds':30,'cpu_ram_limits':'none','executable':sys.executable,
         'python_version':sys.version,'platform':platform.platform(),
         'source_sha256':hashlib.sha256(raw).hexdigest(),'source_unchanged':source.read_bytes()==raw,
         'stdout_sha256':hashlib.sha256(out).hexdigest(),'stderr_sha256':hashlib.sha256(err).hexdigest()}
(run/'EXECUTION.json').write_text(json.dumps(receipt,indent=2)+'\n')
sys.stdout.buffer.write(out);sys.stderr.buffer.write(err)
print(json.dumps({'receipt':str(run/'EXECUTION.json'),'exit_code':code,'timeout':timeout},sort_keys=True))
sys.exit(1 if timeout or code is None else code)
