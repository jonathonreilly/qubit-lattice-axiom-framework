def report(status,parameters,error=None):
    data={'status':status,'checks':CHECKS,'computed_scenarios':SCENARIOS,'active_scenario':ACTIVE_SCENARIO,'statistics':STATS,
          'parameters':parameters,'analytic_and_physical_premises':PREMISES,
          'source_sha256':hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
          'parameters_sha256':hashlib.sha256(Path(__file__).with_name('PARAMETERS.json').read_bytes()).hexdigest(),
          'count_qualification':'Counters describe guarded source-level operations; Fraction gcd/reduction and isqrt internals are not individually counted. Output bit lengths are not intermediate bit complexity.',
          'error':error}
    count=0
    with (OUTPUT/'REPORT.json').open('x') as stream:
        for piece in json.JSONEncoder(indent=2,sort_keys=True).iterencode(data):
            count+=len(piece.encode())
            if count+1>REPORT_CAP:raise RuntimeError('report byte ceiling; partial file preserved')
            stream.write(piece)
        stream.write('\n')

if __name__=='__main__':
    parser=argparse.ArgumentParser()
    parser.add_argument('--output',required=True)
    args=parser.parse_args()
    params={}
    try:
        params=json.loads(Path(__file__).with_name('PARAMETERS.json').read_text())
        out=Path(args.output);out.mkdir(parents=False,exist_ok=False);OUTPUT=out
        ACTIVE_SCENARIO='uniform_grid_p171_n179_window24'
        SCENARIOS[ACTIVE_SCENARIO]=DATA
        DATA['statistics_before']=dict(STATS)
