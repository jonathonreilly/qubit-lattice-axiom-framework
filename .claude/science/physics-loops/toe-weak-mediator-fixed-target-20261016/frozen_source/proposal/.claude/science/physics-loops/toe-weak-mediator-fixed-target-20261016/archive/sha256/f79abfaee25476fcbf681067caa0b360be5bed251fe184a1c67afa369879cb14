        print(json.dumps({'completed':True,'report':str(OUTPUT/'REPORT.json'),'statistics':STATS},sort_keys=True),flush=True)
    except BaseException as exc:
        traceback.print_exc()
        if OUTPUT is not None and not (OUTPUT/'REPORT.json').exists():
            try:report('failed; no retry',params,repr(exc))
            except BaseException:traceback.print_exc()
        sys.exit(1)
