set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option Elab.async false
set_option maxErrors 1
namespace Haar

/-! Positive transfer polynomial for a separate count at every degree. A
    base-2^144 digit records the count at that degree. The value at one
    bounds every coefficient before truncation and is checked below. -/
def digitBits : Nat := 144
def digitBase : Nat := 2^144

structure CountArc where
  id : Nat
  shifted : Nat
  ordinary : Nat
  rooted : Nat
  number : Nat
  rootNumber : Nat

structure CountData where
  a : Col
  cs : List Col
  rows : List (List Nat)

def moveCodes (a : Col) (d : Nat) (p : Col) (cs : List Col) : List Nat :=
  (cs.zipIdx).filterMap fun (q,j) =>
    let used := a.cost+p.cost+q.cost+2*lowerCost a
    if used > d then none else
    let bs := cuts p q 0 (d-used)
    match bs.head?,bs.getLast? with
    | some lo,some hi => some (j + 256*(lo+64*hi))
    | _,_ => none

def degreePoly (lo n : Nat) :=
  (List.range n).foldl (fun v k => v+(1 <<< (digitBits*(lo+2*k)))) 0

def decodeCountArc (c : CountData) (root code : Nat) : CountArc :=
  let j := code % 256
  let q := c.cs.getD j ⟨0,0,0,0⟩
  let lo := (code >>> 8) % 64
  let hi := code >>> 14
  let n := (hi-lo)/2+1
  let r := max lo (root+lo%2)
  let nr := if r ≤ hi then (hi-r)/2+1 else 0
  ⟨j,digitBits*q.cost,degreePoly lo n,degreePoly r nr,n,nr⟩

def countMoves (c : CountData) (root i : Nat) :=
  (c.rows.getD i []).map (decodeCountArc c root)

structure PairCount where
  forward : Nat
  backward : Nat
  ways : Nat
  rootWays : Nat

def countCommon :
    Nat → List CountArc → List CountArc → PairCount → PairCount
  | 0,_,_,acc => acc
  | _+1,[],_,acc | _+1,_,[],acc => acc
  | n+1,x::xs,z::zs,acc =>
    if x.id < z.id then countCommon n xs (z::zs) acc else
    if z.id < x.id then countCommon n (x::xs) zs acc else
      countCommon n xs zs ⟨acc.forward+((x.ordinary*z.ordinary) <<< x.shifted),
        acc.backward+((x.rooted*z.ordinary) <<< x.shifted),
        acc.ways+x.number*z.number,acc.rootWays+x.rootNumber*z.number⟩

structure CountPoly where
  value : Nat
  upper : Nat

def addCount (x y : CountPoly) : CountPoly := ⟨x.value+y.value,x.upper+y.upper⟩

def countPolyRow (c : CountData) (mark : Bool) (d i : Nat) : CountPoly :=
  let root := if mark then 2 else 0
  let x := c.cs.getD i ⟨0,0,0,0⟩
  let rx := countMoves c root i
  let modulus := 1 <<< (digitBits*(d+1))
  (c.cs.zipIdx).foldl (fun acc (z,j) =>
    if !(usable c.a mark d (columnOf x) (columnOf z)) then acc else
    let rz := countMoves c root j
    let p := countCommon (rx.length+rz.length) rx rz ⟨0,0,0,0⟩
    let shift := digitBits*(c.a.cost+x.cost+z.cost)
    ⟨(acc.value+((p.forward*p.backward) <<< shift)) % modulus,
      acc.upper+p.ways*p.rootWays⟩) ⟨0,0⟩

def countPageTest (c : CountData) (mark : Bool) (d start size : Nat) (value : CountPoly) :=
  let got := (List.range size).foldl (fun acc j =>
    addCount acc (countPolyRow c mark d (start+j))) ⟨0,0⟩
  got.value == value.value && got.upper ≤ value.upper

def degreeCounts (pairs : List (Nat × Nat)) :=
  pairs.foldl (fun v (k,n) => v+(n <<< (digitBits*k))) 0

structure CountPage (c : CountData) (mark : Bool) (d : Nat) where
  start : Nat
  size : Nat
  value : CountPoly
  checked : (List.range size).all (fun k =>
    let i := start+k
    let p := c.cs.getD i ⟨0,0,0,0⟩
    c.rows.getD i [] == moveCodes c.a d p c.cs) = true
  total : countPageTest c mark d start size value = true

def consecutivePages {c mark d} (start : Nat) : List (CountPage c mark d) → Nat → Bool
  | [],n => start == n
  | p::ps,n => start == p.start && consecutivePages (start+p.size) ps n

structure CountCap (mark : Bool) (d : Nat) where
  data : CountData
  pages : List (CountPage data mark d)
  value : CountPoly
  shape : listEqBy (· == ·) ((pool data.a (if mark then 2 else 0) d).map Column.spins) data.cs = true
  rangeOk : data.cs.length < 256 ∧ d < 64 ∧ data.cs.length = data.rows.length
  cover : consecutivePages 0 pages data.cs.length = true
  total : (pages.foldl (fun acc p => addCount acc p.value) ⟨0,0⟩).value = value.value
  bound : (pages.foldl (fun acc p => addCount acc p.value) ⟨0,0⟩).upper ≤ value.upper

def coefficient (p k : Nat) := (p >>> (digitBits*k)) % digitBase


end Haar
