/-! A separate mixed-array-first census. Each canonical array represents its
    distinct rooted images. All eight cap intervals are regenerated before
    weighting the cap fibre by that orbit cardinality. -/
def mixedCode (m : Four Col) : Nat :=
  m.items.foldl (fun n c => c.items.foldl (fun z k => 16*z+k) n) 0

def readNibbles (w : Nat) : Col :=
  ⟨(w >>> 12) % 16,(w >>> 8) % 16,(w >>> 4) % 16,w % 16⟩

def decodeMixed (n : Nat) : Four Col :=
  ⟨readNibbles (n >>> 48),readNibbles (n >>> 32),readNibbles (n >>> 16),readNibbles n⟩

def flipRows (n : Nat) : Nat :=
  ((n &&& 0xffff) <<< 48) |||
    ((n &&& 0xffff0000) <<< 16) |||
    ((n &&& 0xffff00000000) >>> 16) |||
    ((n &&& 0xffff000000000000) >>> 48)

def flipCols (n : Nat) : Nat :=
  ((n &&& 0xf000f000f000f) <<< 12) |||
    ((n &&& 0xf000f000f000f0) <<< 4) |||
    ((n &&& 0xf000f000f000f00) >>> 4) |||
    ((n &&& 0xf000f000f000f000) >>> 12)

def transposeCode (n : Nat) : Nat :=
  let x := (n ^^^ (n >>> 12)) &&& 0xf0f00000f0f0
  let m := n ^^^ x ^^^ (x <<< 12)
  let y := (m ^^^ (m >>> 24)) &&& 0xff00ff00
  m ^^^ y ^^^ (y <<< 24)

def images4 (n : Nat) :=
  let r := flipRows n
  [n,r,flipCols n,flipCols r]

def gridOrbit (n : Nat) := (images4 n ++ images4 (transposeCode n)).eraseDups

/-- Check the bit permutations against the graph action on every nibble
    value at every one of the 16 positions. The fields are disjoint. -/
theorem mixed_digit_actions :
    (List.range 16).all (fun i => (List.range 16).all fun x =>
      let k := x <<< (4*i)
      let c : Config := ⟨⟨0,0,0,0⟩,⟨0,0,0,0⟩,decodeMixed k⟩
      mixedCode c.m == k && mixedCode c.reflectI.m == flipRows k &&
      mixedCode c.reflectJ.m == flipCols k && mixedCode c.transpose.m == transposeCode k) = true := by decide
#print axioms mixed_digit_actions

def choicesFor (m : Four Col) (root bound i : Nat) : List Nat :=
  cuts (m.get (i+3)) (m.get i) (if i == 0 then root else 0) bound

def fourChoices (s : Four (List Nat)) (bound : Nat) : List Col :=
  s.c0.flatMap fun x => s.c1.flatMap fun y => s.c2.flatMap fun z =>
    s.c3.filterMap fun w => if x+y+z+w ≤ bound then some ⟨x,y,z,w⟩ else none

structure EdgeTerm where
  cost : Nat
  key : Nat
  good : Bool
  coeff : Int

def gridEdge (a : Col) (b : Nat) (p q : Col) (mark : Bool) : EdgeTerm :=
  let v0 : Vertex := ⟨a.c0,b,p.c0,q.c3⟩
  let v1 : Vertex := ⟨a.c1,b,p.c1,q.c0⟩
  let v2 : Vertex := ⟨a.c2,b,p.c2,q.c1⟩
  let v3 : Vertex := ⟨a.c3,b,p.c3,q.c2⟩
  let ok := inWindow v0 p.c3 q.c0 && inWindow v1 p.c0 q.c1 &&
            inWindow v2 p.c1 q.c2 && inWindow v3 p.c2 q.c3
  let e0 := scaledCell v0 p.c3 q.c0 mark
  let e1 := scaledCell v1 p.c0 q.c1 false
  let e2 := scaledCell v2 p.c1 q.c2 false
  let e3 := scaledCell v3 p.c2 q.c3 false
  let n := if e0 == 0 || e1 == 0 || e2 == 0 then 0 else ((b+1 : Nat) : Int)*e0*e1*e2*e3
  ⟨b,spinKey b,ok,n⟩

def edgeTerms (m : Four Col) (a : Col) (mark : Bool) (i : Nat) (bs : List Nat) :=
  let p := m.get (i+3)
  let q := m.get i
  bs.map fun b => gridEdge a b p q (mark && i == 0)

def edgePairs (xs ys : List EdgeTerm) (bound : Nat) : List EdgeTerm :=
  xs.flatMap fun x => ys.filterMap fun y =>
    if x.cost+y.cost ≤ bound then
      some ⟨x.cost+y.cost,x.key+y.key,x.good && y.good,if x.coeff == 0 then 0 else x.coeff*y.coeff⟩ else none

def mixedFibre (mark : Bool) (d code : Nat) : Totals :=
  let m := decodeMixed code
  let images := gridOrbit code
  let count := images.length
  let mixedCost := m.items.foldl (fun n c => n+c.cost) 0
  let root := if mark then 2 else 0
  if mixedCost+2*root > d || code ≥ 2^64 ||
      !(images.all fun x => code ≤ x) then ⟨0,false,[]⟩ else
  let bound := d-mixedCost
  let tr := four fun i => four fun j => (m.get j).get i
  let bs := four (choicesFor m root bound)
  let floors : Col := four fun i => ((bs.get i).head?).getD (bound+1)
  let minimum := floors.cost
  if minimum > bound then ⟨0,false,[]⟩ else
  let aa := fourChoices (four (choicesFor tr root bound)) (bound-minimum)
  let mixedKey := m.items.foldl (fun n v => n+colKey v) 0
  let total := aa.foldl (fun acc a =>
    let remaining := bound-a.cost
    let allowed := fun i => (bs.get i).filter fun b => b+minimum ≤ remaining+floors.get i
    let comb := fun i j => edgePairs (edgeTerms m a mark i (allowed i))
      (edgeTerms m a mark j (allowed j)) remaining
    let k := mixedKey+colKey a
    let factor := (count : Int)*capDim a
    (comb 0 1).foldl (fun acc x => (comb 2 3).foldl (fun acc y =>
      if x.cost+y.cost > remaining then acc else
      let w := if x.coeff == 0 then 0 else factor*x.coeff*y.coeff
      let bins := if w == 0 then acc.bins else addScore (k+x.key+y.key) w acc.bins
      ⟨acc.count+count,acc.good && x.good && y.good,bins⟩) acc) acc) empty
  ⟨total.count,total.good && total.count != 0,total.bins⟩

def afterGrid (previous : Nat) : List Nat → Bool
  | [] => true
  | h::t => previous < h && afterGrid h t

def increasing : List Nat → Bool
  | [] => true
  | h::t => afterGrid h t


structure OrbitPage (mark : Bool) (d : Nat) where
  first : Nat
  last : Nat
  grids : List Nat
  value : Totals
  bounds : grids.head? = some first ∧ grids.getLast? = some last ∧ increasing grids = true
  checked : sameTotals (addList (grids.map (mixedFibre mark d))) value = true

def OrbitPage.total {mark d} (p : OrbitPage mark d) := p.value

def afterPage {mark d} (previous : Nat) : List (OrbitPage mark d) → Bool
  | [] => true
  | q::qs => previous < q.first && afterPage q.last qs

def disjointPages {mark d} : List (OrbitPage mark d) → Bool
  | [] => true
  | p::ps => afterPage p.last ps

end Haar
