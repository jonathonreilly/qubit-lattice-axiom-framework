structure ProvedSupport where
  config : Config
  value : Fr
  proof : SphereValue config value

/-! These shared subcalculations are an untrusted certificate. Each call to
    certifyTrace regenerates all children from its actual quaternion words,
    checks the signed recurrence and consumes proofs for every child. -/
namespace SphereCertificate

def word0 : Word := [-20,-19,-18,-17]
