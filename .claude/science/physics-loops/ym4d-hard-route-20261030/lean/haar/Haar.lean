def localScale : Nat := 10080

def packedBlock (a b t s : Nat) : Nat :=
  (((scalarBlocks.getD a []).getD b []).getD t []).getD s 0

def scaledCell (v : Vertex) (r u : Nat) (mark : Bool) : Int :=
  let pos := 48*(8*r+u) + (if mark then 24 else 0)
  let code := ((packedBlock v.a v.b v.t v.s) >>> pos) % 16777216
  if code%2 == 0 then (code/2 : Nat) else -((code/2+1 : Nat) : Int)

def inWindow (v : Vertex) (r u : Nat) :=
  v.a ≤ 6 && v.b ≤ 6 && v.t ≤ 7 && v.s ≤ 7 && r ≤ 7 && u ≤ 7 && v.a+v.b+v.t+v.s+r+u ≤ 22

def cacheAgrees (v : Vertex) (r u : Nat) (mark : Bool) :=
  (localWeight v r u mark).same ⟨scaledCell v r u mark,localScale⟩

def cellWindow (a b t : Nat) :=
  (pathSlice a b t (List.range 8)).all fun (v,r,u) =>
    cacheAgrees v r u false && (a < 2 || b < 2 || cacheAgrees v r u true)

def scaledSlice (a : Col) (b : Nat) (p q : Col) (mark : Bool) : Int :=
  (List.range 4).foldl (fun acc j =>
    let v : Vertex := ⟨a.get j,b,p.get j,q.get (j+3)⟩
    acc * scaledCell v (p.get (j+3)) (q.get j) (mark && j == 0)) (b+1 : Nat)

def goodSlice (a : Col) (b : Nat) (p q : Col) : Bool :=
  (List.range 4).all fun j => inWindow ⟨a.get j,b,p.get j,q.get (j+3)⟩ (p.get (j+3)) (q.get j)

structure Score where
  key : Nat
  coeff : Int
  deriving Repr, DecidableEq

abbrev Scores := List Score

/-- Sorted sparse addition keeps a row even after exact cancellation. -/
def addScore (k : Nat) (n : Int) : Scores → Scores
  | [] => [⟨k,n⟩]
  | h::t => if k < h.key then ⟨k,n⟩::h::t else if k == h.key then ⟨k,n+h.coeff⟩::t
    else h::addScore k n t

def mergeSorted : Nat → Scores → Scores → Scores
  | 0, xs, ys => xs ++ ys
  | _+1, [], ys => ys
  | _+1, xs, [] => xs
  | n+1, x::xs, y::ys =>
    if x.key < y.key then x::mergeSorted n xs (y::ys) else
    if y.key < x.key then y::mergeSorted n (x::xs) ys else
      ⟨x.key,x.coeff+y.coeff⟩::mergeSorted n xs ys

def mergeScores (xs ys : Scores) := mergeSorted (xs.length+ys.length) xs ys

def colKey (c : Col) := spinKey c.c0 + spinKey c.c1 + spinKey c.c2 + spinKey c.c3
def capDim (a : Col) : Nat := (a.c0+1)*(a.c1+1)*(a.c2+1)*(a.c3+1)

structure Totals where
  count : Nat
  good : Bool
  bins : Scores
  deriving Repr, DecidableEq, Inhabited

def empty : Totals := ⟨0,true,[]⟩

def Totals.add (x y : Totals) : Totals :=
  ⟨x.count+y.count,x.good && y.good,mergeScores x.bins y.bins⟩

def dividesTable (xs : Histogram) :=
  xs.all fun h => h.weight.d > 0 && (localScale^16)%h.weight.d == 0



/-! Cut the labelled torus at opposite columns x and z. The other two
    columns and their incident vertical caps are conditionally independent
    choices in the finite sum once x,z and the horizontal caps are fixed. -/
structure Column where
  spins : Col
  cost : Nat
  key : Nat
  deriving Repr, Inhabited

def columnOf (x : Col) : Column := ⟨x,x.cost,colKey x⟩

def lowerCost (a : Col) := max a.big ((a.cost+1)/2)

def pool (a : Col) (root d : Nat) : List Column :=
  let low := lowerCost a
  if a.cost+4*low+root > d then []
  else (columns a (d-a.cost-root-3*low)).map columnOf

structure Half where
  cost : Nat
  key : Nat
  count : Nat
  nonzero : Bool
  good : Bool
  coeff : Int
  deriving Repr

/-- Group middle-column assignments by their monomial. cost is determined
    by the key. nonzero records an individual nonzero product, even when
    the signed total at its key has cancelled. -/
def putHalf (h : Half) : List Half → List Half
  | [] => [h]
  | k::ks =>
    if h.key == k.key then
      ⟨k.cost,k.key,h.count+k.count,h.nonzero || k.nonzero,h.good && k.good,h.coeff+k.coeff⟩::ks
    else k::putHalf h ks


/-! Verified tables on directed column cuts. Every eligible middle column
    and every vertical spin at its cut are regenerated when checking a row. -/
structure Arc where
  spin : Nat
  fw : Int
  bw : Int
  rooted : Int
  okF : Bool
  okB : Bool
  deriving Repr

structure Neighbor where
  id : Nat
  cost : Nat
  key : Nat
  arcs : List Arc
  deriving Repr

def arcEq (x y : Arc) := x.spin == y.spin && decide (x.fw = y.fw) &&
  decide (x.bw = y.bw) && decide (x.rooted = y.rooted) && x.okF == y.okF && x.okB == y.okB

def listEqBy (f : α → α → Bool) : List α → List α → Bool
  | [], [] => true
  | a::as', b::bs => f a b && listEqBy f as' bs
  | _, _ => false

def sameRow := listEqBy (fun (x y : Neighbor) =>
  x.id == y.id && x.cost == y.cost && x.key == y.key && listEqBy arcEq x.arcs y.arcs)

def cutArc (a : Col) (mark : Bool) (p q : Col) (b : Nat) : Arc :=
  let backward := scaledSlice a b q p false
  ⟨b,scaledSlice a b p q false,backward,
   if mark && 2 ≤ b then scaledSlice a b q p true else backward,
   goodSlice a b p q,goodSlice a b q p⟩

def preparedRow (a : Col) (mark : Bool) (d : Nat) (p : Column) (cs : List Column) : List Neighbor :=
  let overhead := a.cost+p.cost+2*lowerCost a
  let rec go (i : Nat) : List Column → List Neighbor
    | [] => []
    | q::qs =>
      let tail := go (i+1) qs
      if overhead+q.cost > d then tail else
      let bs := cuts p.spins q.spins 0 (d-overhead-q.cost)
      if bs.isEmpty then tail else
        ⟨i,q.cost,q.key,bs.map (cutArc a mark p.spins q.spins)⟩::tail
  go 0 cs

def usable (a : Col) (mark : Bool) (d : Nat) (x z : Column) : Bool :=
  let gap := Col.big (four fun j => diff (x.spins.get j) (z.spins.get j))
  let root := if mark then 2 else 0
  a.cost+x.cost+z.cost+2*lowerCost a+gap+max gap (root+(x.spins.c0+z.spins.c0)%2) ≤ d

abbrev Halves := List Half × List Half

def joinArcs (mark : Bool) (root bound low : Nat) (x z : Neighbor) (halves : Halves) : Halves :=
  x.arcs.foldl (fun hs l => z.arcs.foldl (fun hs r =>
    let cost := x.cost+l.spin+r.spin
    if cost+low > bound then hs else
    let key := x.key+spinKey l.spin+spinKey r.spin
    let forward := l.fw*r.bw
    let back := r.fw*(if mark then l.rooted else l.bw)
    let left := if cost+low+root ≤ bound then
      putHalf ⟨cost,key,1,decide (forward ≠ 0),l.okF && r.okB,forward⟩ hs.1 else hs.1
    let right := if root ≤ l.spin then
      putHalf ⟨cost,key,1,decide (back ≠ 0),r.okF && l.okB,back⟩ hs.2 else hs.2
    (left,right)) hs) halves

def visitCommon (f : Neighbor → Neighbor → Halves → Halves) :
    Nat → List Neighbor → List Neighbor → Halves → Halves
  | 0, _, _, hs => hs
  | _+1, [], _, hs | _+1, _, [], hs => hs
  | n+1, x::xs, z::zs, hs =>
    if x.id < z.id then visitCommon f n xs (z::zs) hs else
    if z.id < x.id then visitCommon f n (x::xs) zs hs else
      visitCommon f n xs zs (f x z hs)

def productHalves (a : Col) (bound key : Nat) (hs : Halves) : Totals :=
  hs.1.foldl (fun acc h => hs.2.foldl (fun acc k =>
    if h.cost+k.cost > bound then acc else
      let bins := if h.nonzero && k.nonzero then
        addScore (key+h.key+k.key) (capDim a * h.coeff * k.coeff) acc.bins else acc.bins
      ⟨acc.count+h.count*k.count,acc.good && h.good && k.good,bins⟩) acc) empty

def cutProduct (a : Col) (mark : Bool) (d : Nat) (x z : Column) (rx rz : List Neighbor) : Totals :=
  let bound := d-a.cost-x.cost-z.cost
  let root := if mark then 2 else 0
  let hs := visitCommon (joinArcs mark root bound (lowerCost a)) (rx.length+rz.length) rx rz ([],[])
  productHalves a bound (colKey a+x.key+z.key) hs

def sameTotals (x y : Totals) :=
  x.count == y.count && x.good == y.good &&
    listEqBy (fun (h k : Score) => h.key == k.key && decide (h.coeff = k.coeff)) x.bins y.bins

def term (k : Nat) (n : Int) (d : Nat) : Score := ⟨k,n*(localScale^16/d : Nat)⟩

def liveCaps (mark : Bool) (d : Nat) :=
  let root := if mark then 2 else 0
  (caps root ((d-root)/3)).filter fun a => a.cost+root+4*lowerCost a ≤ d

def coordinateEq (x y : Column) := x.spins == y.spins && x.cost == y.cost && x.key == y.key

def addList (xs : List Totals) := xs.foldl Totals.add empty

/-- A saved subtotal is usable only with the derivations of its pieces.
    Internal nodes check sorted exact integer addition on their two children. -/
inductive SumProof (f : α → Totals) : List α → Totals → Prop where
  | one (x) : SumProof f [x] (f x)
  | leaf (xs) (v) : sameTotals (addList (xs.map f)) v = true → SumProof f xs v
  | join {xs ys p q} (v) : SumProof f xs p → SumProof f ys q →
      sameTotals (p.add q) v = true → SumProof f (xs++ys) v

structure Saved (f : α → Totals) where
  items : List α
  total : Totals
  proof : SumProof f items total

def singleSum (f : α → Totals) (x : α) : Saved f :=
  ⟨[x],f x,.one x⟩

def emptySum (f : α → Totals) : Saved f :=
  ⟨[],empty,.leaf [] empty rfl⟩

def leafSum (f : α → Totals) (xs : List α) (v : Totals)
    (ok : sameTotals (addList (xs.map f)) v = true) : Saved f :=
  ⟨xs,v,.leaf xs v ok⟩

def joinSum (p q : Saved f) (v : Totals) (ok : sameTotals (p.total.add q.total) v = true) : Saved f :=
  ⟨p.items++q.items,v,.join v p.proof q.proof ok⟩

/-- The target rows here are sorted by base-25 key. Their nine fields
    are a permutation of precisely the rows in Ring.lean. -/
def declaredSorted (xs : Histogram) : Scores :=
  xs.map fun b => ⟨b.key,b.weight.n * (localScale^16 / b.weight.d : Nat)⟩

def sameScores := listEqBy (fun (x y : Score) => x.key == y.key && decide (x.coeff = y.coeff))

/-! Packed integers are used only as a file representation of proposed
    intermediate values. Every cut, subtotal, key and count is checked. -/
structure Bank where
  width : Nat
  pages : List (List (List Nat))

def Bank.read (bank : Bank) (k : Nat) : Nat :=
  let a := (bank.pages.getD (k/4096) []).getD ((k/256)%16) []
  let w := a.getD ((k/16)%16) 0
  (w >>> (bank.width*(k%16))) % 2^bank.width

def unzig (n : Nat) : Int := if n%2 == 0 then (n/2 : Nat) else -((n/2+1 : Nat) : Int)

def unpackN {α : Type} (width : Nat) (f : Nat → α) : Nat → Nat → List α
  | 0, _ => []
  | n+1, v => f (v % 2^width) :: unpackN width f n (v >>> width)

def unpackArc (bank : Bank) (v : Nat) : Arc :=
  ⟨v%16,unzig (bank.read ((v >>> 4)%8192)),unzig (bank.read ((v >>> 17)%8192)),
   unzig (bank.read ((v >>> 30)%8192)),((v >>> 43)%2) == 1,((v >>> 44)%2) == 1⟩

def unpackNeighbor (bank : Bank) (cs : List Column) (v : Nat) : Neighbor :=
  let id := v%128
  let c := cs.getD id default
  ⟨id,c.cost,c.key,unpackN 45 (unpackArc bank) ((v >>> 7)%16) (v >>> 11)⟩

def unpackRow (bank : Bank) (cs : List Column) := List.map (unpackNeighbor bank cs)

structure ScoreBanks where
  keys : Bank
  values : Bank
  keyBits : Nat
  valueBits : Nat

def unpackScore (banks : ScoreBanks) (v : Nat) : Score :=
  let k := banks.keys.read (v % 2^banks.keyBits)
  let f := banks.values.read (v >>> banks.keyBits)
  term k (unzig (f >>> 24)) (f % 16777216)

def unpackScores (b : ScoreBanks) (n : Nat) (chunks : List Nat) : Scores :=
  let rec go (left : Nat) : List Nat → Scores
    | [] => []
    | h::hs => unpackN (b.keyBits+b.valueBits) (unpackScore b) (min 16 left) h ++ go (left-16) hs
  go n chunks


/-! A catalogue stores only small integers and packed lists. Kernel proofs
    below check it in disjoint ranges. No record is accepted on a hash. -/
structure Encoded where
  count : Nat
  size : Nat
  words : List Nat

def Encoded.read (e : Encoded) (banks : ScoreBanks) : Totals :=
  ⟨e.count,true,unpackScores banks e.size e.words⟩

structure Tile where
  zs : List Nat
  value : Encoded

structure Line where
  moves : List Nat
  tiles : List Tile
  value : Encoded

structure Catalog where
  a : Col
  cols : List Column
  lines : List Line
  value : Encoded

def Catalog.row (c : Catalog) (bank : Bank) (i : Nat) : List Neighbor :=
  match c.lines[i]? with
  | none => []
  | some row => unpackRow bank c.cols row.moves

def admissibleZ (c : Catalog) (mark : Bool) (d : Nat) (x : Column) : List Nat :=
  (c.cols.zipIdx).filterMap fun (z,j) => if usable c.a mark d x z then some j else none

def rowTest (c : Catalog) (bank : Bank) (vals : ScoreBanks) (mark : Bool) (d i : Nat) : Bool :=
  match c.cols[i]?, c.lines[i]? with
  | some x, some line =>
    sameRow (preparedRow c.a mark d x c.cols) (c.row bank i) &&
    decide (admissibleZ c mark d x = line.tiles.flatMap Tile.zs) &&
    sameTotals (addList (line.tiles.map (fun t => t.value.read vals))) (line.value.read vals)
  | _,_ => false

def tileTest (c : Catalog) (bank : Bank) (vals : ScoreBanks) (mark : Bool) (d i j : Nat) : Bool :=
  match c.cols[i]?, c.lines[i]? with
  | some x,some row =>
    match row.tiles[j]? with
    | none => false
    | some t =>
      let rx := c.row bank i
      let v := t.zs.foldl (fun sum n => match c.cols[n]? with
        | none => ⟨sum.count,false,sum.bins⟩
        | some z => (cutProduct c.a mark d x z rx (c.row bank n)).add sum) empty
      sameTotals v (t.value.read vals)
  | _,_ => false

inductive Span (P : Nat → Prop) : Nat → Nat → Prop where
  | nil (s) : Span P s 0
  | snoc {s n} : Span P s n → P (s+n) → Span P s (n+1)
  | join {s n m} : Span P s n → Span P (s+n) m → Span P s (n+m)

/-- Bounded conjunctions compose without rerunning previous reductions. -/
def countTiles (c : Catalog) (i : Nat) := (c.lines[i]?.map (fun t => t.tiles.length)).getD 0

def lineClaim (c : Catalog) (b : Bank) (v : ScoreBanks) (mark : Bool) (d i : Nat) : Prop :=
  rowTest c b v mark d i = true ∧
    Span (fun j => tileTest c b v mark d i j = true) 0 (countTiles c i)

def shapeTest (c : Catalog) (mark : Bool) (d : Nat) :=
  listEqBy coordinateEq (pool c.a (if mark then 2 else 0) d) c.cols &&
  c.cols.length == c.lines.length

structure CertifiedCap (b : Bank) (v : ScoreBanks) (mark : Bool) (d : Nat) where
  data : Catalog
  shape : shapeTest data mark d = true
  summation : sameTotals (addList (data.lines.map fun t => t.value.read v)) (data.value.read v) = true
  checked : Span (lineClaim data b v mark d) 0 data.cols.length

def CertifiedCap.total {b v mark d} (c : CertifiedCap b v mark d) := c.data.value.read v

def coveredCaps {b v mark d} (x : Saved (@CertifiedCap.total b v mark d)) : Bool :=
  listEqBy (· == ·) (liveCaps mark d) (x.items.map fun c => c.data.a)



/-! Dephase each local symbol before applying the two reflections and the
    transpose. The product of the removed phases is (-1)^(sum of mixed spins).
    The three replacements below act on the four actual mixed corners. -/
def phaseNum (v : Vertex) (r u : Nat) := v.a+2*v.t+3*v.b+r-u

def dephasedEqual (v w : Vertex) (r u p q : Nat) (mark : Bool) :=
  let x := v.rightSq u
  let y := w.rightSq q
  let f := scaledCell v r u mark * paritySign (phaseNum v r u / 2)
  let g := scaledCell w p q mark * paritySign (phaseNum w p q / 2)
  x.n > 0 && y.n > 0 && x.d > 0 && y.d > 0 &&
    decide (f * x.d * y.n = g * y.d * x.n)

def invariantLocal (v : Vertex) (r u : Nat) (mark : Bool) :=
  dephasedEqual v ⟨v.a,v.b,u,r⟩ r u v.s v.t mark &&
  dephasedEqual v ⟨v.a,v.b,r,u⟩ r u v.t v.s mark &&
  dephasedEqual v ⟨v.b,v.a,v.s,v.t⟩ r u r u mark

def localChecks (a b t : Nat) :=
  (pathSlice a b t (List.range 8)).all fun (v,r,u) =>
    u ≤ a+2*t+3*b && (phaseNum v r u)%2 == 0 &&
    cacheAgrees v r u false && invariantLocal v r u false &&
    (a < 2 || b < 2 || (cacheAgrees v r u true && invariantLocal v r u true))

/-- Six face indices locate an overlap. The 24 distinct symbols in frame
    label the face POSITIONS, so incidence checks hold under substitution
    of arbitrary (possibly equal) spins for those symbols. -/
def frame : Config := ⟨four (fun j => j+16),four (fun i => i+20),four fun i => four fun j => 4*i+j⟩
def atVertex (c : Config) (i j : Nat) : Vertex × Nat × Nat :=
  let p := c.m.get (i+3)
  let q := c.m.get i
  (⟨c.a.get j,c.b.get i,p.get j,q.get (j+3)⟩,p.get (j+3),q.get j)

def verticesOf (c : Config) := (List.range 4).flatMap fun i =>
  (List.range 4).map fun j => atVertex c i j

def bagEq [BEq α] (xs ys : List α) :=
  xs.length == ys.length && (xs++ys).all (fun x => xs.count x == ys.count x)

def triTag (a b c : Nat) : Nat :=
  let lo := min a (min b c)
  let hi := max a (max b c)
  lo + 32*(a+b+c-lo-hi+32*hi)
def leftTags (c : Config) := (verticesOf c).flatMap fun (v,r,_) =>
  [triTag v.a v.t r,triTag v.b v.s r]
def rightTags (c : Config) := (verticesOf c).flatMap fun (v,_,u) =>
  [triTag v.b v.t u,triTag v.a v.s u]

def phaseIncidence (c : Config) :=
  let v := verticesOf c
  let m := c.m.items.flatMap Four.items
  (c.labels.all fun k =>
    let lhs : Int := v.foldl (fun (z : Int) (p,r,u) =>
      z + (if p.a == k then 1 else 0) + (if p.t == k then 2 else 0) +
      (if p.b == k then 3 else 0) + (if r == k then 1 else 0) - (if u == k then 1 else 0)) 0
    decide (lhs = (4*c.a.items.count k + 12*c.b.items.count k + 2*m.count k : Nat)))

def reflectedCorners :=
  (List.range 4).all fun i => (List.range 4).all fun j =>
    let (v,r,u) := atVertex frame i j
    let i' := (4-i)%4
    let j' := (4-j)%4
    atVertex frame.reflectI i' j == (⟨v.a,v.b,u,r⟩,v.s,v.t) &&
    atVertex frame.reflectJ i j' == (⟨v.a,v.b,r,u⟩,v.t,v.s) &&
    atVertex frame.transpose j i == (⟨v.b,v.a,v.s,v.t⟩,r,u)

theorem graph_incidence :
    bagEq (leftTags frame) (rightTags frame) = true ∧
    frame.orbit.all (fun c => bagEq (rightTags c) (rightTags frame) &&
      bagEq c.labels frame.labels && phaseIncidence c) = true ∧
    reflectedCorners = true := by decide
#print axioms graph_incidence


