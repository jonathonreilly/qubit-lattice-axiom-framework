/-! Contract four adjacent columns on the torus. In a vertex overlap the
    square-root factor is sqrt(leftSq r * rightSq u). Across the torus
    the left and right factors are the same multiset of positive edge
    triangles and face dimensions. Their product reduces to ∏ rightSq. -/
def localWeight (v : Vertex) (r u : Nat) (mark : Bool) : Fr :=
  (v.rightSq u).mul (if mark then v.mark r u else v.racah r u)

def sliceWeight (a : Col) (b : Nat) (p q : Col) (mark : Bool) : Fr :=
  (List.range 4).foldl (fun acc j =>
    let v : Vertex := ⟨a.get j,b,p.get j,q.get (j+3)⟩
    acc.mul (localWeight v (p.get (j+3)) (q.get j) (mark && j == 0))) (integer (b+1 : Nat))

def geometry (c : Config) (mark : Bool) : Fr :=
  let capsDim : Nat := c.a.items.foldl (fun n a => n*(a+1)) 1
  (List.range 4).foldl (fun acc i => acc.mul
    (sliceWeight c.a (c.b.get i) (c.m.get (i+3)) (c.m.get i) (mark && i == 0)))
    (integer capsDim)

/-- Base 25 encodes multiplicities without collision: each of the 24
    faces occurs once. The empty monomial has key zero. -/
def spinKey (n : Nat) := if n == 0 then 0 else 25^(n-1)
def keyOf (c : Config) := c.labels.foldl (fun k n => k+spinKey n) 0

structure Bin where
  key : Nat
  weight : Fr
  deriving BEq, Repr

abbrev Histogram := List Bin

/-- A row is created on its first nonzero summand and kept if later
    summands cancel. An individually vanishing diagram creates no row. -/
def place (k : Nat) (q : Fr) : Histogram → Histogram
  | [] => [⟨k,q⟩]
  | b::bs => if b.key == k then ⟨k,b.weight.add q⟩::bs else b::place k q bs

def grouped (cs : List Config) (mark : Bool) : Histogram :=
  cs.foldl (fun bins c =>
    let q := geometry c mark
    if q.n = 0 then bins else place (keyOf c) q bins) []

def sameBins (xs ys : Histogram) : Bool :=
  xs.length == ys.length && xs.length == (xs.map Bin.key).eraseDups.length &&
  ys.length == (ys.map Bin.key).eraseDups.length &&
  xs.all (fun b => ys.any (fun t => b.key == t.key && b.weight.same t.weight))

/-- An explicit check of orbit weighting uses the labelled members too. -/
def orbitAgreement (mark : Bool) (c : Config) : Bool :=
  c.orbit.all fun x => keyOf x == keyOf c && (geometry x mark).same (geometry c mark)

def groupedOrbits (cs : List Config) (mark : Bool) : Histogram :=
  cs.foldl (fun bins c =>
    let q := (geometry c mark).scale c.orbit.length
    if q.n = 0 then bins else place (keyOf c) q bins) []

/-- Row 1432's tuple order is counts of labels 1 through 7, followed by
    signed numerator and positive denominator. -/
def ringRow (e1 e2 e3 e4 e5 e6 e7 : Nat) (n : Int) (d : Nat) : Bin :=
  ⟨e1+25*(e2+25*(e3+25*(e4+25*(e5+25*(e6+25*e7))))),⟨n,d⟩⟩



def markedLeading : Histogram := [
  ringRow 16 2 0 0 0 0 0 10 1,
  ringRow 12 4 0 0 0 0 0 40 1,
  ringRow 10 5 0 0 0 0 0 (-160) 3,
  ringRow 0 10 0 0 0 0 0 60 1]

theorem leading_orbit_histogram :
    sameBins (grouped leadingSupports true) markedLeading = true ∧
    sameBins (groupedOrbits reps true) markedLeading = true ∧
    reps.all (orbitAgreement true) = true := by decide
#print axioms leading_orbit_histogram


