/-- Free word cancellation uses Q times its conjugate. The diagonal terms
    give the squared norm and the mixed terms cancel in opposite pairs. -/
def normTerms (a b : Int) : Bool :=
  if a == b then qBasisMul a (qConj b) == 1 && qBasisMul (qConj a) b == 1
  else qBasisMul a (qConj b) == -(qBasisMul b (qConj a)) &&
       qBasisMul (qConj a) b == -(qBasisMul (qConj b) a)

def raisedMoment (e : Col) (i : Nat) :=
  sphereMono (four fun j => e.get j + (if i == j then 2 else 0))

theorem sphere_word_identities :
    (exponentTuples 2).all (fun e =>
      ((List.range 4).foldl (fun z i => z.add (raisedMoment e i)) (integer 0)).same (sphereMono e)) = true ∧
    qBasis.all (fun a => re (qConj a) == re a && qBasis.all (fun b =>
      normTerms a b && re (qBasisMul a b) == re (qBasisMul b a) &&
      qConj (qBasisMul a b) == qBasisMul (qConj b) (qConj a) &&
      qBasis.all (fun c => qBasisMul a (qBasisMul b c) == qBasisMul (qBasisMul a b) c))) = true := by decide
#print axioms sphere_word_identities


