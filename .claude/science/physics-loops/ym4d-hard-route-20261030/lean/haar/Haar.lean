namespace Haar

/-- Bits 0 and 1 reflect the two rooted circuits after the optional
    transposition in bit 2. The encoding matches gridOrbit. -/
def rootAction (g : Nat) (c : Config) : Config :=
  let x := if g / 4 == 1 then c.transpose else c
  let y := if g % 2 == 1 then x.reflectI else x
  if (g/2)%2 == 1 then y.reflectJ else y

def rootGroup := List.range 8
def groupFrames := rootGroup.map fun g => rootAction g frame

def groupProduct (a b : Nat) := groupFrames.idxOf (rootAction a (rootAction b frame))

/-- Use a proposed table only after evaluating the composed permutations
    on the 24 distinct positions of the frame. -/
def rootTable : List (List Nat) :=
  (List.range 8).map fun g => (List.range 8).map fun h =>
    let s := g/4
    let u := h%2
    let v := (h/2)%2
    let l := (g%2) ^^^ (if s == 1 then v else u)
    let k := ((g/2)%2) ^^^ (if s == 1 then u else v)
    l+2*k+4*(s ^^^ (h/4))

def timesRoot (g h : Nat) := (rootTable.getD g []).getD h 8
def bitMembers (k : Nat) := rootGroup.filter fun i => (k >>> i)%2 == 1
def groupBits (xs : List Nat) := xs.foldl (fun b g => b ||| (1 <<< g)) 0

def cosetTest (k : Nat) : Bool :=
  let h := bitMembers k
  if !(h.contains 0 && h.all (fun x => h.all (fun y => h.contains (timesRoot x y)))) then true else
  let cosets := (rootGroup.map fun g => groupBits (h.map (timesRoot g))).eraseDups
  cosets.length*h.length == 8 &&
    cosets.all (fun mask => (bitMembers mask).length == h.length) &&
    rootGroup.all fun g => cosets.countP (fun mask => (bitMembers mask).contains g) == 1

theorem rooted_orbit_multiplicities :
    groupFrames.eraseDups.length = 8 ∧
    rootGroup.all (fun g => rootGroup.all (fun h => timesRoot g h == groupProduct g h)) = true ∧
    rootGroup.all (fun g => rootGroup.any (fun h => timesRoot g h == 0 && timesRoot h g == 0)) = true ∧
    groupFrames.all (fun c => bagEq [c.a.c0,c.b.c0] [frame.a.c0,frame.b.c0]) = true ∧
    (List.range 256).all cosetTest = true := by decide
#print axioms rooted_orbit_multiplicities


end Haar
