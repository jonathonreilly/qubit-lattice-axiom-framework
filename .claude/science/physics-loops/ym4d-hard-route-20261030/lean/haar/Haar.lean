namespace Haar

/-- A leaf checks order within a consecutive list of pages and exposes its
    endpoints. Joining two such lists checks the boundary between them. -/
inductive OrderedPages {data : CheckedSlices} {d : Nat} :
    List (GridPage data d) → Nat → Nat → Prop where
  | leaf (ps lo hi) :
      (ps.head?.map GridPage.first) = some lo →
      (ps.getLast?.map GridPage.last) = some hi →
      disjointGridPages ps = true → OrderedPages ps lo hi
  | join {xs ys lo left right hi} :
      OrderedPages xs lo left → OrderedPages ys right hi →
      left < right → OrderedPages (xs++ys) lo hi


end Haar
