namespace Haar

/-! A directed slice carries four local factors. An entry is usable only
    after its packed signature and all its fields have been checked. -/
inductive QuadTree where
  | leaf (word : Nat)
  | node (a b c d : QuadTree)

def QuadTree.word : QuadTree → Nat → Nat → Nat
  | .leaf n,_,_ => n
  | .node a b c d,i,k =>
    match (i >>> k) % 4 with
    | 0 => a.word i (k-2)
    | 1 => b.word i (k-2)
    | 2 => c.word i (k-2)
    | _ => d.word i (k-2)

structure SliceBank where
  width : Nat
  shift : Nat
  tree : QuadTree
  size : Nat

def SliceBank.entry (db : SliceBank) (i : Nat) : Nat :=
  let w := db.tree.word i db.shift
  (w >>> (db.width*(i%16))) % (1 <<< db.width)

def arcSignature (a b p q : Nat) (root : Bool) :=
  2*(b+64*(q+65536*(p+65536*a)))+(if root then 1 else 0)

def arcSig (w : Nat) := w % (1 <<< 55)
def arcCost (w : Nat) := (w >>> 55) % 256
def arcKey (w : Nat) := (w >>> 63) % (1 <<< 40)
def arcWeight (w : Nat) := unzig (w >>> 103)

def validLocal (v : Vertex) (r u : Nat) :=
  inWindow v r u && triangle v.a v.t r && triangle v.b v.s r &&
    triangle v.b v.t u && triangle v.a v.s u

def verifyArc (db : SliceBank) (i : Nat) : Bool :=
  let w := db.entry i
  let sig := arcSig w
  let root := sig % 2 == 1
  let b := (sig >>> 1) % 64
  let q := readNibbles ((sig >>> 7) % 65536)
  let p := readNibbles ((sig >>> 23) % 65536)
  let a := readNibbles (sig >>> 39)
  let ok := (List.range 4).all fun j =>
    validLocal ⟨a.get j,b,p.get j,q.get (j+3)⟩ (p.get (j+3)) (q.get j)
  let n := scaledSlice a b p q root * (if root then capDim a else 1)
  ok && (!root || (2 ≤ a.c0 && 2 ≤ b)) && arcCost w == b+q.cost+(if root then a.cost else 0) &&
    arcKey w == spinKey b+colKey q+(if root then colKey a else 0) && arcWeight w == n

def sliceChunk (bank : SliceBank) (p : Nat) :=
  (List.range (min 64 (bank.size-64*p))).all fun j => verifyArc bank (64*p+j)

structure CheckedSlices where
  bank : SliceBank
  proof : Span (fun p => sliceChunk bank p = true) 0 ((bank.size+63)/64)

structure RecordedGrid where
  code : Nat
  caps : List Nat

/-- The lower 32 bits name the eight cap spins. Four 18-bit indices name
    the proposed directed slices. Each retrieved signature must match the
    actual adjacent mixed columns, the cap and the unique rooted cut. -/
def recordedTerm (data : CheckedSlices) (d size x y z w : Nat) (record : Nat) : Totals :=
  let b := record % 65536
  let a := (record >>> 16) % 65536
  let i0 := (record >>> 32) % 262144
  let i1 := (record >>> 50) % 262144
  let i2 := (record >>> 68) % 262144
  let i3 := record >>> 86
  let v0 := data.bank.entry i0
  let v1 := data.bank.entry i1
  let v2 := data.bank.entry i2
  let v3 := data.bank.entry i3
  let ok := i0 < data.bank.size && i1 < data.bank.size && i2 < data.bank.size && i3 < data.bank.size &&
    arcSig v0 == arcSignature a (b >>> 12) w x true &&
    arcSig v1 == arcSignature a ((b >>> 8) % 16) x y false &&
    arcSig v2 == arcSignature a ((b >>> 4) % 16) y z false &&
    arcSig v3 == arcSignature a (b % 16) z w false &&
    arcCost v0 + arcCost v1 + arcCost v2 + arcCost v3 == d
  let n := (size : Int)*arcWeight v0*arcWeight v1*arcWeight v2*arcWeight v3
  let k := arcKey v0+arcKey v1+arcKey v2+arcKey v3
  ⟨size,ok,if n == 0 then [] else [⟨k,n⟩]⟩

def gridResult (data : CheckedSlices) (d : Nat) (g : RecordedGrid) : Totals :=
  let k := g.code
  let orbit := gridOrbit k
  let x := k >>> 48
  let y := (k >>> 32) % 65536
  let z := (k >>> 16) % 65536
  let w := k % 65536
  let good := k < 2^64 && !g.caps.isEmpty && orbit.all (fun q => k ≤ q) &&
    increasing (g.caps.map fun row => row % (1 <<< 32))
  let sum := g.caps.foldl (fun acc row => (recordedTerm data d orbit.length x y z w row).add acc) empty
  ⟨sum.count,good && sum.good,sum.bins⟩

structure GridPage (data : CheckedSlices) (d : Nat) where
  first : Nat
  last : Nat
  grids : List RecordedGrid
  total : Totals
  ordered : (grids.head?.map RecordedGrid.code) = some first ∧
    (grids.getLast?.map RecordedGrid.code) = some last ∧ increasing (grids.map RecordedGrid.code) = true
  checked : sameTotals (addList (grids.map (gridResult data d))) total = true

def GridPage.value {data d} (p : GridPage data d) := p.total

def afterRecordedPage {data d} (prev : Nat) : List (GridPage data d) → Bool
  | [] => true
  | p::ps => prev < p.first && afterRecordedPage p.last ps

def disjointGridPages {data d} : List (GridPage data d) → Bool
  | [] => true
  | p::ps => afterRecordedPage p.last ps


end Haar
