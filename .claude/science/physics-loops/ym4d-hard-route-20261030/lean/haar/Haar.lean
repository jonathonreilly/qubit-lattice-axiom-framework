/-!
Finite SU(2) calculations for the rooted C₄ × C₄ ring, FINISH 1435.
Twice-spins are natural numbers. Trace means one half of the fundamental trace.
All executable definitions used by proofs reduce in the kernel.
-/
namespace Haar

set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option Elab.async false
set_option maxErrors 1

structure Fr where
  n : Int
  d : Nat
  deriving BEq, Repr

def frac (n : Int) (d : Nat) : Fr :=
  let g := n.natAbs.gcd d
  ⟨n / (g : Int), d / g⟩

def integer (n : Int) : Fr := ⟨n, 1⟩
def Fr.add (x y : Fr) := frac (x.n * y.d + y.n * x.d) (x.d * y.d)
def Fr.mul (x y : Fr) := frac (x.n * y.n) (x.d * y.d)
def Fr.scale (x : Fr) (n : Int) := frac (x.n * n) x.d
def Fr.over (x : Fr) (d : Nat) := frac x.n (x.d * d)
def Fr.neg (x : Fr) : Fr := ⟨-x.n, x.d⟩
def Fr.sub (x y : Fr) := x.add y.neg
def Fr.same (x y : Fr) : Bool := x.d != 0 && y.d != 0 && decide (x.n * y.d = y.n * x.d)

def fac : Nat → Nat
  | 0 => 1
  | n+1 => (n+1) * fac n

def binom (n k : Nat) := if k ≤ n then fac n / (fac k * fac (n-k)) else 0

def paritySign (n : Nat) : Int := if n % 2 == 0 then 1 else -1

def through (lo hi : Nat) : List Nat :=
  if lo ≤ hi then (List.range (hi-lo+1)).map (lo + ·) else []

def spins (a b : Nat) : List Nat :=
  (List.range (min a b + 1)).map fun k => (a-b)+(b-a)+2*k

def triangle (a b c : Nat) : Bool :=
  (a-b)+(b-a) ≤ c && c ≤ a+b && (a+b+c)%2 == 0

/-- The square of Racah's triangle factor. -/
def deltaSq (a b c : Nat) : Fr :=
  if triangle a b c then
    let v := (a+b+c)/2
    frac (fac (v-a) * fac (v-b) * fac (v-c) : Nat) (fac (v+1))
  else integer 0

structure Vertex where
  a : Nat
  b : Nat
  t : Nat
  s : Nat
  deriving BEq, Repr

def Vertex.left (v : Vertex) := (spins v.a v.t).filter (triangle v.b v.s)
def Vertex.right (v : Vertex) := (spins v.b v.t).filter (triangle v.a v.s)

def Vertex.leftSq (v : Vertex) (r : Nat) :=
  ((deltaSq v.a v.t r).mul (deltaSq v.b v.s r)).scale (r+1 : Nat)

def Vertex.rightSq (v : Vertex) (u : Nat) :=
  ((deltaSq v.b v.t u).mul (deltaSq v.a v.s u)).scale (u+1 : Nat)

/-- The overlap is this signed Racah sum times sqrt(leftSq r * rightSq u).
    Each factorial quotient is formed as a rational number. -/
def Vertex.racah (v : Vertex) (r u : Nat) : Fr :=
  let ⟨a,b,t,s⟩ := v
  if !(triangle a t r && triangle b s r && triangle b t u && triangle a s u) then
    integer 0
  else
    let x₁ := (a+t+r)/2
    let x₂ := (b+s+r)/2
    let x₃ := (b+t+u)/2
    let x₄ := (a+s+u)/2
    let y₁ := (a+t+b+s)/2
    let y₂ := (a+r+b+u)/2
    let y₃ := (t+r+s+u)/2
    let phase := (a+2*t+3*b+r-u)/2
    let zs := through (max (max x₁ x₂) (max x₃ x₄)) (min y₁ (min y₂ y₃))
    zs.foldl (fun acc z =>
      let d := fac (z-x₁)*fac (z-x₂)*fac (z-x₃)*fac (z-x₄)*
               fac (y₁-z)*fac (y₂-z)*fac (y₃-z)
      acc.add (frac (paritySign (phase+z) * fac (z+1)) d)) (integer 0)

def fourCas (n : Nat) : Int := (n*(n+2) : Nat)

def Vertex.angular (v : Vertex) (r u : Nat) :=
  frac (fourCas v.s + fourCas v.t - fourCas r - fourCas u) 8

/-- Insert X² + X/2 - C_a C_b/3, X=J_a·J_b. Insert both resolutions
    of the identity in X², keeping the external square roots outside. -/
def Vertex.mark (v : Vertex) (r u : Nat) : Fr :=
  let linear := ((v.angular r u).over 2).sub (frac (fourCas v.a * fourCas v.b) 48)
  let start := linear.mul (v.racah r u)
  v.left.foldl (fun acc z =>
    let l := ((v.leftSq z).mul (v.angular z u)).mul (v.racah z u)
    v.right.foldl (fun acc w =>
      let q := ((v.rightSq w).mul (v.angular r w)).mul (v.racah r w)
      acc.add ((l.mul q).mul (v.racah z w))) acc) start

/-! A second calculation uses homogeneous polynomials, with the first
tensor factor to the left of the second in each determinant. Integer
scalings cancel in normalized matrix elements. -/

/-- Coefficient of first-factor index i in the k-th lowered vector for
    V_c → V_a ⊗ V_b, multiplied by c!. The other index is p+k-i.
    Expand (x₁y₂-y₁x₂)^p, then distribute the k lowerings. -/
def embed (a b c k i : Nat) : Int :=
  let p := (a+b-c)/2
  let norm := fac k * fac (c-k)
  let coeff := (List.range (p+1)).foldl (fun (n : Int) e =>
    if e ≤ i && i-e ≤ k then
      let ways := binom p e * binom (a-e) (i-e) * binom (b-(p-e)) (k-(i-e))
      n + paritySign e * ways
    else n) 0
  coeff * norm

/-- Highest vector for the outer coupling. j is the index of its first
    spin, and p-j is the number of lowerings of the intermediate spin. -/
def pathEntry (a t r b s i j : Nat) : Int :=
  let p := (b+r-s)/2
  if j ≤ p then paritySign j * binom p j * embed a t r (p-j) i else 0

structure Site where
  i : Nat
  j : Nat
  k : Nat
  deriving BEq, Repr

def Vertex.sites (v : Vertex) : List Site :=
  let total := (v.a+v.b+v.t-v.s)/2
  (List.range (v.a+1)).flatMap fun i =>
    (List.range (v.b+1)).filterMap fun j =>
      if i+j ≤ total && total-i-j ≤ v.t then some ⟨i,j,total-i-j⟩ else none

def basisWeight (n k : Nat) := fac k * fac (n-k)

def Vertex.inner (v : Vertex) (p q : Nat → Nat → Int) : Int :=
  v.sites.foldl (fun acc x =>
    let weight := basisWeight v.a x.i * basisWeight v.b x.j * basisWeight v.t x.k
    acc + p x.i x.j * q x.i x.j * weight) 0

/-- Coefficient action of 4 J_a·J_b on a polynomial (incoming indices). -/
def Vertex.fourX (v : Vertex) (p : Nat → Nat → Int) (i j : Nat) : Int :=
  let diag := ((v.a : Int)-2*i) * ((v.b : Int)-2*j) * p i j
  let up := if i < v.a && 0 < j then (2*(i+1)*(v.b-j+1) : Nat) * p (i+1) (j-1) else 0
  let down := if 0 < i && j < v.b then (2*(v.a-i+1)*(j+1) : Nat) * p (i-1) (j+1) else 0
  diag + up + down

/-- Compare signs and squared magnitudes after removing all square roots.
    flip deliberately reverses the phase of the proposed overlap. -/
def pathAgrees (v : Vertex) (r u : Nat) (marked : Bool) (flip := false) : Bool :=
  let l := pathEntry v.a v.t r v.b v.s
  let q := fun i j => pathEntry v.b v.t u v.a v.s j i
  let norms := v.inner l l * v.inner q q
  let raw := if marked then
      let x := v.fourX q
      let x₂ := v.fourX x
      v.inner l (fun i j => 3*x₂ i j + 6*x i j - fourCas v.a * fourCas v.b * q i j)
    else v.inner l q
  let den : Nat := if marked then 48 else 1
  let coeff := if marked then v.mark r u else v.racah r u
  let f := if flip then coeff.neg else coeff
  let rad := (v.leftSq r).mul (v.rightSq u)
  0 < norms && 0 < rad.n && 0 < rad.d && 0 < f.d &&
    decide (raw.sign = f.n.sign) &&
    decide (raw^2 * f.d^2 * rad.d = f.n^2 * rad.n * norms * den^2)

/-- These four entries distinguish the ordered paths, their signs and the
    off-diagonal mark. In particular this tests a genuine nonzero phase. -/
theorem path_examples :
    pathAgrees ⟨1,1,1,1⟩ 0 2 false = true ∧
    pathAgrees ⟨1,1,1,1⟩ 2 0 false = true ∧
    pathAgrees ⟨2,2,1,1⟩ 1 1 true = true ∧
    pathAgrees ⟨2,2,1,1⟩ 1 3 true = true := by decide
#print axioms path_examples

theorem rejects_wrong_6j_phase :
    pathAgrees ⟨1,1,1,1⟩ 0 2 false true = false := by decide
#print axioms rejects_wrong_6j_phase

/-- Test all triangle-admissible local entries in a six-label window.
    The global enumeration can subsequently be checked against this window.
    Indices are generated without a list of local cases from the producer. -/
def pathSlice (a b t : Nat) (ss : List Nat) : List (Vertex × Nat × Nat) :=
  ss.flatMap fun s =>
    let v : Vertex := ⟨a,b,t,s⟩
    v.left.flatMap fun r =>
      v.right.filterMap fun u =>
        if r ≤ 7 && u ≤ 7 && a+b+t+s+r+u ≤ 22 then some (v,r,u) else none

def checkPaths (xs : List (Vertex × Nat × Nat)) : Bool :=
  xs.all fun (v,r,u) => pathAgrees v r u false &&
    (v.a < 2 || v.b < 2 || pathAgrees v r u true)


structure Four (α : Type) where
  c0 : α
  c1 : α
  c2 : α
  c3 : α
  deriving BEq, Repr, Inhabited

def Four.get (x : Four α) (i : Nat) :=
  match i % 4 with
  | 0 => x.c0 | 1 => x.c1 | 2 => x.c2 | _ => x.c3

def Four.items (x : Four α) := [x.c0,x.c1,x.c2,x.c3]
def four (f : Nat → α) : Four α := ⟨f 0,f 1,f 2,f 3⟩

abbrev Col := Four Nat

def Col.cost (x : Col) := x.c0+x.c1+x.c2+x.c3
def Col.big (x : Col) := max (max x.c0 x.c1) (max x.c2 x.c3)

structure Config where
  a : Col
  b : Col
  m : Four Col
  deriving BEq, Repr, Inhabited

def Config.labels (c : Config) := c.a.items ++ c.b.items ++ c.m.items.flatMap Four.items
def Config.degree (c : Config) := c.labels.sum

/-- All horizontal circuit labels with the stated upper bound on their sum. -/
def caps (root limit : Nat) : List Col :=
  (through root limit).flatMap fun n =>
    (List.range (limit-n+1)).flatMap fun p =>
      (List.range (limit-n-p+1)).flatMap fun q =>
        (List.range (limit-n-p-q+1)).filterMap fun r =>
          if (n+p+q+r)%2 == 0 then some ⟨n,p,q,r⟩ else none

/-- A mixed column is a closed four-step Clebsch–Gordan path with caps a.
    Its sum is at least max a and at least ceil(sum a / 2). -/
def columns (a : Col) (limit : Nat) : List Col :=
  (List.range (limit+1)).flatMap fun x =>
    (spins x a.c1).flatMap fun y =>
      if x+y > limit then [] else
      (spins y a.c2).flatMap fun z =>
        if x+y+z > limit then [] else
        (spins z a.c3).filterMap fun w =>
          if x+y+z+w ≤ limit && triangle w x a.c0 then some ⟨x,y,z,w⟩ else none

def diff (x y : Nat) := (x-y)+(y-x)

/-- All possible vertical spins on this cut, including the marked floor. -/
def cuts (x y : Col) (root limit : Nat) : List Nat :=
  let i := x.c0+y.c0
  let j := x.c1+y.c1
  let k := x.c2+y.c2
  let l := x.c3+y.c3
  let p := i%2
  if j%2 != p || k%2 != p || l%2 != p then [] else
    let low := max (root+p) (max (max (diff x.c0 y.c0) (diff x.c1 y.c1))
                                  (max (diff x.c2 y.c2) (diff x.c3 y.c3)))
    let high := min limit (min (min i j) (min k l))
    if low > high then [] else (List.range ((high-low)/2+1)).map (fun n => low+2*n)

/-- d is the total of all 24 twice-spins, before removing marked offsets.
    Choose columns 0,3,1,2 in this order so the marked closing cut is fixed
    first. Every list here comes from a nonnegative remaining budget. -/
def configurationsAt (root d : Nat) (a : Col) : List Config :=
  let low := max a.big ((a.cost+1)/2)
  if a.cost+root+4*low > d then [] else
  let cs := columns a (d-a.cost-root-3*low)
  cs.flatMap fun x => cs.flatMap fun w =>
    let paid := a.cost+x.cost+w.cost
    if paid+2*low+root > d then [] else
    (cuts w x root (d-paid-2*low)).flatMap fun b0 =>
      cs.flatMap fun y =>
        let used := paid+b0+y.cost
        if used+low > d then [] else
        (cuts x y 0 (d-used-low)).flatMap fun b1 =>
          cs.flatMap fun z =>
            let base := used+b1+z.cost
            if base > d then [] else
            (cuts y z 0 (d-base)).flatMap fun b2 =>
              (cuts z w 0 (d-base-b2)).map fun b3 => ⟨a,⟨b0,b1,b2,b3⟩,⟨x,y,z,w⟩⟩

def configurations (marked : Bool) (d : Nat) : List Config :=
  let root := if marked then 2 else 0
  (caps root ((d-root)/3)).flatMap (configurationsAt root d)

/-- Reflections fix circuit vertex 0. A face index reverses as 3-i,
    while a vertex (and thus a cap index) reverses as -i modulo four. -/
def Config.reflectI (c : Config) : Config :=
  ⟨c.a, four fun i => c.b.get (4-i), four fun i => c.m.get (3-i)⟩

def Config.transpose (c : Config) : Config :=
  ⟨c.b,c.a,four fun i => four fun j => (c.m.get j).get i⟩

def Config.reflectJ (c : Config) := c.transpose.reflectI.transpose

def Config.orbit (c : Config) : List Config :=
  ([c,c.reflectI,c.reflectJ,c.reflectI.reflectJ].flatMap fun x => [x,x.transpose]).eraseDups

def leadingSupports := configurations true 20

/-- Counts labelled assignments, retaining all zero-weight sectors. -/
theorem leading_support_count :
    leadingSupports.length = 11 ∧ leadingSupports.all (fun c => c.degree == 20) = true := by decide
#print axioms leading_support_count


def ones : Col := ⟨1,1,1,1⟩
def edgeTwo : Col := ⟨0,0,0,2⟩
def capOnly : Col := ⟨2,0,0,0⟩
def capEven : Col := ⟨2,0,0,2⟩
def capOdd : Col := ⟨2,1,0,1⟩

def torusRep : Config := ⟨capOnly,capOnly,⟨ones,ones,ones,ones⟩⟩
def evenRep : Config := ⟨capEven,capEven,⟨edgeTwo,edgeTwo,edgeTwo,⟨2,2,2,0⟩⟩⟩
def mixedRep : Config := ⟨capEven,capOdd,⟨ones,edgeTwo,edgeTwo,ones⟩⟩
def oddRep : Config := ⟨capOdd,capOdd,⟨⟨0,1,1,2⟩,⟨1,0,0,1⟩,⟨1,0,0,1⟩,⟨2,1,1,0⟩⟩⟩
def reps := [mixedRep,evenRep,oddRep,torusRep]

def orbitCover (rs : List Config) : Bool :=
  let images := rs.flatMap Config.orbit
  let actual := leadingSupports
  images.length == images.eraseDups.length && actual.length == actual.eraseDups.length &&
    images.all (fun c => actual.contains c) && actual.all (fun c => images.contains c)

theorem leading_orbits :
    orbitCover reps = true ∧ reps.map (fun c => c.orbit.length) = [4,4,2,1] := by decide
#print axioms leading_orbits

theorem rejects_missing_orbit : orbitCover [mixedRep,evenRep,torusRep] = false := by decide
#print axioms rejects_missing_orbit

/-! The sphere-coordinate functional and its trace-word contraction. -/

def oddFac : Nat → Nat
  | 0 => 1
  | k+1 => (2*k+1) * oddFac k

/-- For exponents 2*k_i this is ∏(2*k_i-1)!! / [2^h (h+1)!]. -/
def sphereMono (e : Col) : Fr :=
  if e.items.any (fun k => k%2 == 1) then integer 0 else
    let h := e.cost/2
    frac (e.items.foldl (fun p n => p*oddFac (n/2)) 1 : Nat) (2^h * fac (h+1))

def removePair (e : Col) (i : Nat) :=
  four fun j => if i == j then e.get j - 2 else e.get j

/-- Choose a distinguished coordinate occurrence. There are e_i-1
    partners with that coordinate. Off-coordinate covariances vanish. -/
def recurrenceAt (e : Col) (i : Nat) :=
  e.get i == 0 || (sphereMono e).same
    (((sphereMono (removePair e i)).scale (e.get i - 1 : Nat)).over (e.cost+2))

def exponentTuples (n : Nat) : List Col :=
  (List.range (n+1)).flatMap fun a => (List.range (n-a+1)).flatMap fun b =>
    (List.range (n-a-b+1)).flatMap fun c =>
      (List.range (n-a-b-c+1)).map fun d => ⟨a,b,c,d⟩

theorem coordinate_pair_recurrence :
    (sphereMono ⟨0,0,0,0⟩).same (integer 1) = true ∧
    (exponentTuples 4).all (fun e => (List.range 4).all (recurrenceAt e)) = true := by decide
#print axioms coordinate_pair_recurrence

/-- Signed basis 1,i,j,k is encoded by ±1,±2,±3,±4. -/
def qBasisMul (x y : Int) : Int :=
  let i := x.natAbs
  let j := y.natAbs
  let val : Int := if i == 1 then j else if j == 1 then i else if i == j then -1
    else (if (i == 2 && j == 3) || (i == 3 && j == 4) || (i == 4 && j == 2)
          then (9-i-j : Nat) else -((9-i-j : Nat) : Int))
  x.sign*y.sign*val

def qConj (x : Int) := if x.natAbs == 1 then x else -x
def re (x : Int) := if x.natAbs == 1 then x else 0
def qBasis : List Int := [1,2,3,4]
def oriented (x : Int) (back : Bool) := if back then qConj x else x

/-- Each sum is four times the second sphere moment. The two identities
    glue occurrences in two different traces, or in a single trace. -/
def twoOccurrenceTest (a b : Int) (i j : Bool) : Bool :=
  let separate := qBasis.foldl (fun z e =>
    z + re (qBasisMul (oriented e i) a) * re (qBasisMul (oriented e j) b)) 0
  let together := qBasis.foldl (fun z e =>
    z + re (qBasisMul (qBasisMul (qBasisMul (oriented e i) a) (oriented e j)) b)) 0
  let joined := re (qBasisMul a (if i == j then qConj b else b))
  decide (separate = joined) &&
    decide (together = if i == j then -2*re (qBasisMul a (qConj b)) else 4*re a*re b)

theorem quaternion_trace_pairing :
    qBasis.all (fun a => qBasis.all (fun b => [false,true].all (fun i =>
      [false,true].all (twoOccurrenceTest a b i)))) = true := by decide
#print axioms quaternion_trace_pairing

abbrev Word := List Int
abbrev Words := List Word
def inverseWord (w : Word) := w.reverse.map Int.neg

def cancel : Word → Int → Word
  | [], e => [e]
  | h::t, e => if h = -e then t else e::h::t

def trimCycle : Nat → Word → Word
  | 0, w => w
  | n+1, h::t => if t.getLast? = some (-h) then trimCycle n t.dropLast else h::t
  | _+1, [] => []

def wordLT : Word → Word → Bool
  | [], _::_ => true
  | [], [] | _::_, [] => false
  | a::s, b::t => if a = b then wordLT s t else a < b

def leastRotation (w : Word) : Word :=
  (List.range w.length).foldl (fun best k =>
    let q := w.drop k ++ w.take k
    if wordLT q best then q else best) w

/-- Real traces are cyclic and unchanged by reversing and inverting a word. -/
def normalWord (w : Word) :=
  let v := trimCycle w.length (w.foldl cancel []).reverse
  let a := leastRotation v
  let b := leastRotation (inverseWord v)
  if wordLT a b then a else b

def normalWords (ws : Words) : Words :=
  let rec insert (w : Word) : Words → Words
    | [] => [w]
    | v::vs => if wordLT w v then w::v::vs else v::insert w vs
  ws.foldl (fun acc w => let v := normalWord w; if v.isEmpty then acc else insert v acc) []

structure Occ where
  before : Word
  letter : Int
  after : Word

def occurrences (e : Nat) (w : Word) : List Occ :=
  let rec scan (rev : Word) : Word → List Occ
    | [] => []
    | k::ks =>
      let rest := scan (k::rev) ks
      if k.natAbs == e then ⟨rev.reverse,k,ks⟩::rest else rest
  scan [] w

def focus {α : Type} : List α → List (α × List α)
  | [] => []
  | x::xs => (x,xs)::(focus xs).map fun (y,ys) => (y,x::ys)

def increment : Nat → List Nat → List Nat
  | _, [] => []
  | 0, n::ns => (n+1)::ns
  | k+1, n::ns => n::increment k ns

def bondCounts (ws : Words) : List Nat :=
  ws.foldl (fun cs w => w.foldl (fun a e => increment e.natAbs a) cs)
    (List.replicate 33 0)

def nextBond (cs : List Nat) : Nat :=
  (through 1 32).foldl (fun best e =>
    let n := cs[e]?.getD 0
    if 0 < n && (best == 0 || n < cs[best]?.getD 0) then e else best) 0

/-- Coefficients are in units of 1/4 before the sphere recursion factor
    4/(n+2). Merge identical children before doing the next contraction. -/
def collect (w : Words) (k : Int) : List (Words × Int) → List (Words × Int)
  | [] => [(w,k)]
  | (v,n)::rest => if w = v then (v,n+k)::rest else (v,n)::collect w k rest

def contractions (ws : Words) (e : Nat) : List (Words × Int) :=
  match (focus ws).findSome? (fun (w,others) =>
      (occurrences e w).head?.map (fun p => (p,others))) with
  | none => []
  | some (p,rest) =>
    let a := p.after ++ p.before
    let joined := (occurrences e a).foldl (fun out q =>
      if p.letter = q.letter then
        collect (normalWords ((q.before ++ inverseWord q.after)::rest)) (-2) out
      else collect (normalWords (q.before::q.after::rest)) 4 out) []
    (focus rest).foldl (fun out (w,others) =>
      (occurrences e w).foldl (fun out q =>
        let b := q.after ++ q.before
        let v := a ++ (if p.letter = q.letter then inverseWord b else b)
        collect (normalWords (v::others)) 1 out) out) joined

def xBond (i j : Nat) : Int := (1+4*(i%4)+j%4 : Nat)
def yBond (i j : Nat) : Int := (17+4*(i%4)+j%4 : Nat)
def mixedFace (i j : Nat) : Word :=
  [xBond i j,yBond (i+1) j,-xBond i (j+1),-yBond i j]
def hFace (j : Nat) : Word := (List.range 4).map fun i => xBond i j
def vFace (i : Nat) : Word := (List.range 4).map fun j => yBond i j

def taylorFaces (c : Config) : List (Word × Nat) :=
  ((List.range 4).flatMap fun i => (List.range 4).map fun j =>
    (mixedFace i j,(c.m.get i).get j)) ++
  ((List.range 4).map fun j => (hFace j,c.a.get j - (if j == 0 then 2 else 0))) ++
  ((List.range 4).map fun i => (vFace i,c.b.get i - (if i == 0 then 2 else 0)))

def insertions : List (Words × Int) :=
  let h := hFace 0
  let k := vFace 0
  [([h++k++inverseWord h++inverseWord k],3),([],1),([h,h],-4),([k,k],-4),([h,h,k,k],4)]

def taylorWords (c : Config) : Words :=
  (taylorFaces c).flatMap fun (w,n) => List.replicate n w

def maxFourOccurrences (c : Config) : Bool :=
  insertions.all fun (extra,_) =>
    let ws := taylorWords c ++ extra
    ws.all (fun w => w.all (fun e => 1 ≤ e.natAbs && e.natAbs ≤ 32)) &&
      (bondCounts ws).all (fun n => n ≤ 4)

/-- All input words meet the degree range of the monomial recurrence. -/
theorem sphere_coordinate_range :
    leadingSupports.all maxFourOccurrences = true := by decide
#print axioms sphere_coordinate_range


structure Rule where
  divisor : Nat
  constant : Int
  children : List (Words × Int)
  deriving DecidableEq

/-- A rule for one integral of trace words. Invalid nonempty states have
    divisor zero. Every child removes at least the two selected letters. -/
def traceRule : Words → Rule
  | [] => ⟨1,1,[]⟩
  | w::ws =>
    let counts := bondCounts (w::ws)
    if counts.any (fun n => n%2 != 0) then ⟨1,0,[]⟩ else
      let e := nextBond counts
      if e == 0 then ⟨0,0,[]⟩ else
        ⟨counts[e]?.getD 0 + 2,0,(contractions (w::ws) e).filter (fun p => decide (p.2 ≠ 0))⟩

/- Finite derivations of the monomial recurrence. A parent records all
    children computed by traceRule. Each child's value has a derivation. -/
mutual
  inductive TraceValue : Words → Fr → Prop where
    | step {w q d b kids total} :
      traceRule w = ⟨d,b,kids⟩ → TraceSum kids total →
      (((integer b).add total).over d).same q = true → TraceValue w q
  inductive TraceSum : List (Words × Int) → Fr → Prop where
    | nil : TraceSum [] (integer 0)
    | cons {k w q rest total} : TraceValue w q → TraceSum rest total →
        TraceSum ((w,k)::rest) ((q.scale k).add total)
end

structure CertifiedTrace where
  words : Words
  value : Fr
  proof : TraceValue words value

abbrev Children := List (CertifiedTrace × Int)
def childKeys (xs : Children) := xs.map fun (t,k) => (t.words,k)
def childTotal : Children → Fr
  | [] => integer 0
  | (t,k)::xs => (t.value.scale k).add (childTotal xs)

theorem childProof : (xs : Children) → TraceSum (childKeys xs) (childTotal xs)
  | [] => .nil
  | (t,_)::xs => .cons t.proof (childProof xs)

#print axioms childProof

def certifyTrace (w : Words) (q : Fr) (d : Nat) (base : Int) (kids : Children)
    (rule : traceRule w = ⟨d,base,childKeys kids⟩)
    (value : (((integer base).add (childTotal kids)).over d).same q = true) : CertifiedTrace :=
  ⟨w,q,.step rule (childProof kids) value⟩

def fixtureKeys (c : Config) :=
  insertions.map fun (v,k) => (normalWords (taylorWords c ++ v),k)

def taylorDenom (c : Config) := (taylorFaces c).foldl (fun n p => n * fac p.2) 6

def SphereValue (c : Config) (q : Fr) : Prop :=
  ∃ total, TraceSum (fixtureKeys c) total ∧ (total.over (taylorDenom c)).same q = true

theorem certifySphere (c : Config) (q : Fr) (kids : Children)
    (keys : fixtureKeys c = childKeys kids)
    (value : ((childTotal kids).over (taylorDenom c)).same q = true) : SphereValue c q :=
  ⟨childTotal kids, keys ▸ childProof kids, value⟩


#print axioms certifySphere

/-- Logical conjunction indexed by the half-open interval [0,n). -/
def AllBelow (P : Nat → Prop) : Nat → Prop
  | 0 => True
  | n+1 => P n ∧ AllBelow P n

