/-! Conditional moment bounds. Each continuous angle cell has width 1/1024.
    All signed operations below round outward on the producer's 112-bit grid.
    The coefficient tables are supplied as literals and checked from their
    Taylor polynomials before they are used on the 2,048 angle cells. -/

def unit112 : Bounds := ⟨scale112,scale112⟩
def zeroBox : Bounds := ⟨0,0⟩
def Bounds.timesN (x : Bounds) (n : Nat) : Bounds := ⟨x.lo*n, x.hi*n⟩
def Bounds.mul112 (x y : Bounds) : Bounds :=
  let a := x.lo*y.lo
  let b := x.lo*y.hi
  let c := x.hi*y.lo
  let d := x.hi*y.hi
  ⟨min (min a b) (min c d) / (scale112 : Int),
   -((-max (max a b) (max c d)) / (scale112 : Int))⟩

def as112 (lo hi : Int) (den : Nat) : Bounds := roundOut ⟨lo,den⟩ ⟨hi,den⟩ scale112

def condWeights (r n : Nat) : Bounds :=
  let loN := scalarLo n r 256 * seriesDen 0 256
  let loD := seriesDen n 256 * scalarHi 0 r 256
  let hiN := scalarHi n r 256 * seriesDen 0 256
  let hiD := seriesDen n 256 * scalarLo 0 r 256
  ⟨scale112*(n+1)*loN^2 / loD^2, ceilN (scale112*(n+1)*hiN^2) (hiD^2)⟩

def condScalar (n p q : Nat) : Bounds := as112 (scalarLo n p q) (scalarHi n (p+1) q) (seriesDen n q)
def condDerivative (n p q : Nat) : Bounds :=
  let e : Int := (2*(6*33+n*(n-1))+12)*firstOmitted n (p+1)
  let lo : Int := (seriesNum .pos n p q : Int) - (seriesNum .neg n (p+1) q : Int) - e
  let hi : Int := (seriesNum .pos n (p+1) q : Int) - (seriesNum .neg n p q : Int) + e
  as112 lo hi (seriesDen n q)

/-- Symmetric tail of β² Z, β² W₁ and β² D beyond n=20. -/
def condTail (r : Nat) : Nat :=
  ceilN (scale112*4*513^2*r^42) (256^2*512^42*(fac 21)^2)

structure CondTable where
  coeff : List (Bounds × Bounds)  -- (a_n L_n, a_n [3β L'_n − n(n+2)L_n])
  beta2 : Bounds
  tail : Nat
  eta : Nat
  xi : Nat
  w : Nat

def condInput (d j : Nat) (c : CondTable) : Bool :=
  let r := (d-2)*513
  let q := 1024
  let p := 2*q+j
  let coeff := (List.range 21).map fun n =>
    let weight := condWeights r n
    (weight.mul112 (condScalar n p q), weight.mul112 (condDerivative n p q))
  decide (c.coeff = coeff) && decide (c.beta2 = as112 (p^2 : Nat) ((p+1)^2 : Nat) (q^2)) &&
  c.tail == condTail r && r^2 ≤ 2*22^2*256^2 &&
  (if d == 4 then c.eta == 1450 && c.xi == 1037 && c.w == 5047
   else d == 5 && c.eta == 2934 && c.xi == 2269 && c.w == 4354)

structure Jet where
  value : Bounds
  first : Bounds
  second : Bounds

def angleJets (u : Bounds) : Nat → Jet → Jet → List (Bounds × Bounds)
  | 0, _, _ => []
  | n+1, prev, cur =>
    let next : Jet :=
      ⟨((u.mul112 cur.value).timesN 2).sub prev.value,
       (((u.mul112 cur.first).timesN 2).add (cur.value.timesN 2)).sub prev.first,
       (((u.mul112 cur.second).timesN 2).add (cur.first.timesN 4)).sub prev.second⟩
    (cur.value, cur.second) :: angleJets u n cur next

structure CondSums where
  z : Bounds
  w : Bounds
  a : Bounds

def condBox (angle : Bounds) (jets : List (Bounds × Bounds)) (c : CondTable) : Bool :=
  let sums := (c.coeff.zip jets).foldl (fun (s : CondSums) ((v,b),p,p2) =>
    ⟨s.z.add (v.mul112 p), s.w.add (b.mul112 p), s.a.add (v.mul112 p2)⟩) ⟨zeroBox,zeroBox,zeroBox⟩
  let a := (angle.mul112 sums.a).widen c.tail
  let w := sums.w.widen c.tail
  let z := (c.beta2.mul112 sums.z).widen c.tail
  0 < w.lo && 0 < z.lo && 10000*a.hi ≤ (c.eta : Int)*w.lo &&
    10000*a.hi ≤ (c.xi : Int)*z.lo && (c.w : Int)*z.hi ≤ 10000*w.lo

/-- Integer endpoints on the very same 2,048-cell angle grid as the producer.
    A wider certified rectangle supplies bounds on each listed fine rectangle. -/
def angleInterval (start width : Nat) : Bounds :=
  let step : Int := (scale112/1024 : Nat)
  ⟨((start : Int)-1024)*step, ((start : Int)+(width : Int)-1024)*step⟩

def angleBlock (tables : List CondTable) (start width : Nat) : Bool :=
  let u := angleInterval start width
  let jets := angleJets u 21 ⟨zeroBox,zeroBox,zeroBox⟩ ⟨unit112,zeroBox,zeroBox⟩
  0 < width && start+width ≤ 2048 &&
    (List.range width).all (fun i => inside (angleInterval (start+i) 1) u) &&
    tables.all (condBox (unit112.sub (u.mul112 u)) jets)

def AngleCover (tables : List CondTable) (total : Nat) : Nat → List Nat → Prop
  | start, [] => start = total
  | start, width :: rest => angleBlock tables start width = true ∧
      AngleCover tables total (start+width) rest

