def inside (x y : Bounds) : Bool := y.lo ≤ x.lo && x.lo ≤ x.hi && x.hi ≤ y.hi

/-! Positive Taylor coefficients. For x=p/q, term k is
    (p/(2q))^(n+2k)/(k! (n+k+1)!). Use one common denominator at k=33.
    Horner's recurrence below changes the denominator by (2q)^2 k (n+k+1)
    before adding the next numerator. Weights select the positive and negative
    parts of 6k+n(1-n) for the conditional derivative. -/

def fac : Nat → Nat
  | 0 => 1
  | k+1 => (k+1)*fac k

inductive Weight | value | pos | neg

def Weight.at (w : Weight) (n k : Nat) : Nat :=
  match w with
  | .value => 1
  | .pos => 6*k + n - n*n
  | .neg => n*n - (6*k + n)

def seriesAcc (w : Weight) (n x y : Nat) : Nat → Nat
  | 0 => w.at n 0
  | k+1 => seriesAcc w n x y k * (y*(k+1)*(n+k+2)) + w.at n (k+1)*x^(k+1)

/-- Denominator and numerator of the k=0,...,32 polynomial at p/q. -/
def seriesDen (n q : Nat) := (2*q)^(n+66)*fac 33*fac (n+34)
def seriesNum (w : Weight) (n p q : Nat) :=
  p^n * seriesAcc w n (p^2) ((2*q)^2) 32 * ((2*q)^2*33*(n+34))
def firstOmitted (n p : Nat) := p^(n+66)
def scalarLo (n p q : Nat) := seriesNum .value n p q
def scalarHi (n p q : Nat) := scalarLo n p q + 2*firstOmitted n p

/-- L_n/L_0 over [p/q,(p+h)/q], rounded outwards on the specified grid.
    The positive-series remainder majorant is twice the first omitted term. -/
def lambdaLo (scale n p h q : Nat) : Nat :=
  scale * scalarLo n p q * seriesDen 0 q /
    (seriesDen n q * scalarHi 0 (p+h) q)
def lambdaHi (scale n p h q : Nat) : Nat :=
  ceilN (scale * scalarHi n (p+h) q * seriesDen 0 q)
    (seriesDen n q * scalarLo 0 p q)

def scale112 : Nat := 2^112
def scale80 : Nat := 2^80

/-- The largest argument used is the 5D boundary radius 3·513/256.
    At k=33 the next scalar term costs at most half its predecessor, even
    for n=0. The derivative weights grow by at most six per step. -/
theorem scalar_tail_ratio : (3*513)^2 ≤ 2*34*35*256^2 := by decide

#print axioms scalar_tail_ratio

/-- A histogram lists multiplicities in increasing order of twice-spin 1,...,7.
    The last two integers denote its exact signed rational coefficient. -/
structure Hist where
  e1 : Nat
  e2 : Nat
  e3 : Nat
  e4 : Nat
  e5 : Nat
  e6 : Nat
  e7 : Nat
  num : Int
  den : Nat

def Hist.degree (h : Hist) : Nat :=
  h.e1 + 2*h.e2 + 3*h.e3 + 4*h.e4 + 5*h.e5 + 6*h.e6 + 7*h.e7

def Hist.leading (h : Hist) : Fr :=
  ⟨16*h.num, h.den * 2^h.degree *
    (fac 2)^h.e1 * (fac 3)^h.e2 * (fac 4)^h.e3 * (fac 5)^h.e4 *
    (fac 6)^h.e5 * (fac 7)^h.e6 * (fac 8)^h.e7⟩

def histLeading (hs : List Hist) : Fr :=
  hs.foldl (fun a h => if h.degree == 20 then a.add h.leading else a) ⟨0,1⟩

