/-! Histogram evaluation. A cell has a common positive scale 2^112. The marked
    prefactor has the same scale. Homogenizing every monomial to 24 faces gives
    a single exact integer sum, with no internal rounding. A positive coefficient
    uses lower endpoints for the lower sum. A negative one uses upper endpoints.
    The common denominator of the signed coefficients divides D. -/

structure Point where
  x1 : Nat
  x2 : Nat
  x3 : Nat
  x4 : Nat
  x5 : Nat
  x6 : Nat
  x7 : Nat
  deriving DecidableEq

structure Cell where
  lo : Point
  hi : Point
  flo : Nat
  fhi : Nat
  deriving DecidableEq

def Hist.arity (h : Hist) := h.e1+h.e2+h.e3+h.e4+h.e5+h.e6+h.e7
def markedD : Nat := 6298560000
def vacuumD : Nat := 9

theorem monomial_denominators :
    markedChunks.all (·.all (fun h => h.arity ≤ 24 && markedD % h.den == 0)) = true ∧
    vacuumChunks.all (·.all (fun h => h.arity ≤ 24 && vacuumD % h.den == 0)) = true := by decide

#print axioms monomial_denominators

def monomial (x : Point) (h : Hist) : Nat :=
  x.x1^h.e1*x.x2^h.e2*x.x3^h.e3*x.x4^h.e4*x.x5^h.e5*x.x6^h.e6*x.x7^h.e7 *
    2^(112*(24-h.arity))

def signedTerm (d : Nat) (cell : Cell) (lower : Bool) (h : Hist) : Int :=
  let down := if h.num < 0 then !lower else lower
  let value := if down then monomial cell.lo h * cell.flo else monomial cell.hi h * cell.fhi
  h.num * (d / h.den * value : Nat)

def cellSide (chunks : List (List Hist)) (d : Nat) (c : Cell) (lower : Bool) : Int :=
  chunks.foldl (fun acc rows => rows.foldl (fun b h => b + signedTerm d c lower h) acc) 0

def evaluateCell (chunks : List (List Hist)) (d : Nat) (c : Cell) : Bounds :=
  let den := d*scale112^25
  roundOut ⟨cellSide chunks d c true, den⟩ ⟨cellSide chunks d c false, den⟩ (10^15)

def endpointVector (marked : Bool) (f : Nat → Nat) : Point :=
  ⟨f 1, f 2, f 3, f 4, if marked then f 5 else 0, if marked then f 6 else 0,
   if marked then f 7 else 0⟩

/-- Every endpoint witness is checked against the exact k=32 polynomial and its
    rational remainder. For the ordinary histogram only indices 1,...,4 occur. -/
def validCell (marked : Bool) (count j : Nat) (c : Cell) : Bool :=
  let q := 256*count
  let p := 2*q+j
  decide (c.lo = endpointVector marked (fun n => lambdaLo scale112 n p 1 q)) &&
  decide (c.hi = endpointVector marked (fun n => lambdaHi scale112 n p 1 q)) &&
  c.flo == (if marked then 16*scale112*q^4 / (p+1)^4 else scale112) &&
  c.fhi == (if marked then ceilN (16*scale112*q^4) (p^4) else scale112)

def checkCells (marked : Bool) (start : Nat) (cs : List Cell) : Bool :=
  let count := if marked then 512 else 128
  let hs := if marked then markedChunks else vacuumChunks
  let d := if marked then markedD else vacuumD
  let target := if marked then markedCore else vacuumCore
  cs.zipIdx.all fun (c,i) =>
    validCell marked count (start+i) c && inside (evaluateCell hs d c) target

/-- Checked consecutive blocks, with the terminal endpoint included. -/
def MeshCover (marked : Bool) (total : Nat) : Nat → List (List Cell) → Prop
  | start, [] => start = total
  | start, cs :: rest => checkCells marked start cs = true ∧
      MeshCover marked total (start + cs.length) rest

theorem vacuum_uses_four_spins :
    vacuumChunks.all (·.all (fun h => h.e5+h.e6+h.e7 == 0)) = true := by decide

#print axioms vacuum_uses_four_spins

/-! Circle certificates at radii p/4. B, P, P_Q, S₀, E, α and E₅
    use scale 2^80. The unrounded λ_n t^n and M use circleScale; mq4
    represents 4 M_Q on that scale. The upper square root uses 2^56. -/

structure CircleData where
  p : Nat
  b : List Nat
  alpha : List Nat
  e : Nat
  s0 : Nat
  pNorm : Nat
  pq : Nat
  m : Nat
  mq4 : Nat
  e5 : Nat
  root : Nat

def circleScale := scale80*4^24
def sumN (xs : List Nat) := xs.foldl (· + ·) 0
def maxN (xs : List Nat) (a : Nat) := xs.foldl max a

def triangleAdmits (m n k : Nat) : Bool :=
  m ≤ n+k && n ≤ m+k && k ≤ m+n && (m+n+k) % 2 == 0

def alphaUp (bs : List Nat) (k : Nat) : Nat :=
  let sum := bs.zipIdx.foldl (fun a (bm,m) =>
    bs.zipIdx.foldl (fun v (bn,n) =>
      if triangleAdmits m n k then v+bm*bn else v) a) 0
  ceilN sum (scale80*(k+1))

def circleSpinData (x : CircleData) (capped : List Nat) : Bool :=
  let ll := capped.zipIdx.map fun (v,n) => v*x.p^n*4^(24-n)
  let b := ll.zipIdx.map fun (v,n) => ceilN ((n+1)*v*scale80) circleScale
  let e := ceilN (scale80*2*26^4*(513*x.p)^25) ((256*2*4)^25*fac 25)
  2*513*x.p*27^4 ≤ (256*2*4)*26^5 &&
  decide (x.b = b) && x.e == e &&
  x.s0 == sumN (x.b.zipIdx.map fun (v,n) => (n+1)*v) &&
  x.pNorm == ceilN (sumN (x.b.map (·^2)) + e^2) scale80 &&
  x.pq == ceilN (sumN (x.b.zipIdx.map fun (v,n) => (n*(n+2)*v)^2) + 16*e^2)
    (16*scale80) &&
  x.m == maxN ll (e*4^24) &&
  x.mq4 == maxN (ll.zipIdx.map fun (v,n) => n*(n+2)*v) (4*e*4^24)

def alphaBlock (x : CircleData) (start count : Nat) : Bool :=
  decide ((x.alpha.drop start).take count =
    (List.range count).map (fun i => alphaUp x.b (start+i)))

def AlphaCover (x : CircleData) : Nat → List Nat → Prop
  | start, [] => start = 49 ∧ start = x.alpha.length
  | start, count :: rest => alphaBlock x start count = true ∧
      AlphaCover x (start+count) rest

def fifthMomentCheck (x : CircleData) : Bool :=
  x.e5 == ceilN (scale80 * sumN (x.alpha.zipIdx.map fun (v,k) => (k+1)^2*v^5) +
    5*x.pNorm^4*(2*x.s0+x.e)*x.e) (scale80^5)

def ConvolutionChecked (x : CircleData) : Prop :=
  AlphaCover x 0 [7,7,7,7,7,7,7] ∧ fifthMomentCheck x = true

def rootWitness (x : CircleData) : Bool :=
  let b := ceilN (x.pNorm*x.pq*2^112) (scale80^2)
  0 < x.root && (x.root-1)^2 ≤ b && b < x.root^2

def markedCircleValue (x : CircleData) : Nat :=
  ceilN (x.m^11*x.mq4*x.root*x.e5) (4*circleScale^12*2^56*scale80)

def vacuumCircleValue (x : CircleData) : Nat :=
  ceilN (x.m^12*x.pNorm*x.e5) (circleScale^12*scale80^2)

