import Init

/-! Exact finite arithmetic for row 1425, on the coupling band [2,513/256].
    Only the imported kernel's integer operations are needed. All interval data
    have explicit positive denominators. The Haar identifications are recorded
    separately in the row 1432 report. Read `finite_ring_replay` with
    `histogram_leading_sum`, `conditional_input_tables` and `five_dimensional_division`.
    The marked and ordinary histogram streams are groups42.txt and vacuum28.txt.
    Their complete SHA-256 digests and the toolchain are in the accompanying report. -/
namespace Ring1425

set_option Elab.async false
set_option maxRecDepth 20000
set_option maxHeartbeats 0
set_option exponentiation.threshold 100000

/-- Integer endpoints on a common scale. -/
structure Bounds where
  lo : Int
  hi : Int
  deriving DecidableEq, Repr

namespace Bounds

def add (x y : Bounds) : Bounds := ⟨x.lo + y.lo, x.hi + y.hi⟩
def sub (x y : Bounds) : Bounds := ⟨x.lo - y.hi, x.hi - y.lo⟩
def neg (x : Bounds) : Bounds := ⟨-x.hi, -x.lo⟩
def widen (x : Bounds) (e : Nat) : Bounds := ⟨x.lo - e, x.hi + e⟩

end Bounds

/-- An unreduced signed fraction. `same` compares values by cross multiplication. -/
structure Fr where
  num : Int
  den : Nat
  deriving Repr

namespace Fr

def same (x y : Fr) : Bool :=
  x.den > 0 && y.den > 0 && decide (x.num * (y.den : Int) = y.num * (x.den : Int))
def le (x y : Fr) : Bool := x.num * (y.den : Int) ≤ y.num * (x.den : Int)
def mul (x y : Fr) : Fr := ⟨x.num * y.num, x.den * y.den⟩
def add (x y : Fr) : Fr := ⟨x.num * y.den + y.num * x.den, x.den * y.den⟩
def floorAt (x : Fr) (s : Nat) : Int := x.num * s / (x.den : Int)
def ceilAt (x : Fr) (s : Nat) : Int := -((-x.num * s) / (x.den : Int))
def least (x y : Fr) : Fr := if x.le y then x else y
def greatest (x y : Fr) : Fr := if x.le y then y else x

end Fr

def roundOut (lo hi : Fr) (s : Nat) : Bounds := ⟨lo.floorAt s, hi.ceilAt s⟩

def ceilN (a b : Nat) : Nat := (a + b - 1) / b

/-- Remainder of an even series: s M (q/p)^first / (1-(q/p)^2). -/
def evenTail (s M p q first : Nat) : Nat :=
  ceilN (s*M*q^first*p^2) (p^first*(p^2-q^2))

def markedCore : Bounds := ⟨-25591398, -23250036⟩
def vacuumCore : Bounds := ⟨1256795084726467, 1259476223854567⟩
def markedCircle : Nat := 216821257148
def vacuumCircle : Nat := 15466258
def markedTail := evenTail (10^15) markedCircle 11 4 48
def vacuumTail := evenTail (10^12) vacuumCircle 9 4 30

theorem even_tails :
    (evenTail (10^15) markedCircle 11 4 46, markedTail, vacuumTail) =
    (1543100, 204047, 524181115) := by decide

#print axioms even_tails

def markedTotal := markedCore.widen markedTail
def vacuumTotal := vacuumCore.widen (1000 * vacuumTail)

theorem total_enclosures :
    (markedTotal, vacuumTotal) =
    (⟨-25795445, -23045989⟩, ⟨1256270903611467, 1260000404969567⟩) ∧
    markedTotal.hi < 0 ∧ 0 < vacuumTotal.lo := by decide

#print axioms total_enclosures

structure FourTable where
  moment : Bounds     -- units 10^-11
  delta : Bounds      -- units 10^-14
  gainMinusOne : Bounds -- units 10^-9, on the negative-moment branch
  deriving DecidableEq, Repr

/-- Divide intervals expressed in the same units. Check all four corners so the
    sign-error fixture passes through the very same normalization. -/
def momentCorners (n z : Bounds) : Option (Fr × Fr) :=
  if n.lo > n.hi || z.lo > z.hi || z.lo ≤ 0 then none else
  let a : Fr := ⟨n.lo, z.lo.toNat⟩
  let b : Fr := ⟨n.lo, z.hi.toNat⟩
  let c : Fr := ⟨n.hi, z.lo.toNat⟩
  let d : Fr := ⟨n.hi, z.hi.toNat⟩
  some ((a.least b).least (c.least d), (a.greatest b).greatest (c.greatest d))

def momentOnly (n z : Bounds) : Option Bounds := do
  let (lo, hi) ← momentCorners n z
  return roundOut lo hi (10^11)

def fourTable (n z : Bounds) (w : Nat) : Option FourTable := do
  let (lo, hi) ← momentCorners n z
  if hi.num ≥ 0 || w == 0 || w > 10000 then none else
    -- b ∈ [136/157,87/100], E W ∈ [(w/10000)^2,1].
    let dl := lo.mul ⟨87^9, 144*100^9⟩
    let du := hi.mul ⟨136^9, 144*157^9⟩
    let gl := hi.mul ⟨-6, 1⟩
    let gu := lo.mul ⟨-6*10000^2, w^2⟩
    return ⟨roundOut lo hi (10^11), roundOut dl du (10^14),
            roundOut gl gu (10^9)⟩

def expectedFour : FourTable :=
  ⟨⟨-2054, -1829⟩, ⟨-4072, -3488⟩, ⟨109, 484⟩⟩

theorem four_dimensional_division :
    fourTable markedTotal vacuumTotal 5047 = some expectedFour := by decide

#print axioms four_dimensional_division

/-- Flip one marked insertion. The independently computed moment changes sign. -/
theorem reject_reversed_mark :
    momentOnly markedTotal.neg vacuumTotal = some ⟨1829, 2054⟩ ∧
    fourTable markedTotal.neg vacuumTotal 5047 ≠ some expectedFour := by decide

#print axioms reject_reversed_mark

/-- Replacing the common vacuum by one is meaningful, and gives a different interval. -/
theorem reject_omitted_vacuum :
    momentOnly markedTotal ⟨10^15, 10^15⟩ = some ⟨-2580, -2304⟩ ∧
    fourTable markedTotal ⟨10^15, 10^15⟩ 5047 ≠ some expectedFour := by decide

#print axioms reject_omitted_vacuum

def fiveMoment (xi : Nat) : Fr × Fr :=
  (⟨-(xi^2 : Nat), 3*10000^2⟩, ⟨2*xi^2, 3*10000^2⟩)

def fiveGain (eta : Nat) : Bounds :=
  ⟨2*10^8 - (8*eta^2 : Nat), 2*10^8 + (4*eta^2 : Nat)⟩

theorem five_dimensional_division :
    let (lo, hi) := fiveMoment 2269
    let b : Fr := ⟨87^9, 144*100^9⟩
    lo.same ⟨-5148361,300000000⟩ = true ∧
    hi.same ⟨10296722,300000000⟩ = true ∧
    (lo.mul b).same ⟨-54447569906770286616861,1600000000000000000000000000⟩ = true ∧
    (hi.mul b).same ⟨54447569906770286616861,800000000000000000000000000⟩ = true ∧
    fiveGain 2934 = ⟨131133152,234433424⟩ ∧ 130000000 < (fiveGain 2934).lo := by decide

#print axioms five_dimensional_division

