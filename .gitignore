__pycache__/
*.pyc
.DS_Store
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
logs/*
!logs/README.md
!logs/retained/
!logs/retained/README.md
# Audit-lane runner cache: SHA-pinned, version-controlled. See
# docs/audit/RUNNER_CACHE_POLICY.md.
!logs/runner-cache/
!logs/runner-cache/**
# In-progress live logs are transient (replaced by canonical cache on
# completion); do NOT commit them.
logs/runner-cache/.in-progress/
# d3 pilot: rolling ~92MB state checkpoints and live logs are
# transient; canonical evidence = the JSONL observable streams + the
# --report cache (both committed). Engine tables regenerate in ~1 min.
logs/runner-cache/d3_pilot_checkpoints/*.npz
logs/runner-cache/d3_pilot_checkpoints/full_run_stdout.log
logs/runner-cache/d3_pilot_checkpoints/full_run_progress.log
logs/runner-cache/d3_engine_tables/
logs/runner-cache/d3_bar_location_checkpoints/*.npz
logs/runner-cache/d3_bar_location_checkpoints/full_run_stdout.log
logs/runner-cache/d3_bar_location_checkpoints/full_run_progress.log
.claude/worktrees/

# Python virtual environments (per-developer, per-worktree).
# See docs/repo/PYTHON_VENV_SETUP.md for setup instructions.
.venv/
venv/
env/

.claude/science/physics-loops/**/last_codex_message.md
.claude/science/physics-loops/**/supervisor.lock
.claude/science/physics-loops/**/supervisor.log
.claude/science/physics-loops/**/supervisor_status.json
.claude/scheduled_tasks.lock

# Long-running plaquette MC checkpoints are large resume artifacts; commit the
# JSON summaries and per-stream outputs, not the active lattice checkpoints.
outputs/plaquette_mc_grade4_2026_06_11/checkpoints/
logs/runner-cache/d3_bar_window_checkpoints/*.npz
logs/runner-cache/d3_bar_window_checkpoints/full_run_stdout.log
logs/runner-cache/d3_bar_window_checkpoints/full_run_progress.log
