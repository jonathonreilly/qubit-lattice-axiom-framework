From 05ad284d896697a54cda7f33187bb87833313baf Mon Sep 17 00:00:00 2001
From: Claude Opus <noreply@anthropic.com>
Date: Thu, 16 Jul 2026 09:47:45 -0400
Subject: [PATCH] ci: pin the audit pipeline to release requirements and add a
 per-PR smoke gate

- audit.yml installs requirements-release.txt: the nightly's verdict-bearing
  numerics run against exact versions instead of loose >= floors. Requires
  the pyyaml pin (PR #5403) landed first: the loose set carried pyyaml>=6.0
  for the repo's vocabulary/render tooling (scripts/vocab_lint.py,
  scripts/migrate_link_aware.py, scripts/render_controlled_vocabulary.py);
  the exact set must not silently drop it. The copy-over template
  (docs/audit/templates/audit_workflow.yml) is pinned in PR #5403 so the
  documented install procedure cannot revert this.
- New pr-smoke.yml: on any PR touching Python, docs/audit/scripts/** (incl.
  shell tooling like run_pipeline.sh), or requirements files, byte-compile
  every changed .py and, when audit tooling changed, run the
  docs/audit/scripts/tests suite. bash with pipefail on every multi-command
  step; no output pipes on the unittest invocation. Read-only permissions
  (contents: read), 15-minute cap, no auto-commit.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 .github/workflows/audit.yml    |  7 ++--
 .github/workflows/pr-smoke.yml | 65 ++++++++++++++++++++++++++++++++++
 2 files changed, 69 insertions(+), 3 deletions(-)
 create mode 100644 .github/workflows/pr-smoke.yml

diff --git a/.github/workflows/audit.yml b/.github/workflows/audit.yml
index 7c81450b45..cfe5ca0624 100644
--- a/.github/workflows/audit.yml
+++ b/.github/workflows/audit.yml
@@ -50,9 +50,10 @@ jobs:
       - name: Install dependencies
         run: |
           python -m pip install --upgrade pip
-          if [ -f requirements.txt ]; then
-            pip install -r requirements.txt
-          fi
+          # Exact pins: the audit lane's verdict-bearing numerics must run
+          # against a reproducible environment (requirements.txt keeps loose
+          # floors for local convenience only).
+          pip install -r requirements-release.txt
 
       - name: Repair missing dependency edges
         run: python3 docs/audit/scripts/repair_missing_dependency_edges.py --apply
diff --git a/.github/workflows/pr-smoke.yml b/.github/workflows/pr-smoke.yml
new file mode 100644
index 0000000000..709dcbec90
--- /dev/null
+++ b/.github/workflows/pr-smoke.yml
@@ -0,0 +1,65 @@
+# Fast per-PR gate: byte-compile every changed Python file and run the audit
+# tooling unit tests when audit scripts changed. Read-only; no auto-commit.
+# Exists so breakage is caught at PR time instead of only by the nightly
+# audit lane (the sole channel for generated-output commits).
+name: pr-smoke
+
+on:
+  pull_request:
+    paths:
+      - "**/*.py"
+      - "docs/audit/scripts/**"
+      - "requirements*.txt"
+      - ".github/workflows/pr-smoke.yml"
+
+permissions:
+  contents: read
+
+concurrency:
+  group: pr-smoke-${{ github.event.pull_request.number }}
+  cancel-in-progress: true
+
+jobs:
+  smoke:
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@v6
+        with:
+          fetch-depth: 0
+
+      - uses: actions/setup-python@v6
+        with:
+          python-version: "3.11"
+
+      - name: Install pinned dependencies
+        run: |
+          python -m pip install --upgrade pip
+          pip install -r requirements-release.txt
+
+      - name: Byte-compile changed Python files
+        shell: bash
+        run: |
+          set -o pipefail
+          git fetch -q origin "${{ github.base_ref }}"
+          changed=$(git diff --name-only "origin/${{ github.base_ref }}...HEAD" -- '*.py')
+          if [ -z "$changed" ]; then
+            echo "no changed python files"; exit 0
+          fi
+          status=0
+          while IFS= read -r f; do
+            [ -f "$f" ] || continue
+            python -m py_compile "$f" || { echo "COMPILE FAIL: $f"; status=1; }
+          done <<< "$changed"
+          exit "$status"
+
+      - name: Audit tooling unit tests (only when audit scripts changed)
+        shell: bash
+        run: |
+          set -o pipefail
+          git fetch -q origin "${{ github.base_ref }}"
+          if git diff --name-only "origin/${{ github.base_ref }}...HEAD" -- docs/audit/scripts | grep -q .; then
+            python -m unittest discover -s docs/audit/scripts/tests
+          else
+            echo "audit scripts unchanged; skipped"
+          fi
-- 
