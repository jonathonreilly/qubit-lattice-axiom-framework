     echo "FAILED: landing did not complete after 4 attempts" >&2
     exit 1
   fi
   git fetch -q origin
   if ! git merge-base --is-ancestor "$landed" origin/main; then
     echo "FAILED: $landed not contained in origin/main" >&2
     exit 1
   fi
   echo "LANDED $landed"
