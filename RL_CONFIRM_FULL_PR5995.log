   680	    "origin.on_G0_positive_the_massless_slice_is_m_equals_0",
   681	    "witness.diag_Qp_over_totalsum_J_is_(n-1)/n^3_for_n_2_to_50",
   682	    "witness.value_at_n_3_is_2/27",
   683	    "witness.rival_expression_diag_Qp_over_n_is_(n-1)/n^2",
   684	    "cycle.identity_holds_on_all_32768_graphs_on_6_vertices",
   685	    "cycle.census_counts_are_real",
   686	    "gate.check_count_matches_the_declared_census",
   687	)
   688	
   689	
   690	def build_expected_primary_payload(units: dict) -> dict:
   835	    payload = {
   836	        "date": DATE,
   837	        "script":
   838	            "scripts/salvaged_exact_algebra_independent_check_2026_08_08.py",
   839	        "role": ("salvage independent check: every unit recomputed by a "
   840	                 "different exact route; primary receipt verified "
   841	                 "fail-closed"),
   842	        "inputs": ["outputs/salvaged_exact_algebra_receipt_2026_08_08.json"],
   843	        "units": units,
   844	        "checks": [{"name": name, "ok": ok} for name, ok in CHECKS],
   845	        "pass": passes,
   846	        "fail": fails,
   847	        "expected_check_count": EXPECTED_CHECK_COUNT,
   848	        "verdict": verdict,
   849	        "review_loop": PRIMARY_REVIEW_LOOP,
   850	    }
   851	    blob = json.dumps(payload, sort_keys=True, indent=1).encode()
   852	    payload["payload_sha256"] = hashlib.sha256(blob).hexdigest()
   853	    os.makedirs(os.path.dirname(RECEIPT_PATH), exist_ok=True)
   854	    with open(RECEIPT_PATH, "w", encoding="utf-8") as fh:
   855	        json.dump(payload, fh, sort_keys=True, indent=1)
   856	        fh.write("\n")
   857	    print(f"TOTAL: PASS={passes} FAIL={fails}")
   858	    print(f"VERDICT: {verdict}")
   859	    print(f"receipt: {os.path.relpath(RECEIPT_PATH, REPO)}")
   860	    return 0 if verdict == "PASS" else 1
   861	
   862	

