import itertools
from fractions import Fraction
import numpy as np
pairs=list(itertools.combinations(range(5),2))
perms=list(itertools.permutations(range(4)))
def sign(p):
    return -1 if sum(p[i]>p[j] for i in range(4) for j in range(i+1,4))%2 else 1
ps=[(p,sign(p)) for p in perms]
def exact_det_batch(d):
    out=np.zeros(len(d),dtype=np.int64)
    for p,s in ps:
        term=np.ones(len(d),dtype=np.int64)
        for i,j in enumerate(p): term*=d[:,i,j]
        out += s*term
    return out
def census(vals,ticks,chunk=150000):
    A=np.array([list(s)+[t] for s in itertools.product(vals,repeat=3) for t in ticks],dtype=np.int64)
    src=itertools.combinations(range(len(A)),5); joint={}; nondeg=0; float_mismatch=0
    while True:
        block=list(itertools.islice(src,chunk))
        if not block: break
        M=A[np.asarray(block,dtype=np.int64)]
        d=M[:,1:]-M[:,:1]
        det=exact_det_batch(d)
        fdet=np.rint(np.linalg.det(d.astype(np.float64))).astype(np.int64)
        float_mismatch += int(np.count_nonzero(det"'!=fdet))
        keep=det!=0; M=M[keep]; vol=np.abs(det[keep]); nondeg+=len(M)
        c=np.zeros(len(M),dtype=np.int64)
        for i,j in pairs: c += np.abs(M[:,i,:3]-M[:,j,:3]).sum(1)>=2
        for e,v in zip(c.tolist(),vol.tolist()): joint[e,v]=joint.get((e,v),0)+1
    return joint,nondeg,float_mismatch
for label,vals in [('"'native',(0,1)),('spatial_refinement',(0,1,2))]:
    J,n,mis=census(vals,(0,1))
    ratio=min(Fraction(24*e,v) for e,v in J)
    arg=sorted((e,v) for e,v in J if Fraction(24*e,v)==ratio)
    print(label, 'nondeg',n,'floor',min(e for e,v in J),'ratio',ratio,'arg',arg,'float_det_mismatches',mis)
    if label=='native':
        print('native_floor_count',sum(n for (e,v),n in J.items() if e==3),'unimodular_profile',dict(sorted((e,n) for (e,v),n in J.items() if v==1)))
    else:
        print('refined_region_floor',ratio*8)
