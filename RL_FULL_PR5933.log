/bin/zsh -lc "python3 - <<'PY'
import itertools,time
import numpy as np
from scipy.optimize import linprog,milp,Bounds,LinearConstraint
from scipy.sparse import coo_matrix
pairs5=list(itertools.combinations(range(5),2))
A=np.array([list(s)+[t] for s in itertools.product((0,1),repeat=3) for t in (0,1)],dtype=np.int64)
perms=list(itertools.permutations(range(4)))
def parity(p): return -1 if sum(p[i]>p[j] for i in range(4) for j in range(i+1,4))%2 else 1
def det4(D): return sum(parity(p)*np.prod([int(D[i,p[i]]) for i in range(4)]) for p in perms)
V=[]; W=[]
for comb in itertools.combinations(range(16),5):
    M=A[list(comb)]; v=abs(det4(M[1:]-M[0]))
    if v"'!=1: continue
    c=sum(int(np.abs(M[i,:3]-M[j,:3]).sum())>=2 for i,j in pairs5)
    if c<=4: V.append(M); W.append(c)
V=np.asarray(V,dtype=np.int64); W=np.asarray(W,dtype=np.int64); n=len(V)
obj=[0.]*10+[-1.]; aub=[]
for k in range(10):
    row=[0.]*11; row[k]=-1.; row[10]=1.; aub.append(row)
def disjoint_lp(P,Q):
    aeq=[]; beq=[]
    for d in range(4):
        aeq.append([*map(float,P[:,d]),*map(float,-Q[:,d]),0.]); beq.append(0.)
    aeq += [[1.]*5+[0.]*6,[0.]*5+[1.]*5+[0.]]; beq += [1.,1.]
    r=linprog(obj,A_ub=aub,b_ub=[0.]*10,A_eq=aeq,b_eq=beq,
              bounds=[(0.,1.)]*10+[(None,None)],method='"'highs')
    if r.status==2: return True
    if not r.success: raise RuntimeError((r.status,r.message))
    return float(-r.fun)<=1e-9
adj=np.zeros((n,n),dtype=bool); t=time.time(); total=n*(n-1)//2
for k,(i,j) in enumerate(itertools.combinations(range(n),2),1):
    adj[i,j]=adj[j,i]=disjoint_lp(V[i],V[j])
    if k%25000==0: print('LP',k,'of',total,'seconds',round(time.time()-t,2),flush=True)
print('LP graph complete','cells',n,'cost3',int((W==3).sum()),'edges',int(adj.sum()//2),'seconds',round(time.time()-t,2),flush=True)
def solve_clique(indices,label):
    idx=np.asarray(indices,dtype=int); G=adj[np.ix_(idx,idx)]; m=len(idx)
    ii,jj=np.triu_indices(m,1); bad=~G[ii,jj]; ii=ii[bad]; jj=jj[bad]; q=len(ii)
    rows=np.repeat(np.arange(q),2); cols=np.column_stack((ii,jj)).ravel(); data=np.ones(2*q)
    C=coo_matrix((data,(rows,cols)),shape=(q,m)).tocsr()
    r=milp(c=-np.ones(m),integrality=np.ones(m),bounds=Bounds(np.zeros(m),np.ones(m)),
           constraints=LinearConstraint(C,-np.inf,np.ones(q)),options={'time_limit':300,'mip_rel_gap':0.0,'presolve':True})
    chosen=np.flatnonzero(r.x>0.5) if r.x is not None else np.array([],dtype=int)
    ok=all(G[a,b] for a,b in itertools.combinations(chosen.tolist(),2))
    print(label,'success',r.success,'status',r.status,'optimum',None if r.fun is None else int(round(-r.fun)),
          'mip_gap',getattr(r,'mip_gap',None),'chosen',len(chosen),'w_profile',dict(zip(*np.unique(W[idx[chosen]],return_counts=True))) if len(chosen) else {},'witness_ok',ok,flush=True)
solve_clique(np.flatnonzero(W==3),'cost3')
solve_clique(np.arange(n),'cost3or4')
