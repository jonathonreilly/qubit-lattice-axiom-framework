+    def colour_sort(cand):
+        classes = []
+        colour = {}
+        for v in sorted(cand, key=lambda x: -len(nbr[x] & cand)):
+            placed = False
+            for ci, cl in enumerate(classes):
+                if not (nbr[v] & cl):
+                    cl.add(v)
