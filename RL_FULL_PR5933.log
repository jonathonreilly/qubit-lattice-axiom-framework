/bin/zsh -lc "python3 - <<'PY'
import itertools
import numpy as np
from scipy.optimize import linprog
pairs5=list(itertools.combinations(range(5),2))
K=[]
for p in itertools.permutations(range(4)):
 c=np.zeros(4,dtype=int); v=[c.copy()]
 for a in p: c=c.copy(); c[a]=1; v.append(c.copy())
 K.append(np.array(v))
def cost(M): return sum(int(np.abs(M[i,:3]-M[j,:3]).sum())>=2 for i,j in pairs5)
def interiors_disjoint(P,Q):
 c=np.r_[np.zeros(10),-1.]; Aeq=[]; b=[]
 for d in range(4): Aeq.append(np.r_[P[:,d],-Q[:,d],0.]); b.append(0.)
 Aeq += [np.r_[np.ones(5),np.zeros(6)],np.r_[np.zeros(5),np.ones(5),0.]]; b += [1.,1.]
 Aub=np.zeros((10,11)); Aub[np.arange(10),np.arange(10)]=-1.; Aub[:,10]=1.
 r=linprog(c,A_ub=Aub,b_ub=np.zeros(10),A_eq=Aeq,b_eq=b,bounds=[(0.,1.)]*10+[(None,None)],method='highs')
 return r.status==2 or (r.success and -r.fun<=1e-9)
vol=[round(abs(np.linalg.det(M[1:]-M[0]))) for M in K]; costs=[cost(M) for M in K]
