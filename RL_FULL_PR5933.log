+# (d) the unimodular census, its compatibility graph, and the cost bracket
+# ----------------------------------------------------------------------------------
+print("--- unimodular census and compatibility ---")
+V = np.array(UV, dtype=np.int64)
+Wa = np.array(UW, dtype=np.int64)
+prof = {}
+for w in UW:
