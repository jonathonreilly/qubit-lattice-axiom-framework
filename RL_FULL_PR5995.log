   229	def attack_scope_overclaim(corpus: dict[int, list[str]]) -> dict:
   230	    """Does 'swept empty' quietly extend past the enumerated artifacts?"""
   231	    receipt = json.loads(rtext("outputs/route1_sweep_cycle928_receipt_2026_07_28.json"))
   232	    statement = receipt["E_Q3_consolidated_license"]["consolidated_license_statement"]
   233	    swept = sorted(int(c) for c in receipt["C_Q1_angle_object_enumeration"]["per_cycle_typing_scan"])
   234	
   235	    # how many campaign cycles exist ANYWHERE in this worktree that were NOT swept?
   236	    all_campaign = sorted(corpus)
   237	    unswept = [c for c in all_campaign if c not in swept]
   238	
   239	    # the honest-scope sentence must be present AND must name the limitation
   240	    has_scope_sentence = "HONEST SCOPE" in statement
   241	    names_limitation = (
   242	        "not a statement about all future mathematics" in statement
   243	        and "nor about campaign artifacts not enumerated here" in statement
   244	    )
   245	    # the statement must not use an unqualified universal
   246	    unqualified = re.search(r"swept empty (?:on|over) (?:all|every) surface", statement, re.I)
   247	    return {
   248	        "swept_cycles": swept,
   249	        "swept_count": len(swept),
   250	        "campaign_cycles_present_in_this_worktree_but_NOT_swept": unswept,
   251	        "has_honest_scope_sentence": has_scope_sentence,
   252	        "names_the_limitation_explicitly": names_limitation,
   253	        "uses_an_unqualified_universal": bool(unqualified),
   254	        "statement_length_chars": len(statement),
   255	    }
