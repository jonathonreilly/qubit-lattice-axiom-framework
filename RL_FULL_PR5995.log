   182	def bron_kerbosch(vertices, adjacency):
   183	    """All maximal cliques (Bron-Kerbosch with pivoting)."""
   184	    best = []
   185	
   186	    def expand(R, P, X):
   187	        if not P and not X:
   188	            best.append(list(R))
   189	            return
   190	        pivot = max(P | X, key=lambda u: len(adjacency[u] & P))
   191	        for v in sorted(P - adjacency[pivot]):
   192	            expand(R + [v], P & adjacency[v], X & adjacency[v])
   193	            P = P - {v}
   194	            X = X | {v}
   195	    expand([], set(vertices), set())
   196	    return best
