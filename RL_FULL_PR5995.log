   179	# ---------------------------------------------------------------------------
   180	# ATTACK (ii) -- BIN VERDICTS, with the bin taxonomy re-derived from the no-go.
   181	# ---------------------------------------------------------------------------
   182	
   183	def rederive_bins_from_the_no_go() -> dict:
   184	    """Rebuild the July no-go's three bins from its own bytes, not from 924."""
   185	    note = rtext("docs/ACPHILAMBDA_R_ETA_ANGLE_NATIVE_FRONTIER_NO_GO_NOTE_2026-07-04.md")
   186	    bins = {}
   187	    for n, title in ((1, "Misses the target"), (2, "Cannot pin a nonzero member"),
   188	                     (3, "Restates the missing license")):
   189	        i = note.find(f"**{title}.**")
   190	        bins[str(n)] = {"found": i >= 0, "title": title}
   191	        if i >= 0:
   192	            bins[str(n)]["text"] = re.sub(r"\s+", " ", note[i : i + 420]).strip()
   193	    # the route-1 sentence, byte-exact
   194	    r1 = note.find("1. **Licensed angle-native theorem.**")
   195	    bins["route_1_sentence"] = re.sub(r"\s+", " ", note[r1 : r1 + 300]).strip() if r1 >= 0 else None
   196	    # the target coordinates
   197	    bins["target_block_present"] = "Phi_target := 3 delta_target = S_sum = 2/3" in note
   198	    return bins
