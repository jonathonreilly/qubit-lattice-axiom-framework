   884	        primary_bin, why = classify(cand, g)
   885	        # the secondary bin: what would block it if the type gap were granted?
   886	        secondary = None
   887	        if primary_bin.startswith("BIN 5"):
   888	            # 924's discipline: the first-failing gate would mask the rest, so
   889	            # report what WOULD block the candidate if a referent were granted.
   890	            secondary = (
