   579	# of bin 5, so they are separated and reported.
   580	PATH_MARKER = re.compile(r"\.(md|py|json|txt)\b|(docs|scripts|outputs|logs)/")
   581	S_SUM_WORD = re.compile(r"(?<![a-z0-9_])s_sum", re.I)
