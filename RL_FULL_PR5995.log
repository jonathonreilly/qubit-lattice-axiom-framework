   199	def independence_number(vertices, edges):
   200	    """Independence number via maximal cliques of the COMPLEMENT graph."""
   201	    V = list(vertices)
   202	    E = {tuple(sorted(e)) for e in edges}
   203	    comp = {v: set() for v in V}
   204	    for a, b in itertools.combinations(V, 2):
   205	        if tuple(sorted((a, b))) not in E:
   206	            comp[a].add(b)
   207	            comp[b].add(a)
   208	    if not V:
   209	        return 0, []
   210	    cl = bron_kerbosch(V, comp)
   211	    bestc = max(cl, key=len)
   212	    return len(bestc), sorted(bestc)
