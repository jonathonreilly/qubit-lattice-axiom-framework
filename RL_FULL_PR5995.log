   137	    """Every exact rational equal to 2/3 anywhere in the vendored bytes."""
   138	    hits: dict[int, list[dict]] = {}
   139	    for cyc, files in sorted(corpus.items()):
   140	        for path in files:
   141	            text = rtext(path)
   142	            for m in RATIONAL.finditer(text):
   143	                try:
   144	                    val = Fraction(int(m.group(1)), int(m.group(2)))
   145	                except ZeroDivisionError:
   146	                    continue
   147	                if val != Fraction(2, 3):
   148	                    continue
   149	                ls = text.rfind("\n", 0, m.start()) + 1
   150	                le = text.find("\n", m.start())
   151	                line = re.sub(r"\s+", " ", text[ls : le if le != -1 else len(text)]).strip()
   152	                hits.setdefault(cyc, []).append(
   153	                    {"file": path, "line_no": text.count("\n", 0, m.start()) + 1,
   154	                     "context": line[:240]}
   155	                )
   156	    return hits
   157	
   158	
   159	# Different keywords from the primary's, on purpose.
   160	CHECKER_ANGLE_KEYWORDS = [
   161	    "radian", "arg(", "exp(i", "e^{i", "mod 2pi", "mod 2*pi", "winding",
   162	    "u(1)", "phase angle", "argument of", "principal branch", "unwrap",
   163	    "degrees", "arctan", "atan2", "cis(", "polar",
   164	]
   165	
   166	
   167	def hunt_angle_typing(corpus: dict[int, list[str]]) -> dict:
   168	    found: dict[str, list[dict]] = {}
   169	    for cyc, files in sorted(corpus.items()):
   170	        for path in files:
   171	            low = rtext(path).lower()
   172	            for kw in CHECKER_ANGLE_KEYWORDS:
   173	                idx = low.find(kw)
   174	                if idx >= 0:
   175	                    found.setdefault(kw, []).append({"cycle": cyc, "file": path})
   176	    return found
