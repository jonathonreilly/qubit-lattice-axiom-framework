   840	def classify(cand: dict, g: dict) -> tuple[str, str]:
   841	    if g["LICENSED"]:
   842	        return ("SURVIVOR", "passes every route-1 gate")
   843	    if not g["R3_referent_present_on_the_home_surface"]:
   844	        return (
   845	            "BIN 5 no referent",
   846	            "the home surface carries no charged-lepton / fixed-locus vocabulary, so the "
   847	            "identification sentence cannot be stated there",
   848	        )
   849	    if not g["R1_value_is_exactly_2_over_3"]:
   850	        if cand["id"] in ANGLE_TYPED:
   851	            return (
   852	                "BIN 1 misses the target",
   853	                "THE DECISIVE NEAR-MISS.  This is the only genuinely angle-valued object on the "
   854	                "entire new surface, and it sits on the right cycle -- but its value is 2*pi/3, a "
   855	                "canonical 2*pi packaging of a rational, which is precisely the bin the July "
   856	                "no-go already closed ('not 2*pi*S_sum').  The miss is exact and unbridgeable for "
   857	                "the no-go's own reason: 2*pi/3 is irrational for rational 2/3, so no equality is "
   858	                "possible at any k or n -- 2*pi*k/n = 2/3 would force pi = 1/k * n/3, rational.  "
   859	                "The surface's one real angle is the C3 rotation angle, and the R-eta target is "
   860	                "NOT that angle.",
