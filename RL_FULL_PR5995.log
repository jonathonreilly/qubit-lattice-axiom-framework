   200	
   201	def attack_unit_convention() -> dict:
   202	    """Is a 'misses' verdict actually a HIT under a defensible unit convention?
   203	
   204	    The strongest such convention is the no-go's OWN normalisation:
   205	    Phi_target = 3 * L3(1,2) -- i.e. the UNAVERAGED sum.  Under it, every
   206	    derived object worth 2/9 is worth 2/3 after multiplication by three.  If the
   207	    primary binned a 2/9 object as "misses the target" WITHOUT also enumerating
   208	    its unaveraged sum, that is a real enumeration defect.
   209	    """
   210	    L = Fraction(2, 9)
   211	    S_sum = 3 * L
   212	    return {
   213	        "convention": "Phi = 3 * L (the no-go's own unaveraged-sum normalisation)",
   214	        "L": str(L),
   215	        "three_times_L": str(S_sum),
   216	        "the_convention_does_convert_2_9_into_2_3": S_sum == Fraction(2, 3),
   217	        "consequence": (
   218	            "Any object the primary binned as 'misses' at 2/9 is one multiplication away from "
   219	            "the target.  The primary is only safe if, for every 2/9 object it enumerated, it "
   220	            "ALSO enumerated the corresponding unaveraged sum as its own candidate."
   221	        ),
   222	    }
   223	
