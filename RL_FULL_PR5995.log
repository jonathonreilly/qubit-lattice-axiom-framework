   795	def gate_candidate(cand: dict, typing_scan: dict, planted: dict | None = None) -> dict:
   796	    """Apply the route-1 gates.  Returns the verdict record.
   797	
   798	    A candidate SURVIVES only if every gate passes.  The gates are written so
   799	    that a genuine survivor WOULD pass -- see tooth T3, which plants one.
   800	    """
   801	    if planted is not None:
   802	        g = dict(planted)
   803	    else:
   804	        cycle = cand["cycle"]
   805	        scan = typing_scan.get(cycle, {})
   806	        # The candidates whose EXACT derived value is 2/3, established by reading
   807	        # the pinned receipts (section C anchors each one).  Everything else
   808	        # misses the target and lands in bin 1.
   809	        val = Fraction(2, 3) if cand["id"] in EXACTLY_TWO_THIRDS else None
   810	        g = {
   811	            # R1: is the exact value 2/3?
   812	            "R1_value_is_exactly_2_over_3": val == Fraction(2, 3),
   813	            # R2: does the source type it as an angle (radians)?
   814	            "R2_source_types_it_as_an_angle": (
   815	                cand["id"] in ANGLE_TYPED or scan.get("radian_hits", 0) > 0
   816	            ),
   817	            # R3: does the home surface carry a charged-lepton-cycle referent?
   818	            # Cycle 897 is firewall-quarantined and therefore not vendored, so it
   819	            # cannot be scanned in-tree.  Its referent status is declared TRUE on
   820	            # the basis of its own ship-receipt headline (which names the
   821	            # charged-lepton fork and the Koide ratio and contains no numeric
   822	            # mass literal); disclosed rather than silently defaulted to False,
   823	            # because defaulting would flatter the result by sending it to bin 5.
   824	            "R3_referent_present_on_the_home_surface": (
   825	                True if cand["cycle"] == 897 else bool(scan.get("referent_present", False))
   826	            ),
   827	            # R4: is the identification inhomogeneous AND derivable on the surface?
   828	            "R4_identification_is_derivable_not_alpha_1_nor_2pi_packaging": False,
   829	            # R5: is the scope carrying the value itself selected by the surface?
   830	            "R5_scope_is_isolated_by_the_surface": False,
   831	            # R6: is the object a three-fold unaveraged sum?
   832	            "R6_arity_is_the_C3_threefold_unaveraged_sum": cand["id"] in ("C899-SUM", "C904-DIAGQP"),
   833	        }
   834	    g["LICENSED"] = all(
   835	        g[k] for k in g if k.startswith("R")
   836	    )
   837	    return g
