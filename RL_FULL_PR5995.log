   584	def scan_referent_quality(text: str) -> dict:
   585	    """Split referent-token hits into prose hits and path/substring artefacts."""
   586	    prose: dict[str, int] = {}
   587	    pathlike: dict[str, int] = {}
   588	    false_pos: dict[str, int] = {}
   589	    for tok in REFERENT_TOKENS:
   590	        pattern = S_SUM_WORD if tok == "s_sum" else re.compile(re.escape(tok), re.I)
   591	        for m in pattern.finditer(text):
   592	            if tok == "s_sum" and not S_SUM_WORD.match(text, m.start()):
   593	                false_pos[tok] = false_pos.get(tok, 0) + 1
   594	                continue
   595	            ls = text.rfind("\n", 0, m.start()) + 1
   596	            le = text.find("\n", m.start())
   597	            line = text[ls : le if le != -1 else len(text)]
   598	            window = text[max(0, m.start() - 120) : m.start() + 120]
   599	            if PATH_MARKER.search(window):
   600	                pathlike[tok] = pathlike.get(tok, 0) + 1
   601	            else:
   602	                prose[tok] = prose.get(tok, 0) + 1
   603	        # a raw substring count that exceeds every classified hit is a false positive
   604	        raw = len(re.findall(re.escape(tok), text, re.I))
   605	        classified = prose.get(tok, 0) + pathlike.get(tok, 0) + false_pos.get(tok, 0)
   606	        if raw > classified:
   607	            false_pos[tok] = false_pos.get(tok, 0) + (raw - classified)
   608	    return {
