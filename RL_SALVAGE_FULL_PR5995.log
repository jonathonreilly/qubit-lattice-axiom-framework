   408	
   409	def check_origin_by_elimination() -> dict:
   410	    # variables: m -> (1,0), g0 -> (0,1); constants -> (0,0)
   411	    one = {(0, 0): Fraction(1)}
   412	    m = {(1, 0): Fraction(1)}
   413	    g0 = {(0, 1): Fraction(1)}
   414	    # G1 eliminated from 6*G1 - (6+m)*G0 = -1:
   415	    # G1 = ((6+m)*G0 - 1)/6
   416	    six_plus_m = bp_add(bp_scale(Fraction(6), one), m)
   417	    g1 = bp_scale(Fraction(1, 6),
