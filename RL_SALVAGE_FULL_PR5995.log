   571	                if best[0] is None or length + 1 < best[0]:
   572	                    best[0] = length + 1
   573	            elif v not in visited and v != s:
   574	                visited.add(v)
   575	                dfs(v, visited, length + 1)
   576	                visited.remove(v)
