   462	# ---------------------------------------------------------------------------
   463	# unit 7 via the edge-removal BFS route
   464	# ---------------------------------------------------------------------------
   465	def bfs_dist(adj, n, src):
   466	    dist = {src: 0}
   467	    frontier = [src]
   468	    while frontier:
   469	        nxt = []
   470	        for u in frontier:
   471	            for v in range(n):
   472	                if adj[u][v] and v not in dist:
   473	                    dist[v] = dist[u] + 1
   474	                    nxt.append(v)
   475	        frontier = nxt
   476	    return dist
   477	
   478	
   479	def cycle_by_edge_removal(adj, n, s):
   480	    """min over neighbours a of s of 1 + dist(a, s) in G minus the edge
   481	    (s, a): a route through the deleted edge's endpoint back to s."""
   482	    best = None
   483	    for a in range(n):
   484	        if not adj[s][a]:
   485	            continue
   486	        adj[s][a] = adj[a][s] = 0
   487	        dist = bfs_dist(adj, n, a)
   488	        adj[s][a] = adj[a][s] = 1
   489	        if s in dist and (best is None or dist[s] + 1 < best):
   490	            best = dist[s] + 1
   491	    return best
   492	
   493	
   494	def cycle_by_neighbour_pairs(adj, n, s):
   495	    neigh = [v for v in range(n) if adj[s][v]]
   496	    sub = [[adj[i][j] if i != s and j != s else 0 for j in range(n)]
   497	           for i in range(n)]
   498	    best = None
   499	    for i, a in enumerate(neigh):
   500	        dist = bfs_dist(sub, n, a)

