   386	# ---------------------------------------------------------------------------
   387	# unit 5 via bivariate polynomial elimination
   388	# ---------------------------------------------------------------------------
   389	def bp_add(a, b):
   390	    out = dict(a)
   391	    for k, v in b.items():
   392	        out[k] = out.get(k, Fraction(0)) + v
   393	    return {k: v for k, v in out.items() if v != 0}
   394	
   395	
   396	def bp_scale(c, a):
   397	    return {k: c * v for k, v in a.items() if c * v != 0}
   398	
   399	
   400	def bp_mul(a, b):
   401	    out = {}
   402	    for (i1, j1), v1 in a.items():
   403	        for (i2, j2), v2 in b.items():
   404	            k = (i1 + i2, j1 + j2)
   405	            out[k] = out.get(k, Fraction(0)) + v1 * v2
   406	    return {k: v for k, v in out.items() if v != 0}
