   429	    slice_ok = True
   430	    for mv in (Fraction(0), Fraction(2, 9), Fraction(3), Fraction(11, 8)):
   431	        for g0v in (Fraction(1, 5), Fraction(3, 8), Fraction(9, 4)):
   432	            g1v = ((6 + mv) * g0v - 1) / 6
   433	            if ((g0v - g1v == Fraction(1, 6)) != (mv == 0)):
   434	                slice_ok = False
   435	    check("bivar.on_G0_positive_step_one_sixth_iff_m_zero", slice_ok)
   436	    return {"identity": "G0 - G1 = (1 - m*G0)/6"}
