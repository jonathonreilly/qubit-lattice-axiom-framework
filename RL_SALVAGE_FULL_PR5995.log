   375	              for j in range(n)] for i in range(n)]
   376	    shift_back = [[shift[j][i] for j in range(n)] for i in range(n)]
   377	    lap = mat_sub(mat_sub(mat_scale(Fraction(2), mat_id(n)), shift),
