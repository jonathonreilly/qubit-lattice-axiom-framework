   556	def shortest_cycle_through_by_dfs(adj, n, s):
   557	    """Brute force: enumerate every simple path from s and close it back
   558	    to s; the minimum closed length >= 3 is the shortest cycle through
   559	    s.  Exponential but exact; used only on n <= 6 here."""
   560	    best = [None]
   561	
   562	    def dfs(u, visited, length):
   563	        # any cycle completed from here needs at least one more edge,
   564	        # so it has length >= length + 1: sound pruning bound
   565	        if best[0] is not None and length + 1 >= best[0]:
   566	            return
   567	        for v in range(n):
   568	            if not adj[u][v]:
   569	                continue
