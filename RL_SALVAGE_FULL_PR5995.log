   422	    check("bivar.step_equals_(1_minus_m_G0)/6_as_a_polynomial_identity",
   423	          step == claimed)
   424	    # 6*step - 1 = -m*G0 identically, so step = 1/6 iff m*G0 = 0
   425	    left = bp_add(bp_scale(Fraction(6), step), bp_scale(Fraction(-1), one))
   426	    check("bivar.six_step_minus_one_is_minus_m_G0_identically",
   427	          left == bp_scale(Fraction(-1), bp_mul(m, g0)))
