   350	
   351	    # fixed-locus sum via the cycle-graph Laplacian pseudoinverse:
   352	    # L = 2I - S - S^{N-1}; eigenvalues (1-z)(1-z^{-1}) over z^N = 1;
   353	    # Tr((L + J/N)^{-1}) - 1 = sum over nontrivial z of the reciprocals
   354	    locus_rows = []
   355	    locus_ok = True
   356	    for n in range(2, 13):
   357	        shift = [[Fraction(1) if (i + 1) % n == j else Fraction(0)
   358	                  for j in range(n)] for i in range(n)]
   359	        shift_back = [[shift[j][i] for j in range(n)] for i in range(n)]
   360	        lap = mat_sub(mat_sub(mat_scale(Fraction(2), mat_id(n)), shift),
   361	                      shift_back)
   362	        j_over_n = [[Fraction(1, n)] * n for _ in range(n)]
   363	        inv = mat_inv(mat_add(lap, j_over_n))
