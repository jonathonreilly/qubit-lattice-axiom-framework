   439	# ---------------------------------------------------------------------------
   440	# unit 6 via the circulant/trace route
   441	# ---------------------------------------------------------------------------
   442	def check_witness_by_trace() -> dict:
   443	    ok = True
   444	    for n in range(2, 51):
   445	        ones = [[Fraction(1)] * n for _ in range(n)]
   446	        comp = mat_sub(mat_id(n), mat_scale(Fraction(1, n), ones))
   447	        diag_entries = {comp[i][i] for i in range(n)}
   448	        trace = sum(comp[i][i] for i in range(n))
   449	        row_sums = [sum(row) for row in ones]
   450	        if not (len(diag_entries) == 1
   451	                and trace == n - 1
   452	                and next(iter(diag_entries)) == trace / n
   453	                and sum(row_sums) == n * n):
   454	            ok = False
   455	    check("circulant.equal_diagonal_and_trace_route_gives_(n-1)/n_over_n^2",
   456	          ok)
   457	    check("circulant.ratio_at_n_3_is_2/27",
   458	          (Fraction(3 - 1, 3) / 9) == Fraction(2, 27))
   459	    return {"n_range": [2, 50]}
