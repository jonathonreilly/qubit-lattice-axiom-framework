   542	def bfs_dist(adj, n, src):
   543	    dist = {src: 0}
   544	    frontier = [src]
   545	    while frontier:
   546	        nxt = []
   547	        for u in frontier:
   548	            for v in range(n):
   549	                if adj[u][v] and v not in dist:
   550	                    dist[v] = dist[u] + 1
   551	                    nxt.append(v)
   552	        frontier = nxt
   553	    return dist
