   587	           for i in range(n)]
   588	    best = None
   589	    for i, a in enumerate(neigh):
   590	        dist = bfs_dist(sub, n, a)
   591	        for b in neigh[i + 1:]:
   592	            if b in dist and (best is None or dist[b] + 2 < best):
   593	                best = dist[b] + 2
