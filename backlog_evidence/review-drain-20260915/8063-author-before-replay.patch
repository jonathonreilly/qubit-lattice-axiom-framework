+ payload=json.dumps(out,indent=2)+'\n';(root/'outputs/native_star_thermodynamic_limit_2026_09_09.json').write_text(payload);print(payload,end='')
+ print(f"TOTAL: PASS={out['checks']} FAIL=0")
