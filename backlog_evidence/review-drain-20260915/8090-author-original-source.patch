+def run_boundary():
+    start = time.monotonic()
+    checks = []
+    def check(name, truth, **detail):
+        assert bool(truth), name
+        checks.append({'name':name, **detail})
+    def eq(name,a,b):
+        diff = a-b
+        vals = diff if isinstance(diff,s.MatrixBase) else [diff]
+        check(name, all(s.simplify(x) == 0 for x in vals))
