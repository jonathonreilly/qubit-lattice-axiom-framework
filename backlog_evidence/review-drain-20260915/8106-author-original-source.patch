+        require(metrics[key] < 1e-12, 'antiunitary_pairing assertion from exploratory source line 43')
+    require(metrics['pair_number_commutator'] > 0.5, 'antiunitary_pairing assertion from exploratory source line 44')
+    print(metrics)
