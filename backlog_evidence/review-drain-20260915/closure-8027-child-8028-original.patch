+ ck('generator_%d_hermitian_traceless'%a,Ta==Ta.H and s.trace(Ta)==0)
+ck('all_64_trace_pairings',all(s.simplify(s.trace(a*b))==int(i==j) for i,a in enumerate(T) for j,b in enumerate(T)))
