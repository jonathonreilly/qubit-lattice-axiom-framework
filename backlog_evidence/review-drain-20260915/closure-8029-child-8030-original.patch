+ checks.append(name)
+certs=[]
+for P,N,c in [(0,0,F(1,2)),(3,2,F(3,7)),(12,5,F(2,3))]:
+ m=P+N+1;C=F(factorial(m))/c**m
+ ck('unit_inverse_power_'+str((P,N)),m-P-N==1)
