+  i,j=e;c=-1j*(-1)**bits(occ&(((1<<j)-1)^((1<<i)-1)));occ^=(1<<i)|(1<<j)
+ lhs=phase(x,M)*c;rhs=phase(y,M2)*((-1)**bits(x&w[k]) if a and not wrong else 1)
