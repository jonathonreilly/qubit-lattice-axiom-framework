+ count=0
+ start=time.monotonic();mutants=0;graphs=[(3,[(0,1),(1,2),(0,2)]),(4,[(0,1),(1,2),(2,3)]),(4,[(0,1),(1,2),(2,3),(0,3),(0,2)])];history=0
+ for n,edges in graphs:
