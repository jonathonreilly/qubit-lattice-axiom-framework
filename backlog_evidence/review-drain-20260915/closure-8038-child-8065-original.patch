+ M=[a^b for a,b in zip(w,ell)]
+ for k in range(len(edges)):
+  ck((M[k]>>k)&1,'diagonalM')
+  for l in range(k):ck((M[k]>>l)&1==(M[l]>>k)&1,'symmetryM')
+ return inc,w,ell,M
