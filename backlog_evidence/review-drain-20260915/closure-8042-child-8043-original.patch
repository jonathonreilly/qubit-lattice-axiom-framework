+    initial = x
+    tape = []
+    pairs = []
+    while any(Q(x)):
+        q = Q(x)
+        D = sum((v * v for v in q))
+        p = q.index(1)
+        prev = {p: None}
+        queue = deque([p])
+        m = None
+        while queue:
+            a = queue.popleft()
+            if q[a] == -1:
+                m = a
+                break
+            for b in nb[a]:
+                if b not in prev and out(x, a, b):
+                    prev[b] = a
+                    queue.append(b)
+        req(m is not None, 'positive reaches negative')
+        path = [m]
+        while prev[path[-1]] is not None:
+            path.append(prev[path[-1]])
