+  targets=[];sign=1
+  for j in range(3):
+   if b>>j&1:
+    i=next(i for i in range(3) if T[i][j]);targets.append(i);sign*=T[i][j]
+  sign*=(-1)**sum(targets[i]>targets[j] for i in range(len(targets)) for j in range(i+1,len(targets)))
