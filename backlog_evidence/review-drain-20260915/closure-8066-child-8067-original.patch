+
+ 8 alpha = sum_(A,C disjoint) [
+  3 <R_C R_A>
+ + (1/2)<R_C gamma_0 (W_A-W_C) R_A>
+ - (1/2)<W_C R_C gamma_0 R_A>
+ - (1/2)<R_C gamma_0 R_A W_A> ].                (2)
+
