+ if F(h*h,q*q)<a[1]:h+=1
+ return F(l,q),F(h,q)
+class D:
+ def __init__(self,v,d=0):self.v=v if isinstance(v,tuple) else const(v);self.d=d if isinstance(d,tuple) else const(d)
+ def __add__(a,b):
+  b=b if isinstance(b,D) else D(b);return D(add(a.v,b.v),add(a.d,b.d))
