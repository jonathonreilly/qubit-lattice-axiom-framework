+def rnd(a,b):
+ q=1<<BITS
+ return F((a.numerator*q)//a.denominator,q),F(-((-b.numerator*q)//b.denominator),q)
+def const(x):x=F(x);return (x,x)
+def add(a,b):return rnd(a[0]+b[0],a[1]+b[1])
+def neg(a):return -a[1],-a[0]
