+
+def encode(v):return [[r,g,*x] for (r,g),x in sorted(v.items())]
+Q=((396,0),(399,0),(400,0),(401,0),(396,1),(399,1),(400,1),(401,1))
+
+def free(v,poles,alpha):
+ out={}
+ def accumulate(key,x):put(out,key,add(out.get(key,iv.ZERO),x))
