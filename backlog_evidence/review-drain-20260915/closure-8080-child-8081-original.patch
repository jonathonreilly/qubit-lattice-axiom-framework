+ u=mv(T,x);w=add(sc(2,mv(T,x)),sc(-1,mv(T,v)));Ju=mv(J,u);Hu=mv(H,u);t=dot(u,Hu)/dot(Hu,Hu);z=sc(-t,u);vv=add(w,sc(-t,Ju));Hvv=mv(H,vv);s=dot(vv,Hvv)/dot(Hvv,Hvv);y=sc(s,vv)
