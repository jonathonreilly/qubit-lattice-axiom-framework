+  wrong=[1,-l*s,-l*t,l*l*s*t];assert a!=[sum(wrong[j]*vs[j][i]for j in range(4))for i in range(2)];count+=1
+assert 13*15*5*2==1950 and 3*15*5*2==450;count+=1
