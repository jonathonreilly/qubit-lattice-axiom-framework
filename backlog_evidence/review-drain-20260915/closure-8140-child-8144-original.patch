+                if last is not None:assert reduced/time<last
+                last=reduced/time
+                rows.append({'grid_side':size,'path_index':index,'T':time,'direct_time_sum':direct,
+                    'reduced_energy':reduced,'static_limit':static,'positive_remainder':end})
+    return rows
