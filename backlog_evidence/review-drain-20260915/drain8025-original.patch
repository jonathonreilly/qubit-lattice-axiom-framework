+ s=src.read_text();s=s.replace('checks=[]','AUDIT_TIMEOUT_SEC=180\nAUDIT_MEMORY_LIMIT_MB=180\nif sys.argv[1:] not in ([],[\'--json\']): raise SystemExit(\'usage: '+out+' [--json]\')\nchecks=[]',1)
