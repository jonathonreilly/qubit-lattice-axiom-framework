diff --git a/.claude/science/physics-loops/finite-pw-charged-upper-20260907/evidence/native/ACTUAL_R1_REVIEW.md b/.claude/science/physics-loops/finite-pw-charged-upper-20260907/evidence/native/ACTUAL_R1_REVIEW.md
new file mode 100644
index 0000000000000000000000000000000000000000..58497a809b6a1d419219f641aa8dc4890bf3d353
--- /dev/null
+++ b/.claude/science/physics-loops/finite-pw-charged-upper-20260907/evidence/native/ACTUAL_R1_REVIEW.md
@@ -0,0 +1,11 @@
+# Cold review of the actual R1 charged-energy fixture
+
+Reviewed root ACTUAL_R1_DERIVATION.md ddcf0e7425c1c81c84a79ccbb7c443c311ddef37d2c53269281760c0072e7ef9 and actual_r1_check.py27c764ecf14dff294a1f47332edfee276b646eb5c8896fbf5fb9379f0bf45b5a after the native general proof55f5 froze. PASS.
+
+The four bivalent Gauss constraints give precisely three neutral character states at R1. The full-carrier ground identification is sound: both other neutral eigenvalues exceed E0, while every nonneutral component is orthogonal to the global vacuum, hence K>=4 and H>=4 there. This is a direct fixture argument, not an assigned numerical weak-window threshold.
+
+The projected fundamental-fundamental product is the actual antisymmetric epsilon/2 term, and fundamental-antifundamental is its scalar delta/3 term. The three other links remain present kinetically even though their Haar product is denoted M. The actual charged basis has distinct electric patterns and energies4,16,12. The normalized source Hilbert–Schmidt trace/3 is consistently used in all nine Gram and nine J contractions. The polynomial integrator uses exact supported Haar moments and raises on unsupported surviving moments; its center zeros are legitimate.
+
+The neutral t-vector/eigenvalue relation, accepted norm, kinetic numerator and J numerator agree independently with the displayed fractions. The trial excess is strictly above4, so this is a genuine adverse control to transferring the full-unitary energy identity unchanged. Rational square-root enclosures upper-bound the correct three radicals of the local theorem. The actual-energy theta succeeds while the optional worst-case replacement theta exceeds1; both outcomes are preserved without retuning. The trial is not asserted to minimize the charged sector.
+
+No correction requested. This fixture supports one finite case; the analytical volume-uniform bound remains separately proved and reviewed. Root supplied the fixture and this is a cold mathematical/code review, not an independent construction of its Haar integrator.
diff --git a/.claude/science/physics-loops/finite-pw-charged-upper-20260907/evidence/native/BEFORE_RESTRICTED_MATRIX_STRENGTHENING_check.py b/.claude/science/physics-loops/finite-pw-charged-upper-20260907/evidence/native/BEFORE_RESTRICTED_MATRIX_STRENGTHENING_check.py
new file mode 100644
index 0000000000000000000000000000000000000000..d8b30fe1628bec2423f049b9f0b3dcd9c3ac1015
--- /dev/null
+++ b/.claude/science/physics-loops/finite-pw-charged-upper-20260907/evidence/native/BEFORE_RESTRICTED_MATRIX_STRENGTHENING_check.py
@@ -0,0 +1,52 @@
+import time,resource,json,hashlib,itertools
+from pathlib import Path
+from fractions import Fraction as F
+import sympy as s
+t0=time.monotonic();checks=[];details={}
+def ck(n,b):
+ if not bool(b):raise AssertionError(n)
+ checks.append(n)
+for n in [2,3,4]:
+ verts=list(itertools.product(range(n),repeat=3));edges={}
+ for x in verts:
+  for a in range(3):
+   if x[a]+1<n:
+    y=list(x);y[a]+=1;edges[(x,tuple(y))]=0
+ faces=[]
+ for x in verts:
+  for a,b in itertools.combinations(range(3),2):
+   if x[a]+1<n and x[b]+1<n:
+    xa=list(x);xa[a]+=1;xb=list(x);xb[b]+=1;xab=xa.copy();xab[b]+=1
+    xa,xb,xab=map(tuple,[xa,xb,xab]);f=[(x,xa),(x,xb),(xa,xab),(xb,xab)];f=[tuple(sorted(e)) for e in f];faces.append(set(f))
+    for e in f:edges[e]+=1
+ path=[];x=(0,0,0)
+ for a in range(3):
+  for step in range(n-1):
+   y=list(x);y[a]+=1;y=tuple(y);path.append((x,y));x=y
+ touch=sum(bool(f.intersection(path)) for f in faces)
+ ck(f'box{n}_maximum_four_faces',max(edges.values())<=4)
+ ck(f'box{n}_touch_budget',touch<=4*len(path))
+ ck(f'box{n}_distinct_path',len(set(path))==3*(n-1))
+ details[str(n)]={'links':len(edges),'faces':len(faces),'path':len(path),'touching':touch,'max_incidence':max(edges.values())}
+energies=[]
+for R in range(1,21):
+ h=R*R-(R*R//4)+3*R
+ vals=[p*p+p*(R-p)+(R-p)**2+3*R for p in range(R+1)]
+ energies.append(h);ck(f'shell_R{R}',min(vals)==h)
+P=s.eye(3)-s.ones(3)/3;Q=s.eye(3)-P;V=s.diag(0,1,2);W=s.diag(1,-1,1)
+comm=P*V*P*W*P-P*W*P*V*P
+rhs=P*W*Q*V*P-P*V*Q*W*P
+ck('full_multiplications_commute',V*W==W*V)
+ck('compression_commutator_identity',comm==rhs)
+ck('naive_compressed_commutation_rejected',comm!=s.zeros(3))
+ck('wrong_compression_sign_rejected',comm!=-rhs)
+ck('projection_and_unitary',P*P==P and W.T*W==s.eye(3))
+ck('positive_face_norm_bound',V.is_positive_semidefinite and (2*s.eye(3)-V).is_positive_semidefinite)
+h=energies[9];theta=F(8,h)
+ck('R10_normalization_budget',theta<1)
+ck('R1_insufficient_budget_rejected',F(8,energies[0])>=1)
+ck('denominator_positive',1-theta>0)
+ck('restricted_ground_replacement_adverse',4>8*0)
+ck('generator_normalization_discriminator',8*1==3*F(8,3) and 8*2!=3*F(8,3))
+result={'TOTAL':len(checks),'checks':checks,'geometry':details,'shell_energies_R1_to20':energies,'compression_commutator':[[str(x) for x in comm.row(i)] for i in range(3)],'theta_R10_a_v_d1':str(theta),'scope':'Exact geometry, shell, budget and abstract compression controls; not a SU3 spectral trial or proof of the analytical bound.','source_sha256':hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),'seconds':time.monotonic()-t0,'rss_mib':resource.getrusage(resource.RUSAGE_SELF).ru_maxrss/(1024**2)}
+print(json.dumps(result,indent=2,allow_nan=False))
