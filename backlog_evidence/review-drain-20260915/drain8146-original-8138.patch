+        out[k] = (best, arg)
+    return out
+
+def mu2d_square(K, K2):
+    """The 2D monotone law on the 2x2 square: sites (0,0),(0,1),(1,0),(1,1) as (row, col)."""
+    law = {}
+    for v in product(range(M), repeat=4):
+        v00, v01, v10, v11 = v
+        law[v] = F(1, 6) * K[v00][v01] * K[v00][v10] * K[v01][v11] * K[v10][v11] / K2[v01][v10]
+    return law
+
