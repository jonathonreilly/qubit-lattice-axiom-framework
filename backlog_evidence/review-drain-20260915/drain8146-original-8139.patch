+        o = len(reps)
+        reps.append(s)
+        orbit_of[s] = o
+        for g in G:
+            orbit_of[tuple(g[x] for x in s)] = o
+    sizes = [0] * len(reps)
+    for s in states:
+        sizes[orbit_of[s]] += 1
+    n = len(reps)
+    Q = [[F(0)] * n for _ in range(n)]
+    for o, w in enumerate(reps):
