+def plane_transfer_class(rule: Rule, signs, w, v) -> Fraction:
+    s2, s3 = signs[1], signs[2]
+    idx = {(0, 0): 0, (0, 1): 1, (1, 0): 2, (1, 1): 3}
+    pr = F(1)
+    for (a, b), k in idx.items():
+        rec = [w[k]]
+        p2 = (a - s2, b)
+        p3 = (a, b - s3)
+        if p2 in idx:
+            rec.append(v[idx[p2]])
+        if p3 in idx:
+            rec.append(v[idx[p3]])
+        pr *= rule.cond(tuple(rec))[v[k]]
+    return pr
