+# ------------------------------------------------------------------ the eroder
+def evolve_majority(island: set) -> int:
+    cur = set(island)
+    t = 0
+    while cur:
+        cand = set()
+        for (a, b, c) in cur:
+            cand |= {(a + 1, b, c), (a, b + 1, c), (a, b, c + 1)}
+        nxt = set()
+        for (a, b, c) in cand:
+            n1 = ((a - 1, b, c) in cur) + ((a, b - 1, c) in cur) + ((a, b, c - 1) in cur)
+            if n1 >= 2:
+                nxt.add((a, b, c))
+        cur = nxt
+        t += 1
+        if t > 10 ** 5:
+            return -1
+    return t
