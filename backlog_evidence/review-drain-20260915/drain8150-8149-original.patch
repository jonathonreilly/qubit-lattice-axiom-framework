+        return mu[tuple(base)] / tot
+    ref = pats[0]
+    rec = {}
+    for v in pats:
+        ratio = F(1)
+        cur = list(ref)
+        for i in range(n):
+            before = tuple(cur)
+            cur[i] = v[i]
+            after = tuple(cur)
+            ratio *= conditional(after, i, v[i]) / conditional(before, i, ref[i])
