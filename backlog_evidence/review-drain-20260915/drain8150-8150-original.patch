+    checks.check("C2", ok_bad, "X2 (only if): three pseudo-random mixtures charging non-qualifying orders differ from the static law on the path and the star")
+    sites, edges, nb = window(WINDOWS["2x3"])
+    st6 = static_law(sites, edges)
+    reps = report["classes"]["2x3"]
+    laws6 = {key: seq_law(o, nb, sites) for key, o in reps.items()}
