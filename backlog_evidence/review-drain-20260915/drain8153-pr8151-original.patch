+        for d in range(3):
+            for (a, b) in pairs[d]:
+                x *= phi[v[a]][v[b]] ** 2
+        w[v] = x
+    Z = sum(w.values())
+    return idx, pairs, {v: F(x, Z) for v, x in w.items()}
