+    vb = sorted({tuple(sorted((idx[(i, 0)], idx[(i, 1)]))) for i in range(4)})  # direction-2 bonds (4 distinct pairs, each doubled on the 2-torus)
+    w = {}
+    for v in product(range(M), repeat=8):
+        x = 1
+        for (a, b) in hb:
+            x *= phi[v[a]][v[b]]
+        for (a, b) in vb:
+            x *= phi[v[a]][v[b]] ** 2
+        w[v] = x
+    Z = sum(w.values())
+    return sites, idx, hb, {v: F(x, Z) for v, x in w.items()}
