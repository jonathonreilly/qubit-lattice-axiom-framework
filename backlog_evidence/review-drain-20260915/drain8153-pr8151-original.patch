+# ------------------------------------------------------------------ small tori
+def ring_measure(phi, n: int) -> dict:
+    w = {}
+    for v in product(range(M), repeat=n):
+        x = 1
+        for i in range(n):
+            x *= phi[v[i]][v[(i + 1) % n]]
+        w[v] = x
+    Z = sum(w.values())
+    return {v: F(x, Z) for v, x in w.items()}
