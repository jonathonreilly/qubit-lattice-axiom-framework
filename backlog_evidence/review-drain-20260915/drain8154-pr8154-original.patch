+M2 = (1 + Lam) / 2
+E = 4
+N = 2
+full = (2 * M2 / 3) ** 2 / (sp.sqrt(b * E) + sp.sqrt(b * E + 4 * M2 / (3 * N))) ** 2
+simp = (M2 / 3) ** 2 / (b * E + sp.Rational(4, 3) / N)
