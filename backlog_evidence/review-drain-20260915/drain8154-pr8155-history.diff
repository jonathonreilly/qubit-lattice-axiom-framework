+ok3 = True
+for beta in (0.1, 0.28, 1.0, 2.0):
+    ts = nodes; ws = weights
+    num = sum(w * t * Z(beta, math.sqrt(max(2 + 2 * t, 0))) for t, w in zip(ts, ws))
