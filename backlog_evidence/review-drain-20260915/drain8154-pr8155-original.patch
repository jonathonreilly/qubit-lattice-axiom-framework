+for xv in np.linspace(0, 12, 121):
+    for ang in np.linspace(0, math.pi / 2, 31):
+        h = xv * np.array([0, 0, 1.0]); D = np.array([math.sin(ang), 0, math.cos(ang)])
+        w = np.exp(S @ h) * W; w /= w.sum()
+        X = S @ D; m = (w * X).sum(); mad = (w * np.abs(X - m)).sum()
+        if mad > best[0]:
