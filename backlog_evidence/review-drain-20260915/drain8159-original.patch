+                  [Path(__file__).resolve(),root/'notes/BLOCK11_QUARTET_METRIC_FLOW_AND_POLARIZATION.md']}}
+out=json.dumps(result,indent=2);Path(__file__).with_suffix('.json').write_text(out+'\n');print(out)
