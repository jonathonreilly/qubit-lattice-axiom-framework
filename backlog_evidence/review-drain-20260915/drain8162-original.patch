+    for kk,ww in zip(k.astype(int),w):folded[kk%N]+=ww
+    direct_lam=np.fft.fft(folded).real
+    alias_lam=characters(c,N)
+    assert np.max(abs(direct_lam-alias_lam))<2e-13
