+    # tends to zero with delta and has no universal unit lower coefficient.
+    assert comm>1000*np.finfo(float).eps*np.linalg.norm(M)*np.linalg.norm(qdiag)
+    return T,comm
+
+
+def full_physical_check(N,g,hop,delta):
