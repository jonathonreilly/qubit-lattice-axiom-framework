+    c=calibrate(delta,N,g);theta=2*math.pi*np.arange(N)/N
+    k,p,_=jump_data(c)
+    # Direct integer jump sum, independent of the product eigenvalue formula.
+    lam=np.array([p@np.cos(2*math.pi*r*k/N) for r in range(N)])
