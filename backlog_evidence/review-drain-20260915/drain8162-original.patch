+
+
+def full_physical_check(N,g,hop,delta):
+    coords=np.indices((N,)*4).reshape(4,-1).T
+    theta=2*math.pi*coords/N;total=theta.sum(axis=1);d=len(coords)
+    basis=np.zeros((d,4,4*N),complex)
+    for n in range(N):
+        for j in range(4):
