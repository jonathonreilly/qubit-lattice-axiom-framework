+    for n in range(N):
+        for j in range(4):
+            electric=np.array([n-int(e<j) for e in range(4)])
+            div=electric-np.roll(electric,1);charge=np.eye(4,dtype=int)[j]-np.eye(4,dtype=int)[0]
