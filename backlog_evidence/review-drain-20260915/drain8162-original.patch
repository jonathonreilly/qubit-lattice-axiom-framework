+
+
+def rotor(Ncut,g,hop):
+    ns=np.arange(-Ncut,Ncut+1);d=4*len(ns);H=np.zeros((d,d))
+    def ix(n,j):return 4*(n+Ncut)+j
+    for n in ns:
