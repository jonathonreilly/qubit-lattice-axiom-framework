+        # which cancel in the final loop; form each curl independently.
+        all_edges=set(chain)
+        for a,b,u in fill:
+            all_edges.update([(a,u),(b,moved(u,a)),(a,moved(u,b)),(b,u)])
+        angles={e:float(rng.normal()) for e in sorted(all_edges)}
