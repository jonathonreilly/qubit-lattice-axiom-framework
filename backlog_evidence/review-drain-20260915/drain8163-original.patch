+    out=np.array([[np.linalg.det(Y[np.ix_(a,b)]) for b in OCC] for a in OCC])
+    out*=np.linalg.det(A)/(1+mu*delta)**4
+    assert np.linalg.norm(out-out.conj().T)<2e-13
+    return out
+
