+    rows=[];finite_fock=[]
+    for Nt in [4,8,16,32,64]:
+        delta=T/Nt;big=np.zeros((n*Nt,n*Nt),complex);Xprod=np.eye(n,dtype=complex);chron=np.eye(n,dtype=complex);logA=logD=0.;Xs=[]
+        for t in range(Nt):
