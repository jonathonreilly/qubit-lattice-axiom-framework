+            after=state^(1<<j);s1=(-1)**((state&((1<<j)-1)).bit_count())
+            for i in range(8):
+                if (after>>i)&1:continue
+                final=after|(1<<i);s2=(-1)**((after&((1<<i)-1)).bit_count())
+                H[index[final],col]+=s1*s2*h[i,j]
+    return H
+
+
+def exterior(S,occupied):
