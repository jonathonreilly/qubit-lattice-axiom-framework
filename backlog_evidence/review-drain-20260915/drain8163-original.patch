+        forward.append((a,bb,f));reverse.append((bb,a,r));G[e,idx[y]]=1;G[e,idx[x]]=-1
+    rows=[];types=[]
+    for x in coords:
+        for a,b in itertools.combinations(range(4),2):
+            xa=list(x);xa[a]+=1;xa=tuple(xa);xb=list(x);xb[b]+=1;xb=tuple(xb)
