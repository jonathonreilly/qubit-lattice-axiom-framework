+    assert one.success;S=one.y[:,-1].reshape(n,n);minor_amplitude=math.exp(-mu*r*T)*np.linalg.det(S[r:,r:])
+    assert abs(minor_amplitude-fock_amplitude)<3e-10
+    Pp=np.diag([1]*r+[0]*r);Pm=np.eye(n)-Pp;G=Pp-Pm
+    rows=[];finite_fock=[]
