+        lower=np.min(vertices,axis=0);upper=np.max(vertices,axis=0)
+        for a,b,u in fill:
+            for v in [u,moved(u,a),moved(u,b),moved(moved(u,a),b)]:
+                assert np.all(lower<=v) and np.all(np.array(v)<=upper),(trial,'fill left visited coordinate box')
