+            A=block[:r,:r];B=block[:r,r:];C=block[r:,:r];D=block[r:,r:]
+            assert np.linalg.norm(C+B.conj().T)<1e-13
+            invD=np.linalg.inv(D);X=np.block([[A+B@invD@B.conj().T,B@invD],[invD@B.conj().T,invD]])
