+    for col,s in enumerate(STATES):
+        for j in range(4):
+            if not(s>>j)&1:continue
+            a=s^(1<<j);sgn=(-1)**((s&((1<<j)-1)).bit_count())
+            for i in range(4):
+                if (a>>i)&1:continue
