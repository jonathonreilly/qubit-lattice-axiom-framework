+    for t,theta in enumerate(angles):
+        U=np.array([[0,np.exp(1j*theta)],[0,0]],complex)
+        K=kappa*(np.kron(U,(np.eye(4)+g1)/2)+np.kron(U.conj().T,(np.eye(4)-g1)/2))
