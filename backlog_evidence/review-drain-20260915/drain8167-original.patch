+    for a in range(nplus+1):
+        pa=math.comb(nplus,a)*rho**a*(1-rho)**(nplus-a)
+        for b in range(nminus+1):
+            pb=math.comb(nminus,b)*rho**b*(1-rho)**(nminus-b)
