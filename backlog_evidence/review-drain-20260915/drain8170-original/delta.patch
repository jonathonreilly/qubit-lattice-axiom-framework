+for fn in sorted(glob.glob(S + "sim_b*_L*_T*.txt")) + sorted(glob.glob(S + "ref_sphere_b*_L*.txt")):
+    mm = re.search(r"b(\d+)_L(\d+)", fn); beta, L = int(mm.group(1)), int(mm.group(2))
