+Z = sp.integrate(sp.exp(k*w), (w, -1, 1)); Ew = sp.integrate(w*sp.exp(k*w), (w,-1,1))/Z; Ew2 = sp.integrate(w**2*sp.exp(k*w), (w,-1,1))/Z
