+def conditional(p: Fraction, q: Fraction, r: Fraction, a: int, b: int, c: int):
+    phi = [[r] * 6 for _ in range(6)]
+    for v in range(6):
+        phi[v][v] = p
+        phi[v][v ^ 1] = q
+    w = [phi[v][a] * phi[v][b] * phi[v][c] for v in range(6)]
+    Z = sum(w)
+    return [x / Z for x in w]
