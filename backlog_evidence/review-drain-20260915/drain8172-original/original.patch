+def sensitivity(p: Fraction) -> Fraction:
+    worst = Fraction(0)
+    for a, b, c in product(range(6), repeat=3):
+        k1 = conditional(p, Fraction(1), Fraction(2), a, b, c)
+        for a2 in range(6):
