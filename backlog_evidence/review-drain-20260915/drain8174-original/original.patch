+                    tedges.add(frozenset([a, b]))
+            # prune non-terminal leaves
+            changed = True
+            while changed:
+                changed = False
+                for i in list(tree_nodes):
+                    deg = sum(1 for e in tedges if i in e)
+                    if deg <= 1 and i not in term:
