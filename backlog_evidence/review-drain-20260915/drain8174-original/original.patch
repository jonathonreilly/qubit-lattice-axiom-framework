+            for a, b in combinations(range(len(V_K)), 2):
+                found = None
+                for w in sorted(V_K[a]):
+                    for off in FORK_OFFSETS:
+                        w2 = add(w, off)
+                        if w2 in V_K[b]:
+                            found = frozenset([w, w2])
+                            break
+                    if found:
