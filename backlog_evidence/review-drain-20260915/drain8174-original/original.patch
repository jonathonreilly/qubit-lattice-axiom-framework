+import numpy as np
+def converges(x, y, nit=3000):
+    D = U = Fv = 1.0
+    for i in range(nit):
+        D2 = (1+x*U)**2*(1+3*x*D)*(1+y*Fv)**6; U2 = (1+x*U)**3*(1+y*Fv)**6; F2 = (1+x*U)**3*(1+3*x*D)*(1+y*Fv)**5
