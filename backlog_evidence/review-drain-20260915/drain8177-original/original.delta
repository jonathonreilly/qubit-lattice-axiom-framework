+  level  7: (2, 2, 3)a:-3  (2, 3, 2)p:-2  (3, 2, 2)p:-2  (3, 3, 1)p:-2  (4, 1, 2)p:-3  (4, 2, 1)p:-3
+  level  6: (1, 3, 2)p:-3  (2, 2, 2)p:-2  (2, 3, 1)p:-3  (3, 1, 2)p:-3  (3, 2, 1)p:-3  (4, 0, 2)a:-4  (4, 1, 1)a:-4
+  level  5: (1, 2, 2)p:-3  (1, 3, 1)a:-4  (2, 1, 2)p:-2  (2, 2, 1)p:-3  (3, 0, 2)p:-3  (3, 1, 1)p:-3
+  level  4: (1, 1, 2)p:-3  (1, 2, 1)p:-3  (2, 0, 2)p:-3  (2, 1, 1)p:-3  (2, 2, 0)p:-3  (3, 0, 1)a:-4
+  level  3: (0, 1, 2)a:-4  (1, 0, 2)a:-4  (1, 1, 1)p:-3  (1, 2, 0)a:-4  (2, 0, 1)p:-3  (2, 1, 0)p:-3
