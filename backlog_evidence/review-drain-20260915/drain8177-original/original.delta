+    ('amp', ('amp',)) 13
+    ('amp', ('proc',)) 57
+    ('amp', ('amp', 'amp')) 1
+    ('amp', ('amp', 'proc')) 2
+    ('proc', ()) 63
+    ('proc', ('amp',)) 38
