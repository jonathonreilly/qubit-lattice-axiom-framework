    {
      "id": "8178-1",
      "category": "SEMANTIC_BRIDGE",
      "priority": "P1",
      "location": "note declarations, headline, result, T1 and all historical summaries",
      "finding": "Gain-one recursion is a supplied auxiliary field, not exact nonlinear Cartesian linearization. The corrected current-main sphere level-kernel note derives exact mean gain A(3beta)<1 and explicitly separates the auxiliary field.",
      "repair": "Keep the complete linear theorem under supplied independent additive-noise hypotheses; link corrected current-main context and remove nonlinear exact-linearization identification."
    },
    {
      "id": "8178-2",
      "category": "BUG",
      "priority": "P2",
      "location": "note T1.1, T1.3; headline and RESULTS",
      "finding": "Fourier sign contradicts declared exp(-ikx) convention. Real conjugate modes are not independent. Nonzero modes from zero initial data are not stationary.",
      "repair": "Use negative-exponent multiplier, diagonal Hermitian covariance and temporal independence; state convergence to stationary covariance/law with correct noise assumptions."
    },
    {
      "id": "8178-3",
      "category": "OVERCLAIM",
      "priority": "P2",
      "location": "note T3.1 and plain-language result",
      "finding": "Transient of order V_L is false; slow variance relaxation is O(L\u00b2). tau is real variance-one scale, not exact integer level or one-radian angular hitting time.",
      "repair": "State exact V_L(t) residual bound and asymptotic scalar-proxy rate; define first integer crossing ceil(tau), keep angular/nonlinear interpretation deferred."
    },
    {
      "id": "8178-4",
      "category": "PROOF_OBLIGATION",
      "priority": "P2",
      "location": "note result, prior-art item iii, T3.2, D3 and N5",
      "finding": "Finite sums and four direct summation values do not establish S_L=2pi logL+O(1), sharp V_L=2gamma logL+constant+o(1), or equality with infinite-plane spread at t=L\u00b2. The general finite bracket is valid.",
      "repair": "Preserve complete original sharper arguments and empirical values as deferred; retain exact finite bracket and tested increments. If keeping logarithmic order, give a complete shell/integral comparison proof with the exact stated strength."
    },
    {
      "id": "8178-5",
      "category": "OVERCLAIM",
      "priority": "P1",
      "location": "nonlinear heading/result/table interpretation, N7; controls and logs",
      "finding": "Size-independence is contradicted by reported errors; universal three-percent calibration contradicted by .960 row. Short-lag chordal displacement does not establish memory time |m|\u00b2tau, exact diffusion law, stationarity after burn-in, or direction as whole memory loss.",
