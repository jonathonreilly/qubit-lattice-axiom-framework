    Var_C(rho_minus(f))=|f_a-f_b|^2,
    <rho(f)>=overbar(f_c)-f_a,
    Var_C(rho(f))=overbar(|f_c-overbar(f_c)|^2)+|f_a-f_b|^2.  (6)

