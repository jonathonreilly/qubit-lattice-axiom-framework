diff --git a/scripts/atomic_multibasis_pair_search.py b/scripts/atomic_multibasis_pair_search.py
new file mode 100644
index 00000000..4a981778
--- /dev/null
+++ b/scripts/atomic_multibasis_pair_search.py
@@ -0,0 +1,415 @@
+#!/usr/bin/env python3
+"""Search atomic pair/repulsion controls with basis stability in the objective."""
+
+from __future__ import annotations
+
+import argparse
+from datetime import datetime
+import math
+from pathlib import Path
+import sys
+import time
+from typing import Any
+
+import numpy as np
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+if str(REPO_ROOT) not in sys.path:
+    sys.path.insert(0, str(REPO_ROOT))
+
+from scripts.atomic_correlated_runtime import (  # noqa: E402
+    baseline_metrics_from_readout,
+    build_correlated_base_payload,
+    candidate_and_validation_parameters,
+    correlated_operator_fields,
+    correlated_row_summary,
+    extra_tensor_from_model,
+    solve_correlated_solution,
+)
+from scripts.atomic_lane_runtime import DEFAULT_OUTPUT_ROOT, read_json, write_json  # noqa: E402
+
+
+TARGET_ERROR_KEYS = (
+    "singlet_triplet_gap",
+    "helium_triplet",
+    "helium_ionization",
+)
+
+
+def _basis_sweep_for_total(total_spatial: int) -> tuple[int, ...]:
+    return tuple(
+        size
+        for size in (16, 24, 32, 40, 48, 56, 64, total_spatial)
+        if 0 < size <= int(total_spatial)
+    )
+
+
+def _strength_scale(
+    mode: str,
+    *,
+    reference_virtual: int,
+    max_virtual_orbitals: int,
+) -> float:
+    if mode == "fixed":
+        return 1.0
+    ratio = float(reference_virtual) / float(max_virtual_orbitals)
+    if mode == "inverse_virtual":
+        return ratio
+    if mode == "inverse_sqrt_virtual":
+        return math.sqrt(ratio)
+    raise ValueError(f"unknown strength scaling mode {mode!r}")
+
+
+def _candidate_key(candidate: dict[str, Any]) -> tuple[float, float, float, float]:
+    summary = candidate["multibasis_summary"]
+    accepted_penalty = 0.0 if summary["accepted_on_multibasis_gate"] else 1.0
+    return (
+        accepted_penalty,
+        float(summary["objective_score"]),
+        float(summary["worst_full_rms_relative_error"]),
+        float(summary["worst_max_relative_error"]),
+    )
+
+
+def _row_target_delta(row: dict[str, Any], baseline_metrics: dict[str, Any]) -> float:
+    errors = row["metrics"]["relative_errors"]
+    baseline_errors = baseline_metrics["relative_errors"]
+    deltas = [
+        float(errors[key]) - float(baseline_errors[key])
+        for key in TARGET_ERROR_KEYS
+    ]
+    return min(deltas)
+
+
+def _summarize_candidate(
+    *,
+    rows: list[dict[str, Any]],
+    baseline_metrics: dict[str, Any],
+    stability_weight: float,
+    require_accepted_slices: int,
+    require_large_basis: int,
+) -> dict[str, Any]:
+    full_values = np.asarray(
+        [row["metrics"]["scores"]["full_rms_relative_error"] for row in rows],
+        dtype=float,
+    )
+    max_values = np.asarray(
+        [row["metrics"]["scores"]["max_relative_error"] for row in rows],
+        dtype=float,
+    )
+    one_body_values = np.asarray(
+        [row["metrics"]["scores"]["one_body_rms_relative_error"] for row in rows],
+        dtype=float,
+    )
+    accepted_rows = [row for row in rows if row["acceptance"]["accepted_on_full_lane"]]
+    accepted_large_rows = [
+        row
+        for row in accepted_rows
+        if int(row["max_virtual_orbitals"]) >= int(require_large_basis)
+    ]
+    target_deltas = [
+        _row_target_delta(row, baseline_metrics)
+        for row in rows
+    ]
+    baseline_scores = baseline_metrics["scores"]
+    mean_full = float(np.mean(full_values))
+    std_full = float(np.std(full_values))
+    worst_full = float(np.max(full_values))
+    worst_max = float(np.max(max_values))
+    worst_one_body = float(np.max(one_body_values))
+    full_slope = float(full_values[-1] - full_values[0]) if len(full_values) > 1 else 0.0
+    objective_score = mean_full + float(stability_weight) * std_full
+    accepted_on_multibasis_gate = (
+        len(accepted_rows) >= int(require_accepted_slices)
+        and bool(accepted_large_rows)
+        and mean_full < float(baseline_scores["full_rms_relative_error"])
+        and worst_max <= float(baseline_scores["max_relative_error"])
+        and min(target_deltas) < 0.0
+    )
+    failed_conditions: list[str] = []
+    if len(accepted_rows) < int(require_accepted_slices):
+        failed_conditions.append("accepted_slice_count")
+    if not accepted_large_rows:
+        failed_conditions.append("large_basis_acceptance")
+    if mean_full >= float(baseline_scores["full_rms_relative_error"]):
+        failed_conditions.append("mean_full_rms_relative_error")
+    if worst_max > float(baseline_scores["max_relative_error"]):
+        failed_conditions.append("worst_max_relative_error")
+    if min(target_deltas) >= 0.0:
+        failed_conditions.append("target_residual_improvement")
+    return {
+        "accepted_on_multibasis_gate": accepted_on_multibasis_gate,
+        "failed_conditions": failed_conditions,
+        "accepted_slice_count": len(accepted_rows),
+        "accepted_large_basis_count": len(accepted_large_rows),
+        "mean_full_rms_relative_error": mean_full,
+        "std_full_rms_relative_error": std_full,
+        "worst_full_rms_relative_error": worst_full,
+        "worst_max_relative_error": worst_max,
+        "worst_one_body_rms_relative_error": worst_one_body,
+        "full_rms_slope_last_minus_first": full_slope,
+        "best_target_residual_delta": float(min(target_deltas)),
+        "objective_score": float(objective_score),
+        "stability_weight": float(stability_weight),
+        "require_accepted_slices": int(require_accepted_slices),
+        "require_large_basis": int(require_large_basis),
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--candidate-json",
+        type=Path,
+        default=DEFAULT_OUTPUT_ROOT / "autoresearch_current_candidate.json",
+    )
+    parser.add_argument(
+        "--baseline-readout-json",
+        type=Path,
+        default=DEFAULT_OUTPUT_ROOT / "autoresearch_current_readout.json",
+    )
+    parser.add_argument("--max-virtual-orbital-options", type=int, nargs="*", default=(24, 32, 40, 48))
+    parser.add_argument("--pair-profiles", nargs="*", default=("none", "gaussian", "exponential"))
+    parser.add_argument("--pair-radii", type=float, nargs="*", default=(0.45, 0.6, 0.8))
+    parser.add_argument("--pair-strengths", type=float, nargs="*", default=(0.0, 0.0025, 0.005, 0.01))
+    parser.add_argument("--pair-cutoff-multipliers", type=float, nargs="*", default=(3.0,))
+    parser.add_argument("--strength-scaling-modes", nargs="*", default=("fixed", "inverse_sqrt_virtual"))
+    parser.add_argument("--repulsion-softening-radii", type=float, nargs="*", default=())
+    parser.add_argument("--repulsion-profiles", nargs="*", default=())
+    parser.add_argument("--repulsion-quadrature-orders", type=int, nargs="*", default=())
+    parser.add_argument("--stability-weight", type=float, default=2.0)
+    parser.add_argument("--require-accepted-slices", type=int, default=3)
+    parser.add_argument("--require-large-basis", type=int, default=40)
+    parser.add_argument("--ionization-slack", type=float, default=0.003)
+    parser.add_argument("--gap-slack", type=float, default=0.003)
+    parser.add_argument(
+        "--allow-one-body-plateau",
+        action=argparse.BooleanOptionalAction,
+        default=True,
+    )
+    parser.add_argument("--one-body-tolerance", type=float, default=1.0e-12)
+    parser.add_argument(
+        "--write-json",
+        type=Path,
+        default=DEFAULT_OUTPUT_ROOT / "atomic_multibasis_pair_search.json",
+    )
+    args = parser.parse_args()
+
+    candidate_payload = read_json(args.candidate_json)
+    source_row = candidate_payload.get("accepted_candidate") or candidate_payload["best_by_full_rms"]
+    candidate_parameters, validation_model = candidate_and_validation_parameters(source_row)
+    baseline_metrics = baseline_metrics_from_readout(read_json(args.baseline_readout_json))
+    source_model = dict(source_row["solution"]["model"])
+    base_model_fields = correlated_operator_fields(source_model)
+    reference_virtual = int(validation_model["max_virtual_orbitals"])
+    repulsion_softening_radii = (
+        [float(value) for value in args.repulsion_softening_radii]
+        or [float(validation_model["repulsion_softening_radius"])]
+    )
+    repulsion_profiles = (
+        [str(value) for value in args.repulsion_profiles]
+        or [str(validation_model["repulsion_profile"])]
+    )
+    repulsion_quadrature_orders = (
+        [int(value) for value in args.repulsion_quadrature_orders]
+        or [int(validation_model["repulsion_quadrature_order"])]
+    )
+
+    pair_profiles = [str(value) for value in args.pair_profiles]
+    pair_radii = [float(value) for value in args.pair_radii]
+    pair_strengths = [float(value) for value in args.pair_strengths]
+    cutoff_multipliers = [float(value) for value in args.pair_cutoff_multipliers]
+    strength_scaling_modes = [str(value) for value in args.strength_scaling_modes]
+    basis_options = [int(value) for value in args.max_virtual_orbital_options]
+
+    started_at = datetime.now().isoformat(timespec="seconds")
+    total_started = time.perf_counter()
+    candidates: list[dict[str, Any]] = []
+    total_points = (
+        len(repulsion_softening_radii)
+        * len(repulsion_profiles)
+        * len(repulsion_quadrature_orders)
+        * len(pair_profiles)
+        * len(pair_radii)
+        * len(pair_strengths)
+        * len(cutoff_multipliers)
+        * len(strength_scaling_modes)
+    )
+    current_index = 0
+    for repulsion_radius in repulsion_softening_radii:
+        for repulsion_profile in repulsion_profiles:
+            for repulsion_order in repulsion_quadrature_orders:
+                for pair_profile in pair_profiles:
+                    for pair_radius in pair_radii:
+                        for pair_strength in pair_strengths:
+                            for cutoff_multiplier in cutoff_multipliers:
+                                for scaling_mode in strength_scaling_modes:
+                                    if pair_profile == "none" and pair_strength != 0.0:
+                                        continue
+                                    if pair_profile != "none" and pair_strength == 0.0:
+                                        continue
+                                    current_index += 1
+                                    candidate_started = time.perf_counter()
+                                    basis_rows: list[dict[str, Any]] = []
+                                    representative_row: dict[str, Any] | None = None
+                                    for max_virtual in basis_options:
+                                        validation_model_local = dict(validation_model)
+                                        validation_model_local["max_virtual_orbitals"] = int(max_virtual)
+                                        validation_model_local["basis_sweep"] = list(
+                                            _basis_sweep_for_total(
+                                                int(validation_model_local["max_orbitals"])
+                                                + int(validation_model_local["max_virtual_orbitals"])
+                                            )
+                                        )
+                                        validation_model_local["repulsion_softening_radius"] = float(repulsion_radius)
+                                        validation_model_local["repulsion_profile"] = str(repulsion_profile)
+                                        validation_model_local["repulsion_quadrature_order"] = int(repulsion_order)
+                                        base_payload = build_correlated_base_payload(
+                                            dict(candidate_parameters),
+                                            validation_model_local,
+                                        )
+                                        model_fields = dict(base_model_fields)
+                                        if pair_profile != "none":
+                                            adjusted_strength = float(pair_strength) * _strength_scale(
+                                                scaling_mode,
+                                                reference_virtual=reference_virtual,
+                                                max_virtual_orbitals=int(max_virtual),
+                                            )
+                                            model_fields.update(
+                                                {
+                                                    "pair_correction_profile": str(pair_profile),
+                                                    "pair_correction_radius": float(pair_radius),
+                                                    "pair_correction_strength": float(adjusted_strength),
+                                                    "pair_correction_cutoff_multiplier": float(cutoff_multiplier),
+                                                    "pair_correction_base_strength": float(pair_strength),
+                                                    "pair_correction_strength_scaling": str(scaling_mode),
+                                                }
+                                            )
+                                        extra_tensor = extra_tensor_from_model(base_payload, model_fields)
+                                        solution = solve_correlated_solution(
+                                            base_payload,
+                                            extra_tensor=extra_tensor,
+                                            extra_model_fields=model_fields,
+                                            basis_sweep=tuple(validation_model_local["basis_sweep"]),
+                                        )
+                                        row = correlated_row_summary(
+                                            solution,
+                                            baseline_metrics_payload=baseline_metrics,
+                                            ionization_slack=float(args.ionization_slack),
+                                            gap_slack=float(args.gap_slack),
+                                            allow_one_body_plateau=bool(args.allow_one_body_plateau),
+                                            one_body_tolerance=float(args.one_body_tolerance),
+                                        )
+                                        row["max_virtual_orbitals"] = int(max_virtual)
+                                        row["pair_profile"] = str(pair_profile)
+                                        row["pair_radius"] = None if pair_profile == "none" else float(pair_radius)
+                                        row["pair_base_strength"] = 0.0 if pair_profile == "none" else float(pair_strength)
+                                        row["pair_cutoff_multiplier"] = None if pair_profile == "none" else float(cutoff_multiplier)
+                                        row["pair_strength_scaling"] = str(scaling_mode)
+                                        row["repulsion_softening_radius"] = float(repulsion_radius)
+                                        row["repulsion_profile"] = str(repulsion_profile)
+                                        row["repulsion_quadrature_order"] = int(repulsion_order)
+                                        basis_rows.append(row)
+                                        if int(max_virtual) == reference_virtual:
+                                            representative_row = row
+                                    summary = _summarize_candidate(
+                                        rows=basis_rows,
+                                        baseline_metrics=baseline_metrics,
+                                        stability_weight=float(args.stability_weight),
+                                        require_accepted_slices=int(args.require_accepted_slices),
+                                        require_large_basis=int(args.require_large_basis),
+                                    )
+                                    if representative_row is None:
+                                        representative_row = min(
+                                            basis_rows,
+                                            key=lambda row: abs(int(row["max_virtual_orbitals"]) - reference_virtual),
+                                        )
+                                    candidate = {
+                                        "pair_profile": str(pair_profile),
+                                        "pair_radius": None if pair_profile == "none" else float(pair_radius),
+                                        "pair_base_strength": 0.0 if pair_profile == "none" else float(pair_strength),
+                                        "pair_cutoff_multiplier": None if pair_profile == "none" else float(cutoff_multiplier),
+                                        "pair_strength_scaling": str(scaling_mode),
+                                        "repulsion_softening_radius": float(repulsion_radius),
+                                        "repulsion_profile": str(repulsion_profile),
+                                        "repulsion_quadrature_order": int(repulsion_order),
+                                        "basis_rows": basis_rows,
+                                        "representative_row": representative_row,
+                                        "multibasis_summary": summary,
+                                        "elapsed_seconds": round(time.perf_counter() - candidate_started, 6),
+                                    }
+                                    candidates.append(candidate)
+                                    print(
+                                        f"[{current_index}/{total_points}] "
+                                        f"pair={pair_profile} "
+                                        f"r={candidate['pair_radius']} "
+                                        f"s={candidate['pair_base_strength']:+.5f} "
+                                        f"scale={scaling_mode} "
+                                        f"rep={repulsion_profile}:{repulsion_radius:.3f}/{repulsion_order} "
+                                        f"mean={summary['mean_full_rms_relative_error']:.6f} "
+                                        f"worst={summary['worst_full_rms_relative_error']:.6f} "
+                                        f"accepted={summary['accepted_slice_count']} "
+                                        f"{'ACCEPT' if summary['accepted_on_multibasis_gate'] else 'reject'}",
+                                        flush=True,
+                                    )
+
+    robust_candidates = [
+        candidate
+        for candidate in candidates
+        if candidate["multibasis_summary"]["accepted_on_multibasis_gate"]
+    ]
+    best_candidate = min(candidates, key=_candidate_key)
+    accepted_candidate = min(robust_candidates, key=_candidate_key) if robust_candidates else None
+    output_payload = {
+        "started_at": started_at,
+        "completed_at": datetime.now().isoformat(timespec="seconds"),
+        "source_candidate_json": str(args.candidate_json),
