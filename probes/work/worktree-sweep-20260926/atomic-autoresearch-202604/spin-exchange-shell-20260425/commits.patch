+#!/usr/bin/env python3
+"""Search spin/exchange-resolved shell projectors across CI basis slices."""
+
+from __future__ import annotations
+
+import argparse
+from datetime import datetime
+import time
+from pathlib import Path
+import sys
+from typing import Any
+
+import numpy as np
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+if str(REPO_ROOT) not in sys.path:
+    sys.path.insert(0, str(REPO_ROOT))
+
+from scripts.atomic_correlated_runtime import (  # noqa: E402
+    acceptance_summary,
+    baseline_metrics_from_readout,
+    bound_shell_projector_tensor,
+    build_correlated_base_payload,
+    candidate_and_validation_parameters,
+    correlated_operator_fields,
+    extra_tensor_from_model,
+)
+from scripts.atomic_lane_runtime import DEFAULT_OUTPUT_ROOT, read_json, write_json  # noqa: E402
+from scripts.atomic_observable_metrics import candidate_metrics  # noqa: E402
+from scripts.atomic_two_body_runtime import one_body_summary, solve_sector  # noqa: E402
+
+
+TARGET_ERROR_KEYS = (
+    "singlet_triplet_gap",
+    "helium_triplet",
+    "helium_ionization",
+)
+
+SECTOR_CHANNEL_KEYS = (
+    "ground_ground",
+    "ground_excited",
+    "excited_excited",
+)
+
+
+def _basis_sweep_for_total(total_spatial: int) -> tuple[int, ...]:
+    return tuple(
+        size
+        for size in (16, 24, 32, 40, 48, 56, 64, total_spatial)
+        if 0 < size <= int(total_spatial)
+    )
+
+
+def _sector_field_key(sector: str, channel: str) -> str:
+    if channel not in SECTOR_CHANNEL_KEYS:
+        raise ValueError(f"unsupported projector channel {channel!r}")
+    return f"spin_exchange_{sector}_{channel}_strength"
+
+
+def _sector_projector_tensor(
+    base_payload: dict[str, Any],
+    model_fields: dict[str, Any],
+    *,
+    sector: str,
+) -> np.ndarray:
+    return bound_shell_projector_tensor(
+        base_payload,
+        ground_ground_strength=float(
+            model_fields.get(_sector_field_key(sector, "ground_ground"), 0.0)
+        ),
+        ground_excited_strength=float(
+            model_fields.get(_sector_field_key(sector, "ground_excited"), 0.0)
+        ),
+        excited_excited_strength=float(
+            model_fields.get(_sector_field_key(sector, "excited_excited"), 0.0)
+        ),
+    )
+
+
+def _sector_exchange_fields(model: dict[str, Any]) -> dict[str, float]:
+    fields: dict[str, float] = {}
+    for sector in ("singlet", "triplet"):
+        for channel in SECTOR_CHANNEL_KEYS:
+            key = _sector_field_key(sector, channel)
+            if key in model:
+                fields[key] = float(model[key])
+    return fields
+
+
+def _channel_deltas(mode: str, channel: str, strength: float) -> dict[str, float]:
+    if channel not in SECTOR_CHANNEL_KEYS:
+        raise ValueError(f"unsupported projector channel {channel!r}")
+    if mode == "singlet_only":
+        return {_sector_field_key("singlet", channel): float(strength)}
+    if mode == "triplet_only":
+        return {_sector_field_key("triplet", channel): float(strength)}
+    if mode == "exchange_split":
+        return {
+            _sector_field_key("singlet", channel): float(strength),
+            _sector_field_key("triplet", channel): -float(strength),
+        }
+    raise ValueError(f"unsupported projector mode {mode!r}")
+
+
+def _add_field_deltas(base: dict[str, Any], deltas: dict[str, float]) -> dict[str, Any]:
+    fields = dict(base)
+    for key, delta in deltas.items():
+        fields[key] = float(fields.get(key, 0.0)) + float(delta)
+    return fields
+
+
+def _sweep_two_electron_basis_split(
+    *,
+    orbital_energies: np.ndarray,
+    singlet_interaction_tensor: np.ndarray,
+    triplet_interaction_tensor: np.ndarray,
+    contact_tensor: np.ndarray,
+    basis_sizes: tuple[int, ...],
+) -> list[dict[str, Any]]:
+    rows: list[dict[str, Any]] = []
+    for basis_size in basis_sizes:
+        if basis_size < 1 or basis_size > len(orbital_energies):
+            continue
+        singlet = solve_sector(
+            orbital_energies=orbital_energies[:basis_size],
+            interaction_tensor=singlet_interaction_tensor[
+                :basis_size, :basis_size, :basis_size, :basis_size
+            ],
+            contact_tensor=contact_tensor[:basis_size, :basis_size, :basis_size, :basis_size],
+            sector="singlet",
+        )
+        triplet = solve_sector(
+            orbital_energies=orbital_energies[:basis_size],
+            interaction_tensor=triplet_interaction_tensor[
+                :basis_size, :basis_size, :basis_size, :basis_size
+            ],
+            contact_tensor=contact_tensor[:basis_size, :basis_size, :basis_size, :basis_size],
+            sector="triplet",
+        )
+        ground_energy = singlet["ground_energy"]
+        triplet_energy = triplet["ground_energy"]
+        ion_reference = float(orbital_energies[0])
+        rows.append(
+            {
+                "spatial_orbital_count": int(basis_size),
+                "singlet_ground_energy": ground_energy,
+                "triplet_ground_energy": triplet_energy,
+                "ionization_energy": (
+                    float(ion_reference - ground_energy)
+                    if ground_energy is not None
+                    else None
+                ),
+                "singlet_triplet_gap": (
+                    float(triplet_energy - ground_energy)
+                    if ground_energy is not None and triplet_energy is not None
+                    else None
+                ),
+            }
+        )
+    return rows
+
+
+def _solve_sector_resolved_solution(
+    base_payload: dict[str, Any],
+    *,
+    common_model_fields: dict[str, Any],
+    sector_model_fields: dict[str, Any],
+    basis_sweep: tuple[int, ...],
+) -> dict[str, Any]:
+    common_extra = extra_tensor_from_model(base_payload, common_model_fields)
+    common_tensor = np.asarray(common_extra, dtype=float) if common_extra is not None else 0.0
+    singlet_tensor = (
+        np.array(base_payload["repulsion_tensor"], copy=True)
+        + common_tensor
+        + _sector_projector_tensor(base_payload, sector_model_fields, sector="singlet")
+    )
+    triplet_tensor = (
+        np.array(base_payload["repulsion_tensor"], copy=True)
+        + common_tensor
+        + _sector_projector_tensor(base_payload, sector_model_fields, sector="triplet")
+    )
+    singlet = solve_sector(
+        orbital_energies=base_payload["orbital_energies"],
+        interaction_tensor=singlet_tensor,
+        contact_tensor=base_payload["contact_tensor"],
+        sector="singlet",
+    )
+    triplet = solve_sector(
+        orbital_energies=base_payload["orbital_energies"],
+        interaction_tensor=triplet_tensor,
+        contact_tensor=base_payload["contact_tensor"],
+        sector="triplet",
+    )
+    basis_rows = _sweep_two_electron_basis_split(
+        orbital_energies=base_payload["orbital_energies"],
+        singlet_interaction_tensor=singlet_tensor,
+        triplet_interaction_tensor=triplet_tensor,
+        contact_tensor=base_payload["contact_tensor"],
+        basis_sizes=basis_sweep,
+    )
+    helium_ion_summary = one_body_summary(base_payload["helium_ion_result"])
+    hydrogen_summary = one_body_summary(base_payload["hydrogen_result"])
+    ion_ground_energy = float(helium_ion_summary["ground_energy"])
+    singlet_ground_energy = float(singlet["ground_energy"])
+    triplet_ground_energy = float(triplet["ground_energy"])
+    model = dict(base_payload["model_base"])
+    model["basis_sweep"] = [int(value) for value in basis_sweep]
+    model.update(common_model_fields)
+    model.update(sector_model_fields)
+    model["spin_exchange_projectors_present"] = True
+    return {
+        "model": model,
+        "hydrogen_reference": hydrogen_summary,
+        "helium_ion_reference": helium_ion_summary,
+        "two_electron": {
+            "spatial_orbital_count": int(len(base_payload["orbital_energies"])),
+            "electron_repulsion_present": True,
+            "antisymmetry_present": True,
+            "spin_sectors_present": ["singlet", "triplet"],
+            "spin_exchange_projectors_present": True,
+            "singlet": singlet,
+            "triplet": triplet,
+            "basis_sweep": basis_rows,
+            "noninteracting_double_occupancy_energy": float(2.0 * ion_ground_energy),
+            "interaction_shift_from_double_occupancy": float(
+                singlet_ground_energy - 2.0 * ion_ground_energy
+            ),
+            "ionization_energy": float(ion_ground_energy - singlet_ground_energy),
+            "triplet_ionization_energy": float(ion_ground_energy - triplet_ground_energy),
+            "singlet_triplet_gap": float(triplet_ground_energy - singlet_ground_energy),
+            "helium_like_bound": bool(singlet_ground_energy < ion_ground_energy),
+            "spin_ground_sector": (
+                "singlet" if singlet_ground_energy <= triplet_ground_energy else "triplet"
+            ),
+        },
+    }
+
+
+def _row_summary(
+    solution: dict[str, Any],
+    *,
+    baseline_metrics_payload: dict[str, Any],
+    ionization_slack: float,
+    gap_slack: float,
+    allow_one_body_plateau: bool,
+    one_body_tolerance: float,
+) -> dict[str, Any]:
+    metrics = candidate_metrics(solution)
+    acceptance = acceptance_summary(
+        candidate_metrics_payload=metrics,
+        baseline_metrics_payload=baseline_metrics_payload,
+        ionization_slack=float(ionization_slack),
+        gap_slack=float(gap_slack),
+        helium_like_bound=bool(solution["two_electron"]["helium_like_bound"]),
+        spin_ground_sector=str(solution["two_electron"]["spin_ground_sector"]),
+        allow_one_body_plateau=bool(allow_one_body_plateau),
+        one_body_tolerance=float(one_body_tolerance),
+    )
+    return {
+        "solution": solution,
+        "metrics": metrics,
+        "acceptance": acceptance,
+    }
+
+
+def _row_target_delta(row: dict[str, Any], baseline_metrics: dict[str, Any]) -> float:
+    errors = row["metrics"]["relative_errors"]
+    baseline_errors = baseline_metrics["relative_errors"]
+    return min(
+        float(errors[key]) - float(baseline_errors[key])
+        for key in TARGET_ERROR_KEYS
+    )
+
+
+def _summarize_candidate(
+    *,
+    rows: list[dict[str, Any]],
+    baseline_metrics: dict[str, Any],
+    stability_weight: float,
+    require_accepted_slices: int,
+    require_large_basis: int,
+) -> dict[str, Any]:
+    full_values = np.asarray(
+        [row["metrics"]["scores"]["full_rms_relative_error"] for row in rows],
+        dtype=float,
+    )
+    max_values = np.asarray(
+        [row["metrics"]["scores"]["max_relative_error"] for row in rows],
+        dtype=float,
+    )
+    one_body_values = np.asarray(
+        [row["metrics"]["scores"]["one_body_rms_relative_error"] for row in rows],
+        dtype=float,
+    )
+    accepted_rows = [row for row in rows if row["acceptance"]["accepted_on_full_lane"]]
+    accepted_large_rows = [
+        row
+        for row in accepted_rows
+        if int(row["max_virtual_orbitals"]) >= int(require_large_basis)
+    ]
+    target_deltas = [_row_target_delta(row, baseline_metrics) for row in rows]
+    baseline_scores = baseline_metrics["scores"]
+    mean_full = float(np.mean(full_values))
+    std_full = float(np.std(full_values))
+    worst_full = float(np.max(full_values))
+    worst_max = float(np.max(max_values))
+    worst_one_body = float(np.max(one_body_values))
+    objective_score = mean_full + float(stability_weight) * std_full
+    accepted_on_multibasis_gate = (
+        len(accepted_rows) >= int(require_accepted_slices)
+        and bool(accepted_large_rows)
+        and mean_full < float(baseline_scores["full_rms_relative_error"])
+        and worst_max <= float(baseline_scores["max_relative_error"])
+        and min(target_deltas) < 0.0
+    )
+    failed_conditions: list[str] = []
+    if len(accepted_rows) < int(require_accepted_slices):
+        failed_conditions.append("accepted_slice_count")
+    if not accepted_large_rows:
+        failed_conditions.append("large_basis_acceptance")
+    if mean_full >= float(baseline_scores["full_rms_relative_error"]):
+        failed_conditions.append("mean_full_rms_relative_error")
+    if worst_max > float(baseline_scores["max_relative_error"]):
+        failed_conditions.append("worst_max_relative_error")
+    if min(target_deltas) >= 0.0:
+        failed_conditions.append("target_residual_improvement")
+    return {
+        "accepted_on_multibasis_gate": accepted_on_multibasis_gate,
+        "failed_conditions": failed_conditions,
+        "accepted_slice_count": len(accepted_rows),
+        "accepted_large_basis_count": len(accepted_large_rows),
+        "mean_full_rms_relative_error": mean_full,
+        "std_full_rms_relative_error": std_full,
+        "worst_full_rms_relative_error": worst_full,
+        "worst_max_relative_error": worst_max,
+        "worst_one_body_rms_relative_error": worst_one_body,
+        "best_target_residual_delta": float(min(target_deltas)),
+        "objective_score": float(objective_score),
+        "stability_weight": float(stability_weight),
+        "require_accepted_slices": int(require_accepted_slices),
+        "require_large_basis": int(require_large_basis),
+    }
+
+
+def _candidate_key(candidate: dict[str, Any]) -> tuple[float, float, float, float]:
+    summary = candidate["multibasis_summary"]
+    accepted_penalty = 0.0 if summary["accepted_on_multibasis_gate"] else 1.0
+    return (
+        accepted_penalty,
+        float(summary["objective_score"]),
+        float(summary["worst_full_rms_relative_error"]),
+        float(summary["worst_max_relative_error"]),
+    )
+
+
+def _search_payload(
+    *,
+    status: str,
+    started_at: str,
+    total_started: float,
+    args: argparse.Namespace,
+    candidates: list[dict[str, Any]],
+    total_valid_points: int,
+) -> dict[str, Any]:
+    robust_candidates = [
+        candidate
+        for candidate in candidates
+        if candidate["multibasis_summary"]["accepted_on_multibasis_gate"]
+    ]
+    best_candidate = min(candidates, key=_candidate_key) if candidates else None
+    accepted_candidate = (
+        min(robust_candidates, key=_candidate_key) if robust_candidates else None
+    )
+    return {
+        "status": status,
+        "started_at": started_at,
+        "completed_at": datetime.now().isoformat(timespec="seconds"),
+        "source_candidate_json": str(args.candidate_json),
