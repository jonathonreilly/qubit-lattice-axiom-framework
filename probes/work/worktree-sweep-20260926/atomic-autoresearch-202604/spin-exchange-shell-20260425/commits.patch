+def _primitive_spec(mode: str, channel: str, strength: float) -> dict[str, Any]:
+    return {
+        "mode": str(mode),
+        "channel": str(channel),
+        "strength": float(strength),
+        "deltas": _channel_deltas(str(mode), str(channel), float(strength)),
+    }
+
+
+def _combined_deltas(components: list[dict[str, Any]]) -> dict[str, float]:
+    combined: dict[str, float] = {}
+    for component in components:
+        for key, value in component["deltas"].items():
+            combined[key] = float(combined.get(key, 0.0)) + float(value)
+    return {key: value for key, value in combined.items() if value != 0.0}
+
+
+def _candidate_specs(
+    *,
+    projector_modes: list[str],
+    projector_channels: list[str],
+    projector_strengths: list[float],
+    composite_sizes: list[int],
+) -> list[dict[str, Any]]:
+    primitives = [
+        _primitive_spec(mode, channel, strength)
+        for mode in projector_modes
+        for channel in projector_channels
+        for strength in projector_strengths
+        if float(strength) != 0.0
+    ]
+    specs: list[dict[str, Any]] = []
+    for size in sorted(set(int(value) for value in composite_sizes)):
+        if size < 1:
+            raise ValueError(f"composite size must be >= 1, got {size!r}")
+        if size == 1:
+            for primitive in primitives:
+                specs.append(
+                    {
+                        "candidate_kind": "single",
+                        "components": [primitive],
+                        "deltas": dict(primitive["deltas"]),
+                    }
+                )
+            continue
+        if size > 2:
+            raise ValueError(
+                "only composite sizes 1 and 2 are supported in this bounded runner"
+            )
+        for left, right in combinations(primitives, 2):
+            # Same mode/channel pairs collapse to a single stronger primitive, so skip
+            # them to keep the deterministic map non-redundant.
+            if left["mode"] == right["mode"] and left["channel"] == right["channel"]:
+                continue
+            deltas = _combined_deltas([left, right])
+            if not deltas:
+                continue
+            specs.append(
+                {
+                    "candidate_kind": "composite_2",
+                    "components": [left, right],
+                    "deltas": deltas,
+                }
+            )
+    return specs
+
+
+def _candidate_descriptor(spec: dict[str, Any]) -> dict[str, Any]:
+    components = [
+        {
+            "mode": str(component["mode"]),
+            "channel": str(component["channel"]),
+            "strength": float(component["strength"]),
+        }
+        for component in spec["components"]
+    ]
+    if len(components) == 1:
+        component = components[0]
+        return {
+            "projector_kind": "single",
+            "projector_mode": component["mode"],
+            "projector_channel": component["channel"],
+            "projector_strength": component["strength"],
+            "projector_components": components,
+        }
+    return {
+        "projector_kind": str(spec["candidate_kind"]),
+        "projector_mode": str(spec["candidate_kind"]),
+        "projector_channel": "+".join(component["channel"] for component in components),
+        "projector_strength": float(sum(component["strength"] for component in components)),
+        "projector_components": components,
+    }
+
+
+def _candidate_offset(args: argparse.Namespace) -> int:
+    if args.candidate_offset is not None:
+        return max(0, int(args.candidate_offset))
+    if not args.auto_loop_offset:
+        return 0
